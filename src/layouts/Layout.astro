---
import "../styles/global.css";
import Navbar from "../components/commons/navbar/navbar.astro";
import Footer from "../components/commons/footer/footer.astro";
import Breadcrumb from "../components/commons/breadcrumb/Breadcrumb.astro";
import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"

interface Props {
  title?: string;
  description?: string;
}

const { title = "工具人-ToolKitRen - 免费在线工具箱", description = "提供丰富的在线开发者工具，包括文本处理、图像处理、代码生成等功能。" } = Astro.props;
---

<!doctype html>
<html lang="en" class="theme-light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Theme initialization script -->
    <script>
      // 初始化主题
      (function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.classList.add(`theme-${savedTheme}`);
        // 添加或移除 dark 类以支持 Tailwind 的深色模式
        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2594166946464616" 
      crossorigin="anonymous"></script>
  </head>
  <body class="text-theme-primary transition-colors duration-300">
    <!-- Animated background -->
    <div class="fixed inset-0 z-[-1] overflow-hidden">
      <div
        class="absolute top-1/3 left-1/3 w-1/3 h-1/3 animate-gradientMove bg-gradient-to-br from-[#982cf0]/20 to-[#581f86]/20 blur-[100px]"
        style="transform-origin: center; will-change: transform;"
      >
      </div>
      <div
        class="absolute top-1/3 left-1/3 w-1/3 h-1/3 animate-gradientMove2 bg-gradient-to-br from-[#277752]/20 to-[#02ffee]/20 blur-[100px]"
        style="transform-origin: center; will-change: transform;"
      >
      </div>
    </div>

    <Navbar />
    <!-- Breadcrumb Navigation -->
    <Breadcrumb />
    <!-- Main content area -->
    <div class="pb-12">
      <slot />
    </div>
    <Footer />
    <Analytics/>
    <SpeedInsights/>
  </body>
</html>