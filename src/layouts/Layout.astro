---
import "../styles/global.css";
import Navbar from "../components/commons/navbar/navbar.astro";
import Footer from "../components/commons/footer/footer.astro";
import Breadcrumb from "../components/commons/breadcrumb/Breadcrumb.astro";
import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"
---

<!doctype html>
<html lang="en" class="theme-light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Lautaro Rodriguez Collins</title>
    
    <!-- Theme initialization script -->
    <script>
      // 初始化主题
      (function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.classList.add(`theme-${savedTheme}`);
      })();
    </script>
  </head>
  <body class="text-theme-primary transition-colors duration-300">
    <!-- Animated background -->
    <div class="fixed inset-0 z-[-1] overflow-hidden">
      <div
        class="absolute top-1/3 left-1/3 w-1/3 h-1/3 animate-gradientMove bg-gradient-to-br from-[#982cf0]/20 to-[#581f86]/20 blur-[100px]"
        style="transform-origin: center; will-change: transform;"
      >
      </div>
      <div
        class="absolute top-1/3 left-1/3 w-1/3 h-1/3 animate-gradientMove2 bg-gradient-to-br from-[#277752]/20 to-[#02ffee]/20 blur-[100px]"
        style="transform-origin: center; will-change: transform;"
      >
      </div>
    </div>

    <Navbar />
    <!-- Breadcrumb Navigation -->
    <Breadcrumb />
    <!-- Main content area -->
    <div class="pb-12">
      <slot />
    </div>
    <Footer />
    <Analytics/>
    <SpeedInsights/>
  </body>
</html>