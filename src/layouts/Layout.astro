---
import "../styles/global.css";
import Navbar from "../components/commons/navbar/navbar.astro";
import Footer from "../components/commons/footer/footer.astro";
import Breadcrumb from "../components/commons/breadcrumb/Breadcrumb.astro";
import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { themeBootstrapScript } from "../scripts/theme-runtime";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const { 
  title = "工具人-ToolKitRen - 免费在线工具箱", 
  description = "提供丰富的在线开发者工具，包括文本处理、图像处理、代码生成等功能。",
  image = "/favicon.svg",
  type = "website"
} = Astro.props;

// 优先使用 www 域名作为规范链接
const site = import.meta.env.SITE || "https://www.toolkit.ren";
const canonicalURL = new URL(Astro.url.pathname, site);
const socialImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    
    <script is:inline set:html={themeBootstrapScript}></script>
    {import.meta.env.PROD && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2594166946464616"
        crossorigin="anonymous"
      />
    )}
  </head>
  <body class="text-theme-primary">
    <!-- Animated background -->
    <div class="fixed inset-0 z-[-1] overflow-hidden">
      <div
        class="absolute top-1/3 left-1/3 w-1/3 h-1/3 animate-gradientMove bg-gradient-to-br from-[#982cf0]/20 to-[#581f86]/20 blur-[100px]"
        style="transform-origin: center; will-change: transform;"
      >
      </div>
      <div
        class="absolute top-1/3 left-1/3 w-1/3 h-1/3 animate-gradientMove2 bg-gradient-to-br from-[#277752]/20 to-[#02ffee]/20 blur-[100px]"
        style="transform-origin: center; will-change: transform;"
      >
      </div>
    </div>

    <Navbar />
    <!-- Breadcrumb Navigation -->
    <Breadcrumb />
    <!-- Main content area -->
    <div class="pb-12">
      <slot />
    </div>
    <Footer />
    <Analytics/>
    <SpeedInsights/>
  </body>
</html>
