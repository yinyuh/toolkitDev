---
interface Props {
  slotId?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal' | 'vertical';
  style?: string;
  responsive?: boolean;
}

const { 
  slotId, 
  format = 'auto', 
  style = 'display:block',
  responsive = true
} = Astro.props;
---

<div class="adsense-container my-6 text-center overflow-hidden hidden">
  <!-- AdSense Unit -->
  <ins class="adsbygoogle"
     style={style}
     data-ad-client="ca-pub-2594166946464616"
     data-ad-slot={slotId}
     data-ad-format={format}
     data-full-width-responsive={responsive ? "true" : "false"}></ins>
  <script is:inline>
    (() => {
      const scriptElement = document.currentScript;
      const wrapper = scriptElement?.closest('.adsense-container');
      const adElement = wrapper?.querySelector('.adsbygoogle');
      if (!wrapper || !adElement) return;

      const showAd = () => wrapper.classList.remove('hidden');
      const hideAd = () => wrapper.classList.add('hidden');

      hideAd();

      let finalized = false;
      const finalizeByStatus = () => {
        if (finalized) return;
        const status = adElement.getAttribute('data-ad-status');
        if (status === 'filled') {
          showAd();
          finalized = true;
        } else if (status === 'unfilled') {
          hideAd();
          finalized = true;
        }
      };

      const observer = new MutationObserver(() => finalizeByStatus());
      observer.observe(adElement, { attributes: true, attributeFilter: ['data-ad-status'] });

      try {
        (adsbygoogle = window.adsbygoogle || []).push({});
      } catch (_error) {
        hideAd();
        observer.disconnect();
        return;
      }

      setTimeout(() => {
        finalizeByStatus();
        if (!finalized) hideAd();
      }, 4000);

      setTimeout(() => observer.disconnect(), 10000);
    })();
  </script>
</div>
