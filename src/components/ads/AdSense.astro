---
interface Props {
  slotId: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal' | 'vertical';
  style?: string;
  responsive?: boolean;
}

const { 
  slotId, 
  format = 'auto', 
  style = 'display:block',
  responsive = true
} = Astro.props;
---

<div class="adsense-container my-6 text-center overflow-hidden">
  <!-- AdSense Unit -->
  <ins class="adsbygoogle"
     style={style}
     data-ad-client="ca-pub-2594166946464616"
     data-ad-slot={slotId}
     data-ad-format={format}
     data-full-width-responsive={responsive ? "true" : "false"}></ins>
  <script is:inline>
     (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>