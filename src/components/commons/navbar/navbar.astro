---
import { FiMenu, FiX } from "react-icons/fi";
import { FaLinkedinIn, FaGithub } from "react-icons/fa6";
import { BiGlobe } from "react-icons/bi"; // 添加地球图标用于语言选择
import ThemeSwitcher from "../theme-switcher/ThemeSwitcher.jsx";
import { proyectos } from "../../../data/projectData.js";

// 导入Node.js的文件系统模块
import fs from 'fs';
import path from 'path';

const links = [
  { name: "首页", href: "/" },
  { name: "资源", href: "/proyectos" },
  { name: "文章", href: "/articles" },
];

// 添加语言选项
const languages = [
  { code: "en", name: "EN" },
  { code: "zh", name: "中文" },
  { code: "fr", name: "FR" },
  { code: "es", name: "ES" },
  { code: "pt", name: "PT" },
];

// 自动扫描tools目录下的页面文件
const toolsDirectory = path.join(process.cwd(), 'src', 'pages', 'tools');
let toolPages = [];

if (fs.existsSync(toolsDirectory)) {
  const files = fs.readdirSync(toolsDirectory);
  
  // 读取每个页面文件的元数据
  toolPages = files
    .filter(file => file.endsWith('.astro') || file.endsWith('.md'))
    .map(file => {
      const filePath = path.join(toolsDirectory, file);
      const fileContent = fs.readFileSync(filePath, 'utf8');
      
      // 从文件内容中提取frontmatter元数据
      const frontmatterMatch = fileContent.match(/^---[\s\S]*?---/);
      let metadata = {};
      
      if (frontmatterMatch) {
        const frontmatter = frontmatterMatch[0];
        // 简单解析frontmatter（实际项目中可以使用专门的解析库）
        const lines = frontmatter.split('\n').slice(1, -1);
        
        lines.forEach(line => {
          const [key, ...valueParts] = line.split(':');
          if (key && valueParts.length > 0) {
            const value = valueParts.join(':').trim().replace(/^["']|["']$/g, '');
            metadata[key.trim()] = value;
          }
        });
      }
      
      // 生成页面URL
      const fileNameWithoutExt = file.replace(/\.astro$|\.md$/, '');
      const url = `/tools/${fileNameWithoutExt}`;
      
      // 如果有title字段，才将页面添加到列表中
      if (metadata.title) {
        return {
          title: metadata.title,
          description: metadata.description || `这是${metadata.title}的详细页面`,
          url: url,
          type: '工具',
          technologies: metadata.technologies ? metadata.technologies.split(',').map(tech => tech.trim()) : [],
          category: metadata.category || 'tool'
        };
      }
      
      return null;
    })
    .filter(Boolean);
}

// 从proyectos数据中提取文章
const articles = proyectos.map(project => ({
  title: project.titulo,
  description: project.descripcion,
  url: project.demo || '/',
  type: '文章',
  technologies: project.tecnologias || [],
  category: project.categoria || 'article'
}));

// 合并工具和文章数据
const searchableItems = [...toolPages, ...articles];
---

<nav class="relative">
  <!-- Input control (peer) -->
  <input id="menu-toggle" type="checkbox" class="peer hidden md:hidden" />

  <!-- Navbar -->
  <nav
    class="fixed top-0 left-0 w-full z-50 bg-theme-primary/90 backdrop-blur-md"
  >
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <img
          src="/icons/Earth.svg"
          alt="Earth"
          class="h-10 w-10 text-[#69c7c7] drop-shadow-[1.5px_1.5px_0_#7836cf]"
        />
        <span class="text-xl font-bold text-theme-primary hidden md:inline">工具集成与优质博客导航平台</span>
      </a>

      <!-- Desktop Links -->
      <div class="hidden md:flex items-center space-x-8">
        <ul id="navbar-links" class="flex items-center space-x-8">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="nav-link font-bold transition-colors duration-300 text-theme-primary hover:text-accent"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Search Box -->
        <div class="relative">
          <input
            type="text"
            placeholder="搜索工具或文章..."
            class="pl-10 pr-4 py-2 rounded-full bg-theme-secondary text-theme-primary focus:outline-none focus:ring-2 focus:ring-accent w-64 transition-all duration-300"
            id="search-input"
          />
          <svg
            class="absolute left-3 top-1/2 transform -translate-y-1/2 text-theme-primary"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            ></path>
          </svg>
          <!-- Search Results -->
          <div id="search-results" class="absolute right-0 mt-2 w-80 bg-div-theme border border-theme-border rounded-md shadow-lg opacity-0 invisible transition-all duration-200 z-50 max-h-96 overflow-y-auto">
            <!-- Results will be populated by JavaScript -->
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- 主题切换器 -->
          <ThemeSwitcher client:load />

          <!-- 语言选择下拉菜单 -->
          <div class="relative group">
            <button id="lang-toggle" class="p-2 rounded-full hover:bg-theme-secondary transition-colors flex items-center">
              <BiGlobe className="h-5 w-5 text-theme-primary" />
            </button>
            <div id="lang-dropdown" class="absolute right-0 mt-2 w-32 bg-div-theme border border-theme-border rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <ul>
                {
                  languages.map((lang) => (
                    <li>
                      <a 
                        href="#" 
                        class="block px-4 py-2 text-sm text-div-theme hover:bg-theme-secondary lang-option"
                        data-lang={lang.code}
                      >
                        {lang.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile right-side icons -->
      <div class="flex md:hidden items-center gap-4 z-50">
        <!-- Mobile theme switcher -->
        <div class="md:hidden">
          <ThemeSwitcher client:load />
        </div>
        
        <!-- Mobile language selector -->
        <div class="relative group">
          <button id="lang-toggle-mobile" class="p-2 rounded-full hover:bg-theme-secondary transition-colors">
            <BiGlobe className="h-5 w-5 text-theme-primary" />
          </button>
          <div id="lang-dropdown-mobile" class="absolute right-0 mt-2 w-32 bg-div-theme border border-theme-border rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <ul>
              {
                languages.map((lang) => (
                  <li>
                    <a 
                      href="#" 
                      class="block px-4 py-2 text-sm text-div-theme hover:bg-theme-secondary lang-option"
                      data-lang={lang.code}
                    >
                      {lang.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        
        <!-- NotificationBell已移除 -->
        <label for="menu-toggle" class="cursor-pointer">
          <FiMenu className="h-7 w-7 text-theme-primary peer-checked:hidden" />
          <FiX className="h-7 w-7 text-theme-primary hidden peer-checked:block" />
        </label>
      </div>
    </div>
  </nav>

  <!-- Overlay (mobile only) -->
  <label
    for="menu-toggle"
    class="fixed inset-0 bg-black/60 hidden peer-checked:block cursor-pointer z-40 md:hidden"
  ></label>

  <!-- Sidebar móvil -->
  <div
    class="fixed top-0 right-0 h-full w-64 bg-theme-primary shadow-lg transform translate-x-full transition-transform duration-300 peer-checked:translate-x-0 z-50 md:translate-x-full md:hidden"
  >
    <div class="flex justify-end p-4">
      <label for="menu-toggle" class="cursor-pointer">
        <FiX className="h-7 w-7 text-theme-primary" />
      </label>
    </div>

    <ul id="navbar-links-mobile" class="flex flex-col space-y-6 mt-6 ml-6">
      {
        links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link-mobile text-lg font-bold text-theme-primary hover:text-accent transition-colors duration-300"
          >
            {link.name}
          </a>
        </li>
      ))
      }
      
      <!-- Mobile menu language and theme controls -->
      <li class="flex flex-col gap-2 pt-4 border-t border-gray-200 dark:border-gray-700">
        <div class="flex justify-between items-center">
          <span class="text-theme-primary">主题:</span>
          <div class="md:hidden">
            <ThemeSwitcher client:load />
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-theme-primary pb-2">语言:</span>
          <div class="flex flex-wrap gap-2">
            {
              languages.map((lang) => (
                <a 
                  href="#" 
                  class="px-3 py-1 bg-theme-secondary text-theme-primary rounded text-sm hover:bg-theme-primary lang-option"
                  data-lang={lang.code}
                >
                  {lang.name}
                </a>
              ))
            }
          </div>
        </div>
      </li>
    </ul>
  </div>
</nav>

<!-- 搜索数据 -->
<div id="search-data" style="display: none;" data-searchable-items={JSON.stringify(searchableItems)}></div>

<script>
  (function () {
    function markActiveLinks() {
      const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
      const desktopLinks = Array.from(
        document.querySelectorAll("#navbar-links .nav-link")
      );
      const mobileLinks = Array.from(
        document.querySelectorAll("#navbar-links-mobile .nav-link-mobile")
      );

      const allLinks = [...desktopLinks, ...mobileLinks];

      allLinks.forEach((link) => {
        const hrefAttr = link.getAttribute("href");
        const href = hrefAttr?.replace(/\/$/, "") || "" || "/";

        if (href === currentPath) {
          link.classList.add("text-accent", "font-extrabold");
          link.classList.remove("text-theme-primary");
        } else {
          link.classList.remove("text-accent", "font-extrabold");
          link.classList.add("text-theme-primary");
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", markActiveLinks);
    } else {
      markActiveLinks();
    }

    window.addEventListener("popstate", markActiveLinks);
    document.addEventListener("astro:page-load", markActiveLinks);
    document.addEventListener("astro:after-swap", markActiveLinks);
    window.addEventListener("load", () => setTimeout(markActiveLinks, 50));
  })();

  // 语言选择功能
  function initLanguageSelector() {
    const langOptions = document.querySelectorAll('.lang-option');
    
    langOptions.forEach(option => {
      option.addEventListener('click', function(e) {
        e.preventDefault();
        const selectedLang = (e.currentTarget).getAttribute('data-lang');
        
        // 这里可以添加实际的语言切换逻辑
      });
    });
  }

  // 搜索功能
  function initSearchFunctionality() {
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    
    if (!searchInput || !searchResults) return;

    // 从隐藏元素中获取搜索数据
    const searchDataElement = document.getElementById('search-data');
    const searchableItems = JSON.parse(searchDataElement.dataset.searchableItems);

    // 搜索函数
    function performSearch() {
      const query = searchInput.value.toLowerCase().trim();
      
      if (query.length === 0) {
        hideSearchResults();
        return;
      }

      // 过滤搜索结果
      const filteredItems = searchableItems.filter(item => 
        item.title.toLowerCase().includes(query) ||
        item.description.toLowerCase().includes(query) ||
        item.type.toLowerCase().includes(query)
      );

      displaySearchResults(filteredItems);
    }

    // 监听搜索输入
    searchInput.addEventListener('input', performSearch);

    // 监听搜索框获得焦点
    searchInput.addEventListener('focus', performSearch);

    // 监听回车键
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        performSearch();
      }
    });

    // 点击外部关闭搜索结果
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
        hideSearchResults();
      }
    });

    // 显示搜索结果
    function displaySearchResults(items) {
      if (items.length === 0) {
        searchResults.innerHTML = `
          <div class="p-4 text-center text-theme-secondary">
            没有找到匹配的结果
          </div>
        `;
      } else {
        searchResults.innerHTML = items.map(item => `
          <a href="${item.url}" class="block p-3 hover:bg-theme-secondary/50 transition-colors">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-2 h-2 rounded-full mt-2 ${item.type === '工具' ? 'bg-blue-500' : 'bg-green-500'}"></div>
              <div>
                <h4 class="font-medium text-theme-primary">${item.title}</h4>
                <p class="text-sm text-theme-secondary mt-1">${item.description}</p>
                <span class="inline-block px-2 py-0.5 mt-2 text-xs rounded-full ${item.type === '工具' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}">${item.type}</span>
              </div>
            </div>
          </a>
        `).join('');
      }

      searchResults.classList.remove('opacity-0', 'invisible');
      searchResults.classList.add('opacity-100', 'visible');
    }

    // 隐藏搜索结果
    function hideSearchResults() {
      searchResults.classList.remove('opacity-100', 'visible');
      searchResults.classList.add('opacity-0', 'invisible');
    }
  }

  // DOM准备就绪后初始化功能
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLanguageSelector();
      initSearchFunctionality();
    });
  } else {
    initLanguageSelector();
    initSearchFunctionality();
  }
</script>
