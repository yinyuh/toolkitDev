---
import ServiceCard from "./ServiceCard.astro";
import { FaLaptopCode, FaBolt, FaRocket } from "react-icons/fa"; 
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
	<h2
		class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-theme-primary md:flex-row md:items-center md:text-end"
	>
		<span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"></span>
		<span class="drop-shadow-[2px_2px_0_#7836cf]">服务</span>
	</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		<ServiceCard
			icon={FaLaptopCode}
			title="响应式Web开发"
			description="构建现代化网站，适配移动设备，优化并采用当前技术。"
		/>
		<ServiceCard
			icon={FaBolt}
			title="前端开发"
			description="开发现代化、快速且可访问的界面，提供直观且吸引人的用户体验。"
		/>

		<ServiceCard
			icon={FaRocket}
			title="后端开发"
			description="快速性能、最佳可访问性实践和服务器流程优化。"
		/>
	</div>
</section>