---
const githubUrl = "https://github.com/Lautaro-R-collins";
const imageUrl = "/github.png";
---

<section class="mt-16 flex justify-center px-4">
	<div
		class="mx-auto max-h-80 w-full max-w-[1120px] overflow-hidden rounded-2xl bg-linear-to-r from-theme-gradient-start to-theme-gradient-end text-theme-primary shadow-lg drop-shadow-[4px_4px_0_#7836cf]"
	>
		<div class="flex h-full flex-col items-center md:flex-row-reverse md:items-start">
			<!-- Logo GitHub -->
			<div class="flex h-full w-full shrink-0 items-center justify-center md:w-auto md:justify-end">
				<a href={githubUrl} target="_blank" rel="noopener noreferrer">
					<img
						src={imageUrl}
						alt="GitHub Logo"
						class="h-auto w-72 cursor-pointer object-contain transition hover:scale-105 md:w-[470px]"
					/>
				</a>
			</div>

			<!-- Texto y botón -->
			<div class="flex-1 p-4 text-center md:p-8 md:text-left">
				<h3 class="text-5xl font-bold md:text-4xl">访问我的GitHub！</h3>
				<p class="mt-2 text-sm md:text-xl">
						你好！我邀请你访问我的GitHub个人资料，探索我的最新项目和贡献。
					</p>
				<a
					href={githubUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-4 inline-block rounded-full bg-theme-button px-6 py-3 font-semibold text-theme-button-text transition hover:bg-theme-button-hover"
				>
					前往GitHub
				</a>
			</div>
		</div>
	</div>
</section>