---
const { project } = Astro.props;

// 分类标签中英文映射
const categoryMap = {
  fullstack: "全栈",
  frontend: "前端",
  backend: "后端",
  tool: "工具"
};

// 获取中文分类标签
const getChineseCategory = (category: string) => {
  return categoryMap[category as keyof typeof categoryMap] || category;
};

// 生成随机颜色
const getRandomColor = () => {
  const colors = ['#4CAF50', '#2196F3', '#FF9800', '#9C27B0', '#F44336', '#00BCD4', '#8BC34A', '#FFC107'];
  return colors[Math.floor(Math.random() * colors.length)];
};

// 生成随机图标
const getRandomIcon = (projectName: string) => {
  const icons = [
    'https://api.dicebear.com/7.x/shapes/svg?seed={seed}&backgroundColor=transparent&color={color}',
    'https://api.dicebear.com/7.x/bottts/svg?seed={seed}&backgroundColor=transparent&color={color}',
    'https://api.dicebear.com/7.x/avataaars/svg?seed={seed}&backgroundColor=transparent&color={color}',
    'https://api.dicebear.com/7.x/personas/svg?seed={seed}&backgroundColor=transparent&color={color}'
  ];
  const icon = icons[Math.floor(Math.random() * icons.length)];
  const color = getRandomColor();
  return icon.replace('{seed}', projectName).replace('{color}', color.replace('#', ''));
};
---

{/* 工具卡片组件 */}
<div class="bg-div-theme rounded-xl p-4 shadow-lg border border-div-theme hover:border-blue-500 transition-all duration-300 flex flex-col min-h-[200px] group relative">
  <div class="flex-grow">
    <div class="flex items-center gap-3 mb-3">
      {/* 工具图标 */}
      <div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center bg-theme-secondary">
        <img src={getRandomIcon(project.titulo)} alt={project.titulo} class="w-6 h-6" />
      </div>
      <h3 class="text-lg font-bold text-theme-primary group-hover:text-blue-400 transition-colors">{project.titulo}</h3>
    </div>
    <p class="text-theme-secondary mb-4 text-sm flex-grow">{project.descripcion}</p>
    <div class="flex flex-wrap gap-2 mb-4 justify-center">
      {project.tecnologias.slice(0, 3).map((tech: string) => (
        <span class="bg-gray-50 text-gray-700 text-xs px-2 py-0.5 rounded border border-gray-200">
          {tech}
        </span>
      ))}
      {project.tecnologias.length > 3 && (
        <span class="bg-gray-50 text-gray-700 text-xs px-2 py-0.5 rounded border border-gray-200">
          +{project.tecnologias.length - 3}
        </span>
      )}
    </div>
  </div>
  
  <div class="pt-3 mt-auto">
    <div class="flex justify-center border border-gray-200 rounded-lg overflow-hidden max-w-xs mx-auto">
      {/* 拷贝链接按钮 */}
      <button class="flex-1 text-center px-3 py-2 bg-gray-100 text-gray-700 text-xs transition-colors duration-200 flex items-center justify-center hover:bg-gray-200 border-r border-gray-200">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        拷贝链接
      </button>
      <!-- 开始使用按钮 -->
      <a href={project.isToolPage || project.titulo === "React 电商" ? (project.url || "/tools/react-ecommerce") : (project.demo || project.codigo || "#")} class="flex-1 text-center px-3 py-2 btn-theme text-xs transition-colors duration-200 flex items-center justify-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
        开始使用
      </a>
    </div>
  </div>
  
  {/* Category badge */}
  <div class="absolute top-3 right-3">
    <span class="bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded-full">
      {getChineseCategory(project.categoria)}
    </span>
  </div>
</div>

<script>
  // 拷贝链接功能
  document.addEventListener('DOMContentLoaded', function() {
    const copyButtons = document.querySelectorAll('button');
    
    copyButtons.forEach(button => {
      if (button.textContent.includes('拷贝链接')) {
        button.addEventListener('click', function() {
          // 获取当前卡片的链接
          const card = this.closest('div');
          if (!card) return;
          
          const startButton = card.querySelector('a[href]') as HTMLAnchorElement | null;
          let url = startButton ? startButton.href : window.location.href;
          
          // 复制到剪贴板
          navigator.clipboard.writeText(url).then(() => {
            // 显示复制成功提示
            const originalText = button.textContent.trim();
            button.textContent = ' 已拷贝';
            setTimeout(() => {
              button.textContent = originalText;
            }, 2000);
          }).catch(err => {
            console.error('复制失败:', err);
          });
        });
      }
    });
  });
</script>