---
const { project } = Astro.props;
const displayTitle = project.shortTitle || project.titulo;
const displayIcon = project.icon || "🧰";
---

{/* 工具卡片组件 */}
<div class="bg-div-theme rounded-xl shadow-lg border border-div-theme hover:border-blue-500 transition-all duration-300 flex flex-col min-h-[200px] group relative">
  <div class="p-4 flex-grow">
    <div class="flex items-center gap-3 mb-3">
      {/* 工具图标 */}
      <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center bg-theme-secondary text-theme-primary border border-div-theme shadow-sm text-lg font-bold">
        <span aria-hidden="true">{displayIcon}</span>
      </div>
      <h3 class="text-lg font-bold text-theme-primary group-hover:text-blue-400 transition-colors leading-snug">{displayTitle}</h3>
    </div>
    <p class="text-theme-secondary mb-4 text-sm flex-grow">{project.descripcion}</p>
    <div class="flex flex-wrap gap-2 mb-4 justify-center">
      {project.tecnologias.slice(0, 3).map((tech: string) => (
        <span class="bg-gray-50 text-gray-700 text-xs px-2 py-0.5 rounded border border-gray-200">
          {tech}
        </span>
      ))}
      {project.tecnologias.length > 3 && (
        <span class="bg-gray-50 text-gray-700 text-xs px-2 py-0.5 rounded border border-gray-200">
          +{project.tecnologias.length - 3}
        </span>
      )}
    </div>
  </div>
  
  <div class="mt-auto">
    <div class="flex border-t border-div-theme rounded-b-xl overflow-hidden">
      {/* 拷贝链接按钮 */}
      <button class="flex-1 text-center py-4 btn-theme text-xs transition-colors duration-200 flex items-center justify-center hover:bg-theme-secondary border-r border-div-theme cursor-pointer">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        拷贝链接
      </button>
      <!-- 开始使用按钮 -->
      <a href={project.isToolPage || project.titulo === "React 电商" ? (project.url || "/tools/react-ecommerce") : (project.demo || project.codigo || "#")} class="flex-1 text-center py-4 bg-theme-secondary text-theme-primary text-xs transition-colors duration-200 flex items-center justify-center hover:bg-theme-primary hover:text-white">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
        开始使用
      </a>
    </div>
  </div>
</div>

<script>
  // 拷贝链接功能
  document.addEventListener('DOMContentLoaded', function() {
    const copyButtons = document.querySelectorAll('button');
    
    copyButtons.forEach(button => {
      if (button.textContent.includes('拷贝链接')) {
        button.addEventListener('click', function() {
          // 获取当前卡片的链接
          const card = this.closest('div');
          if (!card) return;
          
          const startButton = card.querySelector('a[href]') as HTMLAnchorElement | null;
          let url = startButton ? startButton.href : window.location.href;
          
          // 保存按钮的原始HTML结构
          const originalHTML = this.innerHTML;
          
          // 复制到剪贴板
          navigator.clipboard.writeText(url).then(() => {
            // 显示复制成功提示
            this.innerHTML = '<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> 已拷贝';
            setTimeout(() => {
              // 恢复原始HTML结构，包括图标
              this.innerHTML = originalHTML;
            }, 2000);
          }).catch(err => {
            console.error('复制失败:', err);
          });
        });
      }
    });
  });
</script>
