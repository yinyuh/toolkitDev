---
import Layout from "../layouts/Layout.astro";
import Header from "../components/home/header/header.astro";
import Slider from "../components/home/header/slider.astro";
import ToolCard from "../components/ToolCard.astro";
import FAQS from "../components/home/faqs/faqs.jsx";
import Banner from "../components/commons/banners/banner.astro";
import { proyectos } from "../data/projectData.js";

// 导入Node.js的文件系统模块
import fs from 'fs';
import path from 'path';

// 自动扫描tools目录下的页面文件
const toolsDirectory = path.join(process.cwd(), 'src', 'pages', 'tools');
let toolPages = [];

if (fs.existsSync(toolsDirectory)) {
  const files = fs.readdirSync(toolsDirectory);
  
  // 读取每个页面文件的元数据
  toolPages = files
    .filter(file => file.endsWith('.astro') || file.endsWith('.md'))
    .map(file => {
      const filePath = path.join(toolsDirectory, file);
      const fileContent = fs.readFileSync(filePath, 'utf8');
      
      // 从文件内容中提取frontmatter元数据
      const frontmatterMatch = fileContent.match(/^---[\s\S]*?---/);
      let metadata = {};
      
      if (frontmatterMatch) {
        const frontmatter = frontmatterMatch[0];
        // 简单解析frontmatter（实际项目中可以使用专门的解析库）
        const lines = frontmatter.split('\n').slice(1, -1);
        
        lines.forEach(line => {
          const [key, ...valueParts] = line.split(':');
          if (key && valueParts.length > 0) {
            const value = valueParts.join(':').trim().replace(/^["']|['"]$/g, '');
            metadata[key.trim()] = value;
          }
        });
      }
      
      // 生成页面URL
      const fileNameWithoutExt = file.replace(/\.astro$|\.md$/, '');
      const url = `/tools/${fileNameWithoutExt}`;
      
      // 如果有title字段，才将页面添加到列表中
      if (metadata.title) {
        return {
          titulo: metadata.title,
          descripcion: metadata.description || `这是${metadata.title}的详细页面`,
          url: url,
          tecnologias: metadata.technologies ? metadata.technologies.split(',').map(tech => tech.trim()) : [],
          categoria: metadata.category || 'tool',
          isToolPage: true
        };
      }
      
      return null;
    })
    .filter(Boolean);
}

// 合并传统项目数据和自动生成的工具页面数据
const allProjects = [...proyectos, ...toolPages];

// Filter projects to show only featured ones (you can customize this)
const featuredProjects = allProjects.filter(project => 
  project.categoria === 'fullstack' || project.categoria === 'frontend' || project.categoria === 'tool'
);

// Get unique categories for filtering
const categories = [...new Set(allProjects.map(project => project.categoria))];
---

<Layout>
  <!-- Tools Grid Section with Category Filter -->
  <section class="py-10 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Add margin-top to compensate for fixed navbar -->
      <div class="mt-8 mb-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-theme-primary">高效工具集成与优质博客导航平台</h1>
            <p class="text-theme-secondary mt-1">轻量检索，一站直达 —— 帮你快速找到开发、设计、办公所需工具，聚合全网精选博客资源，让信息获取更高效。</p>
          </div>
          <div class="mt-4 md:mt-0 text-sm text-theme-secondary">
            共 {featuredProjects.length} 个项目
          </div>
        </div>

        <!-- Category Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        <button 
          class="filter-btn active px-5 py-2 rounded-full text-sm font-medium btn-theme border border-theme transition-colors"
          data-filter="all"
          aria-label="显示所有项目"
        >
          全部
        </button>
        {categories.map(category => (
          <button 
            class="filter-btn px-5 py-2 rounded-full text-sm font-medium bg-theme-secondary text-theme-secondary border border-theme-border hover:bg-theme-primary transition-colors"
            data-filter={category}
            aria-label={`显示${category}项目`}
          >
            {category === 'fullstack' ? '全栈' : category === 'frontend' ? '前端' : category === 'backend' ? '后端' : category.charAt(0).toUpperCase() + category.slice(1)}
          </button>
        ))}
      </div>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-5" id="tools-grid">
        {featuredProjects.map((project) => (
          <div class="tool-card" data-categoria={project.categoria}>
            <ToolCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Filter functionality
    // 使用DOMContentLoaded事件代替astro:page-load，确保DOM完全加载
    document.addEventListener('DOMContentLoaded', function() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.tool-card');
      const HIDDEN_CLASS = 'hidden';
      
      // 确保元素都存在
      if (!buttons.length || !cards.length) {
        console.error('Filter buttons or cards not found');
        return;
      }
      
      
      // 简化的显示/隐藏函数
      function showCard(card) {
        card.classList.remove(HIDDEN_CLASS);
        card.style.display = 'block';
        card.classList.add('opacity-100', 'scale-100');
        card.classList.remove('opacity-0', 'scale-95');
      }

      function hideCard(card) {
        card.classList.add('opacity-0', 'scale-95');
        card.classList.remove('opacity-100', 'scale-100');
        setTimeout(() => {
          card.classList.add(HIDDEN_CLASS);
          card.style.display = 'none';
        }, 300);
      }

      function applyFilter(filter) {
        const normalized = filter.toLowerCase();
        
        let visibleCount = 0;
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const categoria = card.getAttribute("data-categoria") || "";
          const cardCategory = categoria.toLowerCase();
          
          
          const match = normalized === "all" || cardCategory === normalized;
          
          if (match) {
            showCard(card);
            visibleCount++;
          } else {
            hideCard(card);
          }
        }
        
      }

      function setActive(btn) {
        // 移除所有按钮的激活状态
        buttons.forEach(b => {
          b.classList.remove("active", "btn-theme");
          b.classList.add("bg-theme-secondary", "text-theme-secondary");
        });
        
        // 添加当前按钮的激活状态
        btn.classList.add("active", "btn-theme");
        btn.classList.remove("bg-theme-secondary", "text-theme-secondary");
        
      }

      // 为每个按钮添加单独的事件监听器
      buttons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          const filter = this.dataset.filter || "all";
          setActive(this);
          applyFilter(filter);
        });
      });

      // 初始化默认显示所有项目
      const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
      if (allBtn) {
        setActive(allBtn);
        applyFilter("all");
      }
    });
  </script>

  <style>
    .tool-card {
      transition: all 0.3s ease;
      opacity: 1;
      transform: scale(1);
    }
    
    .tool-card.hidden {
      display: none;
    }
    
    .tool-card.opacity-0 {
      opacity: 0;
    }
    
    .tool-card.scale-95 {
      transform: scale(0.95);
    }
    
    .tool-card.scale-100 {
      transform: scale(1);
    }
  </style>
</Layout>