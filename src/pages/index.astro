---
import Layout from "../layouts/Layout.astro";
import Header from "../components/home/header/header.astro";
import Slider from "../components/home/header/slider.astro";
import ToolCard from "../components/ToolCard.astro";
import FAQS from "../components/home/faqs/faqs.jsx";
import Banner from "../components/commons/banners/banner.astro";
import { proyectos } from "../data/projectData.js";

// 导入Node.js的文件系统模块
import fs from 'fs';
import path from 'path';

// 分类标签中英文映射
const categoryNameMap = {
  fullstack: "全栈",
  frontend: "前端",
  backend: "后端",
  tool: "工具",
  image: "图片工具",
  text: "文本工具",
  video: "视频工具",
  audio: "音频工具",
  encoding: "编码转换",
  generator: "生成器",
  calculator: "计算器",
  developer: "开发工具",
  other: "其他"
};

const toolCardMetaMap = {
  "audio-converter": { shortTitle: "音频转换工具", icon: "🎵" },
  "bar-chart-generator": { shortTitle: "柱状图生成器", icon: "📊" },
  "base-converter": { shortTitle: "进制转换器", icon: "🔢" },
  "base64-encoder-decoder": { shortTitle: "Base64 编解码", icon: "🧾" },
  "binary-code-calculator": { shortTitle: "原反补码计算", icon: "0/1" },
  "bullshit-generator": { shortTitle: "文章生成器", icon: "📝" },
  "countdown-timer": { shortTitle: "倒计时器", icon: "⏳" },
  "cron-generator": { shortTitle: "Cron 生成器", icon: "🗓️" },
  "favicon-generator": { shortTitle: "Favicon 生成器", icon: "🌐" },
  "glitch-text-generator": { shortTitle: "故障文字生成", icon: "⚡" },
  "handwriting-generator": { shortTitle: "手写文本生成", icon: "✍️" },
  "html-to-markdown": { shortTitle: "HTML 转 Markdown", icon: "🔁" },
  "image-background-remover": { shortTitle: "图片去背景", icon: "🪄" },
  "image-compressor": { shortTitle: "图片压缩", icon: "🗜️" },
  "image-cropper": { shortTitle: "图片裁剪", icon: "✂️" },
  "image-stitcher": { shortTitle: "拼接长图", icon: "🧩" },
  "image-watermark": { shortTitle: "图片水印", icon: "©" },
  "ocr": { shortTitle: "文字识别 OCR", icon: "🔎" },
  "password-generator": { shortTitle: "密码生成器", icon: "🔐" },
  "pdf-to-image": { shortTitle: "PDF 转图片", icon: "📄" },
  "periodic-table": { shortTitle: "元素周期表", icon: "⚗️" },
  "pixel-art-converter": { shortTitle: "像素画转换", icon: "🟪" },
  "qrcode-generator": { shortTitle: "二维码生成器", icon: "▦" },
  "rainbow-text-generator": { shortTitle: "彩虹文字生成", icon: "🌈" },
  "scrambled-text-generator": { shortTitle: "乱序文字生成", icon: "🔀" },
  "svg-optimizer": { shortTitle: "SVG 优化工具", icon: "📐" },
  "text-counter": { shortTitle: "文本计数器", icon: "🔤" },
  "text-diff": { shortTitle: "文本对比工具", icon: "🆚" },
  "text-formatter": { shortTitle: "文本格式化工具", icon: "🧹" },
  "timestamp-converter": { shortTitle: "时间戳转换", icon: "🕒" },
  "unit-converter": { shortTitle: "单位换算器", icon: "📏" },
  "video-compressor": { shortTitle: "视频压缩工具", icon: "📦" },
  "video-converter": { shortTitle: "视频格式转换", icon: "🎞️" },
  "video-to-gif": { shortTitle: "视频转 GIF 工具", icon: "🎬" },
  "volume-calculator": { shortTitle: "体积计算器", icon: "🧊" },
  "wing-nickname-generator": { shortTitle: "翅膀昵称生成", icon: "🪽" }
};

const categoryIconMap = {
  fullstack: "🛠️",
  frontend: "🖥️",
  backend: "🗄️",
  tool: "🧰",
  image: "🖼️",
  text: "🔤",
  video: "🎬",
  audio: "🎵",
  encoding: "🔁",
  generator: "✨",
  calculator: "🧮",
  developer: "💻",
  other: "🧩"
};

// 自动扫描tools目录下的页面文件
const toolsDirectory = path.join(process.cwd(), 'src', 'pages', 'tools');
let toolPages = [];

if (fs.existsSync(toolsDirectory)) {
  const files = fs.readdirSync(toolsDirectory);
  
  // 读取每个页面文件的元数据
  toolPages = files
    .filter(file => file.endsWith('.astro') || file.endsWith('.md'))
    .map(file => {
      const filePath = path.join(toolsDirectory, file);
      const fileContent = fs.readFileSync(filePath, 'utf8');
      
      // 从文件内容中提取frontmatter元数据
      const frontmatterMatch = fileContent.match(/^---[\s\S]*?---/);
      let metadata = {};
      
      if (frontmatterMatch) {
        const frontmatter = frontmatterMatch[0];
        // 简单解析frontmatter（实际项目中可以使用专门的解析库）
        const lines = frontmatter.split('\n').slice(1, -1);
        
        lines.forEach(line => {
          // 跳过import语句
          if (line.trim().startsWith('import ')) {
            return;
          }
          
          const [key, ...valueParts] = line.split(':');
          if (key && valueParts.length > 0) {
            const value = valueParts.join(':').trim().replace(/^["']|["']$/g, '');
            metadata[key.trim()] = value;
          }
        });
      }
      
      // 生成页面URL
      const fileNameWithoutExt = file.replace(/\.astro$|\.md$/, '');
      const url = `/tools/${fileNameWithoutExt}`;
      const toolCardMeta = toolCardMetaMap[fileNameWithoutExt] || {};
      
      // 如果有title字段，才将页面添加到列表中
      if (metadata.title) {
        return {
          titulo: metadata.title,
          shortTitle: toolCardMeta.shortTitle || metadata.title,
          descripcion: metadata.description || `这是${metadata.title}的详细页面`,
          url: url,
          tecnologias: metadata.technologies ? metadata.technologies.split(',').map(tech => tech.trim()) : [],
          categoria: metadata.category || 'tool',
          icon: toolCardMeta.icon || categoryIconMap[metadata.category] || categoryIconMap.tool,
          isToolPage: true,
          order: metadata.order ? parseInt(metadata.order) : undefined
        };
      }
      
      return null;
    })
    .filter(Boolean);
}

// 合并传统项目数据和自动生成的工具页面数据
const allProjects = [...proyectos, ...toolPages];

// 为没有order字段的项目设置默认值
const projectsWithOrder = allProjects.map((project, index) => ({
  ...project,
  shortTitle: project.shortTitle || project.titulo,
  icon: project.icon || categoryIconMap[project.categoria] || categoryIconMap.other,
  order: project.order || index + 1
}));

// Filter projects to show only featured ones (you can customize this)
const featuredProjects = projectsWithOrder.filter(project => 
  project.categoria === 'fullstack' || project.categoria === 'frontend' || project.categoria === 'backend' || 
  ['image', 'text', 'video', 'audio', 'encoding', 'generator', 'calculator', 'developer', 'other', 'tool'].includes(project.categoria)
).sort((a, b) => a.order - b.order);

// Get unique categories for filtering
const categories = [...new Set(allProjects.map(project => project.categoria))];
---

<Layout>


  <!-- Tools Grid Section with Category Filter -->
  <section class="py-4 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap justify-start gap-2 mb-8" id="filter-container">
        <button 
          class="filter-btn active px-4 py-1.5 rounded-full text-xs font-medium btn-theme border border-theme transition-colors"
          data-filter="all"
          aria-label="显示所有项目"
        >
          全部
        </button>
        {categories.map(category => (
          <button 
            class="filter-btn px-4 py-1.5 rounded-full text-xs font-medium bg-theme-secondary text-theme-secondary border border-theme-border hover:bg-theme-primary transition-colors"
            data-filter={category}
            aria-label={`显示${categoryNameMap[category] || category}项目`}
          >
            {categoryNameMap[category] || category.charAt(0).toUpperCase() + category.slice(1)}
          </button>
        ))}
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-5" id="tools-grid">
        {featuredProjects.map((project) => (
          <div class={`tool-card ${project.categoria}`} data-categoria={project.categoria}>
            <ToolCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.tool-card');
      
      if (!buttons.length || !cards.length) return;

      function filterProjects(category) {
        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-categoria');
          if (category === 'all' || cardCategory === category) {
            card.classList.remove('hidden');
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'scale(1)';
            }, 10);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => {
              card.classList.add('hidden');
            }, 300);
          }
        });
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active class from all buttons
          buttons.forEach(b => {
            b.classList.remove('active', 'btn-theme');
            b.classList.add('bg-theme-secondary', 'text-theme-secondary');
          });
          
          // Add active class to clicked button
          btn.classList.add('active', 'btn-theme');
          btn.classList.remove('bg-theme-secondary', 'text-theme-secondary');
          
          const filter = btn.getAttribute('data-filter');
          filterProjects(filter);
        });
      });
    });
  </script>

  <style>
    .tool-card {
      transition: all 0.3s ease;
      opacity: 1;
      transform: scale(1);
    }
    
    .tool-card.hidden {
      display: none;
    }
    
    .tool-card.opacity-0 {
      opacity: 0;
    }
    
    .tool-card.scale-95 {
      transform: scale(0.95);
    }
    
    .tool-card.scale-100 {
      transform: scale(1);
    }
  </style>
</Layout>
