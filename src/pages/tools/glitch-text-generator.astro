---
import Layout from "../../layouts/Layout.astro";
import GlitchTextGenerator from '../../components/tools/GlitchTextGenerator';

title: "在线故障文字生成器 (Glitch Text)"
description: "免费在线故障文字生成器，一键生成带有故障效果的 Zalgo 文本，支持自定义混乱度和方向，适用于社交媒体和个性化设计。"
technologies: "React, TailwindCSS"
category: "text"
order: 100
---

<Layout title="在线故障文字生成器 (Glitch Text)" description="免费在线故障文字生成器，一键生成带有故障效果的 Zalgo 文本，支持自定义混乱度和方向，适用于社交媒体和个性化设计。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">
        故障文字生成器
      </h1>
      <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
        将普通文本转换为具有"故障"或"诅咒"效果的 Zalgo 文本。通过添加 Unicode 组合字符，让文字看起来混乱、破碎。
      </p>
    </div>
    
    <div class="bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
      <GlitchTextGenerator client:only="react" />
    </div>
  </div>
</Layout>