---
import Layout from "../../layouts/Layout.astro";
import PasswordGenerator from '../../components/tools/PasswordGenerator';
import AdSense from "../../components/ads/AdSense.astro";

title: "随机密码生成器"
description: "高强度随机密码生成器，支持自定义长度、字符类型，本地生成，安全无忧。"
technologies: "Crypto API, React, TailwindCSS"
category: "generator"
order: 100

const pageTitle = "随机密码生成器";
const pageDescription = "高强度随机密码生成器，支持自定义长度、字符类型，本地生成，安全无忧。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "随机密码生成器",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/password-generator",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "自定义密码长度与字符集",
        "支持大小写字母、数字和符号组合",
        "一键生成高强度随机密码",
        "可批量快速刷新候选密码",
        "浏览器本地生成，隐私安全"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "密码长度设置多少更安全？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "常见建议是至少 12 位。若用于高价值账户，可提升到 16 位以上，并开启符号和大小写混合。"
          }
        },
        {
          "@type": "Question",
          "name": "生成的密码会上传保存吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。密码在浏览器端本地生成，不会主动上传到服务器。"
          }
        },
        {
          "@type": "Question",
          "name": "是否可以用于批量账号初始化？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "可以。你可以多次快速生成并复制不同密码，适合测试账号或企业初始口令分发。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何生成高强度随机密码",
      "step": [
        {
          "@type": "HowToStep",
          "name": "设置规则",
          "text": "选择密码长度，并启用大小写字母、数字和特殊符号。"
        },
        {
          "@type": "HowToStep",
          "name": "生成密码",
          "text": "点击生成按钮，获取符合规则的随机密码。"
        },
        {
          "@type": "HowToStep",
          "name": "保存使用",
          "text": "复制结果后建议保存到密码管理器并启用双重验证。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">随机密码生成器</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          生成更安全的登录口令。<span class="text-accent font-semibold">长度与字符类型可控，随机性更强</span>，适用于个人与团队账号安全管理。
        </p>
      </div>
      
      <div class="max-w-6xl mx-auto bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
        <PasswordGenerator client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么强密码对账号安全很重要？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              弱密码和重复密码是账号被撞库与暴力破解的高风险来源。通过提高长度、混合字符类型和随机性，可以显著降低被猜中概率。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 随机密码生成器</strong> 帮助你快速创建高强度口令，适用于邮箱、社交平台、云服务、后台系统和开发测试环境。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔐</div>
                <h3 class="text-xl font-semibold mb-2">高强度随机生成</h3>
                <p class="text-theme-secondary">通过浏览器随机能力生成不可预测密码，降低撞库与枚举风险。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">⚙️</div>
                <h3 class="text-xl font-semibold mb-2">规则灵活配置</h3>
                <p class="text-theme-secondary">可自定义长度、字符类型和复杂度，满足不同平台安全策略。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📋</div>
                <h3 class="text-xl font-semibold mb-2">一键复制使用</h3>
                <p class="text-theme-secondary">快速复制到注册或修改密码流程，减少人工输入错误。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🛡️</div>
                <h3 class="text-xl font-semibold mb-2">本地处理更安心</h3>
                <p class="text-theme-secondary">生成过程在本地浏览器完成，避免明文口令上传带来的额外风险。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步生成安全密码</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">设置长度与字符集</h3>
                  <p class="text-theme-secondary">根据目标平台规则选择密码长度和字符类型组合。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">生成并筛选</h3>
                  <p class="text-theme-secondary">一键生成随机密码，可多次刷新选择更容易记忆的组合。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">保存到密码管理器</h3>
                  <p class="text-theme-secondary">复制后建议保存到可靠管理器，并为关键账号启用双重验证。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>每个平台都要用不同密码吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  建议每个站点使用独立密码，避免单个平台泄露后影响其他账号。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>符号太多会导致兼容问题吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  部分系统会限制可用符号，遇到注册失败时可调整字符集后重新生成。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>密码多久需要更换一次？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  关键账号建议定期轮换，或在疑似泄露后立即修改并启用二次验证。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关工具推荐</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/text-formatter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">多格式文本格式化工具</div>
                  <div class="text-xs text-theme-secondary">整理配置文本与密钥片段更清晰</div>
                </a>
              </li>
              <li>
                <a href="/tools/base64-encoder-decoder" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">Base64 编码解码工具</div>
                  <div class="text-xs text-theme-secondary">快速处理凭据相关的编码内容</div>
                </a>
              </li>
              <li>
                <a href="/tools/timestamp-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">时间戳转换工具</div>
                  <div class="text-xs text-theme-secondary">记录口令更新时间与运维审计时间</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
