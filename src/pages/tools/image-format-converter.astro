---
import Layout from "../../layouts/Layout.astro";
import ImageFormatConverter from '../../components/tools/ImageFormatConverter';
import AdSense from "../../components/ads/AdSense.astro";

title: "在线图片格式转换工具 - 免费 JPG/PNG/WebP/BMP/SVG 互转"
description: "免费在线图片格式转换工具，支持 JPG、PNG、WebP、BMP、GIF、SVG、HEIC 等主流格式互转。浏览器本地处理，无需上传服务器，批量转换一键打包下载。"
technologies: "Canvas API, React, TailwindCSS, JSZip"
category: "image"
order: 15

const pageTitle = "在线图片格式转换工具 - 免费 JPG/PNG/WebP/BMP/SVG 互转";
const pageDescription = "免费在线图片格式转换工具，支持 JPG、PNG、WebP、BMP、GIF、SVG、HEIC 等主流格式互转。浏览器本地处理，无需上传服务器，批量转换一键打包下载。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线图片格式转换工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/image-format-converter",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "支持 JPG、PNG、WebP、BMP、GIF、SVG、HEIC 批量互转",
        "预设模式一键智能转换，高级模式自定义参数",
        "浏览器本地处理，图片不离开设备",
        "支持拖拽上传与批量打包下载",
        "转换前后画质对比预览",
        "免费使用，无需注册"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "转换图片时需要上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不需要。所有格式转换在浏览器内通过 Canvas API 本地完成，图片数据不会离开您的设备，隐私安全有保障。"
          }
        },
        {
          "@type": "Question",
          "name": "JPG、PNG、WebP 应该如何选择？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "JPG 兼容性最广，适合照片和通用场景；PNG 支持透明背景，适合图标和设计素材；WebP 兼顾高画质与小体积，适合网页展示。可根据具体用途灵活选择。"
          }
        },
        {
          "@type": "Question",
          "name": "支持 HEIC 格式吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "支持 HEIC 格式的导入（需浏览器原生支持，如 Safari）。导入后可将 HEIC 转换为 JPG、PNG、WebP 等通用格式，方便跨平台使用。"
          }
        },
        {
          "@type": "Question",
          "name": "转换后图片画质会下降吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "转为 PNG/BMP 等无损格式时画质不变；转为 JPG/WebP 等有损格式时可通过画质参数在体积和清晰度之间取得平衡。建议使用预览对比功能确认效果。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何在线转换图片格式",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传图片文件",
          "text": "选择一张或多张图片文件，支持拖拽或点击上传，兼容 JPG、PNG、WebP、GIF、BMP、SVG、HEIC 等格式。"
        },
        {
          "@type": "HowToStep",
          "name": "选择目标格式",
          "text": "在预设模式中选择一键场景方案，或在高级模式中自定义目标格式、画质与尺寸参数。"
        },
        {
          "@type": "HowToStep",
          "name": "转换并下载",
          "text": "点击转换按钮开始处理，完成后可预览对比效果，选择单张下载或批量打包下载。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">在线图片格式转换工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          一键转换 JPG、PNG、WebP、BMP、SVG 等主流图片格式，<span class="text-accent font-semibold">浏览器本地处理更安全</span>，批量转换高效便捷。
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <ImageFormatConverter client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么需要在线图片格式转换工具？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              不同平台和应用对图片格式的要求千差万别：网站需要 WebP 以加速加载，社交媒体偏好 JPG，设计工具要求 PNG 保留透明背景，打印输出可能需要 BMP 或 TIFF。频繁在不同格式间手动切换不仅耗时，还容易丢失画质。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 在线图片格式转换工具</strong> 让你在浏览器内一次完成多张图片的格式批量转换。无需安装专业软件，也不必将文件上传到第三方服务器——所有处理流程均在本地设备上完成，兼顾效率、隐私与便捷性。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔄</div>
                <h3 class="text-xl font-semibold mb-2">全格式互转覆盖广</h3>
                <p class="text-theme-secondary">支持 JPG ↔ PNG ↔ WebP ↔ BMP ↔ SVG 双向互转，兼容 GIF 与 HEIC 导入，覆盖常见使用场景。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">⚡</div>
                <h3 class="text-xl font-semibold mb-2">预设 + 高级双模式</h3>
                <p class="text-theme-secondary">普通用户选择预设场景一键转换，专业用户可在高级模式中自定义格式、画质与输出分辨率。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">本地处理更隐私</h3>
                <p class="text-theme-secondary">全部转换流程在浏览器端完成，图片数据不会离开你的设备，敏感素材也能放心使用。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📦</div>
                <h3 class="text-xl font-semibold mb-2">批量打包高效便捷</h3>
                <p class="text-theme-secondary">支持多文件同时上传与统一格式转换，转换完成后一键打包下载全部结果文件。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">👁️</div>
                <h3 class="text-xl font-semibold mb-2">转换前后对比预览</h3>
                <p class="text-theme-secondary">提供原图与转换结果并排预览，直观对比画质差异与文件大小变化，确认效果后再下载。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🖱️</div>
                <h3 class="text-xl font-semibold mb-2">拖拽上传操作友好</h3>
                <p class="text-theme-secondary">支持拖拽文件和点击选择两种上传方式，大尺寸图片自动缩放适配，智能引导操作流程。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步完成图片格式转换</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">上传一张或多张图片</h3>
                  <p class="text-theme-secondary">拖拽文件到上传区或点击选择，支持 JPG、PNG、WebP、GIF、BMP、SVG、HEIC 等格式。工具会自动校验文件有效性并显示缩略图预览。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">选择目标格式与参数</h3>
                  <p class="text-theme-secondary">在「预设模式」中选择网页优化、社交媒体、高清存档等场景方案，或在「高级模式」中自定义输出格式、画质与最大尺寸。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">预览结果并下载</h3>
                  <p class="text-theme-secondary">转换完成后可点击缩略图对比原图与转换结果，确认效果后单张下载或一键打包下载全部文件。</p>
                </div>
              </li>
            </ol>
          </section>

          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">常见图片格式使用场景指南</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left border-collapse">
                <thead class="bg-theme-surface">
                  <tr>
                    <th class="px-4 py-3 border border-theme-border font-bold">格式</th>
                    <th class="px-4 py-3 border border-theme-border font-bold">特性</th>
                    <th class="px-4 py-3 border border-theme-border font-bold">推荐场景</th>
                    <th class="px-4 py-3 border border-theme-border font-bold">导出建议</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="px-4 py-3 border border-theme-border font-bold">JPG</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">有损压缩、不支持透明</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">照片、社交媒体、网页内容</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">画质 75-90%</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 border border-theme-border font-bold">PNG</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">无损压缩、支持透明通道</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">图标、Logo、UI 素材、截图</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">原始尺寸</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 border border-theme-border font-bold">WebP</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">有损/无损、支持透明、体积小</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">网站配图、移动端、电商详情</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">画质 70-85%</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 border border-theme-border font-bold">BMP</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">无压缩位图、体积大</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">特定系统需求、打印输出</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">注意文件体积</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 border border-theme-border font-bold">SVG</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">矢量封装（栅格嵌入）</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">跨工具交换、矢量容器需求</td>
                    <td class="px-4 py-3 border border-theme-border text-theme-secondary">注意非原生矢量</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="text-sm text-theme-secondary mt-3">
              * SVG 输出模式将栅格图片以 Base64 嵌入为 SVG 容器，非原生矢量转换。如需纯矢量转换请使用专业矢量图形软件。
            </p>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>转换后图片会失真吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  转为 PNG/BMP 等无损格式时画质不变。转为 JPG/WebP 时可通过画质滑块在体积和清晰度之间取得平衡。建议使用预览对比功能确认效果。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>支持批量转换不同格式吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  当前版本批量转换统一输出为同一种目标格式。如需将不同图片转为不同格式，建议分批处理，每次选择对应的目标格式。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>超大尺寸图片能处理吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  支持 50MB 以内的单张图片。超过长边限制的图片会自动等比缩放，可在高级设置中调整最大尺寸（最高 8K），保留原始分辨率。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>为什么 GIF 转为静态图？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  本工具基于 Canvas API 处理图片，GIF 动画将转为静态第一帧。如需保留动画效果，建议使用专用的视频转 GIF 工具或视频格式转换工具。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关图像工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-compressor" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片压缩工具</div>
                  <div class="text-xs text-theme-secondary">批量压缩 JPG/PNG/WebP，减小体积</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-background-remover" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片背景去除</div>
                  <div class="text-xs text-theme-secondary">AI 一键抠图，导出透明背景</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-cropper" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片裁剪工具</div>
                  <div class="text-xs text-theme-secondary">自由裁剪并导出至指定尺寸</div>
                </a>
              </li>
              <li>
                <a href="/tools/video-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">视频格式转换</div>
                  <div class="text-xs text-theme-secondary">MP4/MOV/AVI 等视频格式互转</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
