---
import Layout from "../../layouts/Layout.astro";
import AdSense from "../../components/ads/AdSense.astro";

title: "免费在线图片去底工具"
description: "免费在线图片背景去除工具，采用 AI 智能识别技术，一键自动扣除人物、商品、动物等图片背景。浏览器本地离线处理，无需上传服务器，100% 保护隐私。"
technologies: "Transformers.js, WebGL, React"
category: "image"
order: 1

const pageTitle = "免费在线图片去底工具";
const pageDescription = "免费在线图片背景去除工具，采用 AI 智能识别技术，一键自动扣除人物、商品、动物等图片背景。浏览器本地离线处理，无需上传服务器，100% 保护隐私。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线图片去底工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/image-background-remover",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "AI 智能自动识别前景",
        "浏览器本地离线处理",
        "100% 隐私保护，无需上传",
        "支持 JPG, PNG, WebP 格式",
        "透明背景 PNG 导出",
        "完全免费，无次数限制"
      ],
      "author": {
          "@type": "Organization",
          "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "图片需要上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不需要。本工具使用先进的 WebAssembly 和 WebGL 技术，直接在您的浏览器中运行 AI 模型。所有图片处理过程完全在本地进行，您的隐私绝对安全。"
          }
        },
        {
          "@type": "Question",
          "name": "支持哪些图片格式？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "支持常见的图片格式，包括 JPG, JPEG, PNG, WebP 等。输出格式为带有透明背景的 PNG 图片。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么第一次使用加载较慢？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "因为工具需要下载 AI 模型文件（约几十 MB）到您的浏览器缓存中。第一次加载完成后，模型会保存在本地，下次访问时即可秒开使用。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何去除图片背景",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传图片",
          "text": "点击“选择文件”按钮，从您的设备中选择需要处理的图片。"
        },
        {
          "@type": "HowToStep",
          "name": "执行抠图",
          "text": "点击“一键去背景”按钮，AI 模型将自动分析图片并移除背景。首次使用可能需要等待模型加载。"
        },
        {
          "@type": "HowToStep",
          "name": "下载结果",
          "text": "处理完成后，预览效果。点击“下载”按钮即可保存透明背景的 PNG 图片。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <style>
    @reference "tailwindcss";
    /* 基础样式 */
    .canvas-container {
        background-image: linear-gradient(45deg, #ccc 25%, transparent 25%), 
                          linear-gradient(-45deg, #ccc 25%, transparent 25%), 
                          linear-gradient(45deg, transparent 75%, #ccc 75%), 
                          linear-gradient(-45deg, transparent 75%, #ccc 75%);
        background-size: 20px 20px;
        background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
        background-color: #fff;
    }

    .tool-btn {
        @apply p-2 rounded-lg transition-all duration-200 border border-transparent;
    }
    
    .tool-btn.active {
        @apply bg-blue-100 border-blue-500 text-blue-600;
    }
    
    .tool-btn:not(.active):hover {
        @apply bg-gray-100;
    }

    input[type="range"] {
        @apply w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer;
    }
    
    input[type="range"]::-webkit-slider-thumb {
        @apply w-4 h-4 bg-blue-500 rounded-full border-none appearance-none transition-transform duration-200;
    }
    
    input[type="range"]::-webkit-slider-thumb:hover {
        @apply scale-125;
    }

    .loading-spinner {
        border: 4px solid rgba(0, 0, 0, 0.1);
        border-left-color: #3b82f6;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
  </style>

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">图片背景去除工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          本地离线模型去除图片背景工具。所有处理<span class="text-accent font-semibold">完全在本地浏览器完成</span>，无需上传服务器，保护您的隐私。首次使用需要加载模型，可能需要一些时间。
        </p>
      </div>

      <!-- Main Content -->
      <div class="max-w-6xl mx-auto flex flex-col gap-6">
        
        <!-- Top Controls: Upload and Actions -->
        <div class="bg-div-theme rounded-xl p-4 shadow-lg border border-div-theme flex flex-wrap items-center justify-between gap-4">
             <div class="flex items-center gap-4 flex-1">
                 <!-- Upload Button -->
                 <div class="relative">
                     <button class="btn-theme px-6 py-2 rounded-lg font-medium flex items-center gap-2 hover:opacity-90 transition-opacity cursor-pointer">
                         <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                         <span>选择文件</span>
                     </button>
                     <input type="file" id="fileInput" accept="image/png, image/jpeg, image/webp" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                 </div>
                 
                 <!-- File Info -->
                 <div class="text-sm text-theme-secondary" id="fileInfoText">
                     未选择任何文件
                 </div>
             </div>
             
             <!-- Processing Status (Initially hidden) -->
             <div id="processingStatus" class="flex-1 flex items-center justify-center gap-3 hidden">
                 <div class="flex flex-col items-center w-full max-w-xs">
                     <div class="flex items-center gap-2 mb-1">
                         <div class="loading-spinner w-4 h-4 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                         <span class="text-sm font-medium text-blue-600" id="progressText">正在处理中...</span>
                     </div>
                     <div class="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
                         <div id="progressBar" class="bg-blue-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                     </div>
                 </div>
             </div>
             
             <div class="flex items-center gap-4">
                 <!-- Status -->
                 <div id="modelStatus" class="text-sm text-theme-secondary flex items-center gap-2 hidden md:flex">
                    <span class="w-2 h-2 rounded-full bg-gray-400" id="statusDot"></span>
                    <span id="statusText">模型未加载</span>
                 </div>

                 <!-- Action Buttons -->
                 <button id="removeBgBtn" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-medium flex items-center gap-2 hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" disabled>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                    <span>一键去背景</span>
                 </button>
                 
                 <!-- Reset Button -->
                 <button id="resetBtn" class="bg-gray-500 text-white px-6 py-2 rounded-lg font-medium flex items-center gap-2 hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" disabled>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.001 0 01-15.357-2m15.357 2H15"></path></svg>
                    <span>重置</span>
                 </button>

                 <!-- Download Button -->
                 <button id="downloadBtn" class="bg-green-600 text-white px-6 py-2 rounded-lg font-medium flex items-center gap-2 hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" disabled>
                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                     <span>下载</span>
                 </button>
                 <select id="exportFormat" class="hidden">
                    <option value="png">PNG</option>
                 </select>
             </div>
        </div>

        <!-- Canvas Workspace -->
        <div class="bg-div-theme rounded-xl shadow-lg border border-div-theme overflow-hidden flex flex-col h-[600px]">
                <!-- Header -->
                <div class="p-3 border-b border-div-theme flex bg-theme-secondary">
                    <div class="flex-1 flex justify-center items-center">
                        <span class="font-medium text-theme-primary">原图</span>
                    </div>
                    <div class="flex-1 flex justify-center items-center border-l border-div-theme">
                        <span class="font-medium text-theme-primary">抠图结果</span>
                    </div>
                </div>

                <!-- Canvas Area -->
                <div class="relative flex-1 bg-gray-50 dark:bg-gray-900 overflow-hidden flex flex-col md:flex-row h-full" id="canvasContainer">
                    <!-- Left: Original Image -->
                    <div class="flex-1 flex flex-col border-r border-div-theme relative group bg-theme-primary h-full">
                        <div class="flex-1 overflow-hidden relative flex items-center justify-center" id="originalWrapper">
                            <canvas id="originalCanvas" class="block w-full h-full object-contain"></canvas>
                            <div id="originalEmptyState" class="absolute inset-0 flex items-center justify-center text-theme-secondary pointer-events-none border-2 border-dashed border-div-theme m-4 rounded-lg">
                                <div class="text-center">
                                    <p class="mb-2 text-3xl">📷</p>
                                    <p>未选择任何文件</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Result Image -->
                    <div class="flex-1 flex flex-col relative group h-full bg-theme-primary">
                         <!-- Transparent background pattern -->
                         <!-- Only show pattern in light mode, or use a darker pattern for dark mode -->
                         <div class="absolute inset-0 bg-[url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAMUlEQVQ4T2NkYGAQYcAP3uCTZhw1gGGYhAGBZIA/nYDCgBDAm9BGDWAAJyRCgLaBCAAgXwixzAS0pgAAAABJRU5ErkJggg==')] opacity-10 pointer-events-none"></div>
                         
                         <div class="flex-1 overflow-hidden relative flex items-center justify-center z-10" id="canvasWrapper">
                            <div class="relative w-full h-full flex items-center justify-center">
                                <canvas id="mainCanvas" class="block w-full h-full object-contain"></canvas>
                                <!-- Overlay for loading -->
                                <div id="loadingOverlay" class="absolute inset-0 bg-theme-primary/80 z-50 flex flex-col items-center justify-center hidden">
                                    <div class="loading-spinner mb-4"></div>
                                    <p class="text-theme-primary font-medium" id="loadingText">处理中...</p>
                                </div>
                            </div>
                            <!-- Result Empty State (Hidden by default, shown when no result) -->
                            <div id="resultEmptyState" class="absolute inset-0 flex items-center justify-center text-theme-secondary pointer-events-none">
                                <!-- <p>抠图结果在下方显示</p> -->
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Footer Info -->
                <div class="p-2 border-t border-div-theme text-xs text-theme-secondary flex justify-between bg-theme-secondary">
                    <span id="imageInfo"></span>
                    <span id="processTime"></span>
                </div>
        </div>

      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <!-- SEO Content Section -->
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">
          
          <!-- Introduction -->
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么选择在线 AI 抠图？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              在电商设计、个人证件照制作或日常图片处理中，去除图片背景（抠图）通常是一项耗时且繁琐的工作。传统 Photoshop 钢笔工具抠图需要极大的耐心和技巧。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 的在线图片去底工具</strong> 引入了最先进的 AI 视觉识别模型，能够在几秒钟内精准识别人物、动物、商品等主体，并自动将背景分离。更重要的是，我们采用了 <span class="font-bold text-accent">WebAssembly + WebGL</span> 技术，让庞大的 AI 模型直接在您的浏览器中运行，实现了真正的<strong>离线处理</strong>，无需担心照片隐私泄露。
            </p>
          </section>

          <!-- Features Grid -->
          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">100% 隐私安全</h3>
                <p class="text-theme-secondary">不同于其他在线工具，您的图片数据完全在本地处理，绝不会上传到任何服务器，安全无忧。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">⚡</div>
                <h3 class="text-xl font-semibold mb-2">AI 智能识别</h3>
                <p class="text-theme-secondary">采用 RMBG 等高性能分割模型，发丝级抠图精度，自动处理复杂边缘。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🆓</div>
                <h3 class="text-xl font-semibold mb-2">完全免费使用</h3>
                <p class="text-theme-secondary">没有积分限制，不需要注册登录，打开网页即可无限次免费使用。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🖼️</div>
                <h3 class="text-xl font-semibold mb-2">高清无损导出</h3>
                <p class="text-theme-secondary">支持原分辨率导出透明背景的 PNG 图片，保持画质清晰。</p>
              </div>
            </div>
          </section>

          <!-- How to Use -->
          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">如何使用 AI 一键抠图？</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">选择图片</h3>
                  <p class="text-theme-secondary">点击“选择文件”按钮，上传您想要处理的 JPG, PNG 或 WebP 图片。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">等待处理</h3>
                  <p class="text-theme-secondary">
                    点击“一键去背景”按钮。首次使用时会自动下载 AI 模型（约需几秒至半分钟），之后即可瞬间完成。
                  </p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">下载保存</h3>
                  <p class="text-theme-secondary">处理完成后，您可以对比原图和效果图。满意后点击“下载”按钮保存透明背景图片。</p>
                </div>
              </li>
            </ol>
          </section>

        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-8">
          
          <!-- FAQ Widget -->
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>处理速度为什么有时候很慢？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  本工具完全依赖您的本地设备性能（CPU/GPU）。如果您的电脑配置较低，或者处理的是超高分辨率的大图，速度可能会变慢。此外，首次加载模型需要下载数据，受网络环境影响。
                </p>
              </details>
              
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>支持批量处理吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  目前的版本仅支持单张图片处理。我们正在开发批量处理功能，敬请期待。
                </p>
              </details>

              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>抠图效果不理想怎么办？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  AI 模型对主体清晰、背景简单的图片效果最好。如果背景非常复杂或与主体颜色相近，可能会出现识别偏差。建议尝试更换背景较干净的图片。
                </p>
              </details>
            </div>
          </div>

          <!-- Related Tools -->
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关图像工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-compressor" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片压缩工具</div>
                  <div class="text-xs text-theme-secondary">智能压缩 PNG/JPG，减小体积</div>
                </a>
              </li>
              <li>
                <a href="/tools/video-to-gif" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">视频转 GIF</div>
                  <div class="text-xs text-theme-secondary">视频截取并转换为动态 GIF</div>
                </a>
              </li>
              <li>
                <a href="/tools/base64-encoder-decoder" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">Base64 转换</div>
                  <div class="text-xs text-theme-secondary">图片转 Base64 编码</div>
                </a>
              </li>
            </ul>
