---
import Layout from "../../layouts/Layout.astro";
import VolumeCalculator from '../../components/tools/VolumeCalculator';
import AdSense from "../../components/ads/AdSense.astro";

title: "在线体积计算器 (Volume Calculator)"
description: "免费在线体积计算器，支持球体、圆柱体、圆锥体、立方体、长方体等常见几何图形，附带计算公式和图形演示。"
technologies: "React, TailwindCSS"
category: "calculator"
order: 100

const pageTitle = "在线体积计算器 (Volume Calculator)";
const pageDescription = "免费在线体积计算器，支持球体、圆柱体、圆锥体、立方体、长方体等常见几何图形，附带计算公式和图形演示。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线体积计算器",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/volume-calculator",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "支持球体、圆柱、圆锥等常见几何体",
        "输入尺寸参数自动计算体积",
        "附带公式展示与结果说明",
        "适合学习、工程和教学演示",
        "在线计算无需安装"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "公式会根据图形自动切换吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "会。选择不同几何体后，页面会展示对应体积公式并按输入参数计算结果。"
          }
        },
        {
          "@type": "Question",
          "name": "计算结果单位是什么？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "结果单位与输入单位一致的三次方形式，例如厘米输入会得到立方厘米结果。"
          }
        },
        {
          "@type": "Question",
          "name": "可用于工程估算吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "可用于快速估算，正式工程场景建议结合公差和规范进行复核。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用体积计算器",
      "step": [
        {
          "@type": "HowToStep",
          "name": "选择几何体",
          "text": "在列表中选择球体、圆柱、圆锥等目标图形。"
        },
        {
          "@type": "HowToStep",
          "name": "输入尺寸参数",
          "text": "填写半径、高度、长宽高等必要参数。"
        },
        {
          "@type": "HowToStep",
          "name": "查看体积结果",
          "text": "读取计算值并按需要复制到作业、报告或方案中。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">体积计算器</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          多种几何体体积一键计算。<span class="text-accent font-semibold">输入参数即得结果与公式</span>，适合学习、出题和工程估算场景。
        </p>
      </div>
      
      <div class="max-w-6xl mx-auto bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
        <VolumeCalculator client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 在线体积计算器适用于哪些任务？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              从中学几何学习到工程材料估算，体积计算都很常见。手动套公式容易漏项或单位混淆，在线计算能显著提升准确性与效率。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 体积计算器</strong> 提供直观输入与即时反馈，帮助你快速完成球体、圆柱、圆锥、立方体等多形体计算。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🧊</div>
                <h3 class="text-xl font-semibold mb-2">多几何体支持</h3>
                <p class="text-theme-secondary">覆盖常见立体图形，满足课堂和工程基础计算需求。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📐</div>
                <h3 class="text-xl font-semibold mb-2">公式联动展示</h3>
                <p class="text-theme-secondary">切换图形自动显示对应公式，便于理解计算过程。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">⚡</div>
                <h3 class="text-xl font-semibold mb-2">输入即算即得</h3>
                <p class="text-theme-secondary">实时返回体积结果，减少反复查表与人工代入步骤。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🎓</div>
                <h3 class="text-xl font-semibold mb-2">学习场景友好</h3>
                <p class="text-theme-secondary">帮助学生理解参数关系，提升几何建模与应用能力。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步完成体积计算</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">选择图形</h3>
                  <p class="text-theme-secondary">选定球体、圆柱、圆锥或其他目标几何体。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">填写尺寸参数</h3>
                  <p class="text-theme-secondary">输入半径、高度或长宽高等必要维度。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">读取并应用结果</h3>
                  <p class="text-theme-secondary">查看结果与公式，复制用于作业、报告或预算计算。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>输入单位可以混用吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  建议统一单位输入，避免因单位不一致导致结果偏差。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>可以计算空心结构吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  可通过“外体积减内体积”的方式估算，先分别计算两个实体体积再求差值。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>结果可直接用于成本估算吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  可用于前期估算，正式报价仍建议叠加损耗率和工艺参数复核。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关计算工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/unit-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">在线全能单位换算器</div>
                  <div class="text-xs text-theme-secondary">体积结果可继续做单位换算</div>
                </a>
              </li>
              <li>
                <a href="/tools/periodic-table" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">在线元素周期表</div>
                  <div class="text-xs text-theme-secondary">结合密度和元素属性进行拓展计算</div>
                </a>
              </li>
              <li>
                <a href="/tools/text-diff" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">文本差异对比工具</div>
                  <div class="text-xs text-theme-secondary">对比不同方案的计算说明文本</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
