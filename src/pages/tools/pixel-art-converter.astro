---
import Layout from "../../layouts/Layout.astro";
import PixelArtConverter from '../../components/tools/PixelArtConverter';
import AdSense from "../../components/ads/AdSense.astro";

title: "在线图片转像素画工具"
description: "一键将照片转换为复古 8-bit/16-bit 像素艺术风格，支持自定义像素大小和调色板，纯本地处理。"
technologies: "Canvas API, React, TailwindCSS"
category: "image"
order: 100

const pageTitle = "在线图片转像素画工具";
const pageDescription = "一键将照片转换为复古 8-bit/16-bit 像素艺术风格，支持自定义像素大小和调色板，纯本地处理。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线图片转像素画工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/pixel-art-converter",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "一键将照片转换为像素画风格",
        "支持像素块大小精细调整",
        "支持调色板数量控制",
        "实时预览转换效果",
        "浏览器本地处理，隐私安全"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "像素块越大效果会怎样？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "像素块越大，画面越抽象、复古感更强；像素块越小，细节保留更多。"
          }
        },
        {
          "@type": "Question",
          "name": "调色板数量对结果有什么影响？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "颜色数量越少，风格更统一且更接近经典游戏画面；颜色越多则更接近原图。"
          }
        },
        {
          "@type": "Question",
          "name": "转换后的图片清晰度会下降吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "像素风本身是有损风格化处理，会主动降低细节以形成复古视觉效果。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何把照片转换为像素画",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传图片",
          "text": "导入待处理图片并查看初始预览。"
        },
        {
          "@type": "HowToStep",
          "name": "调节参数",
          "text": "设置像素块大小和颜色数量，找到理想风格。"
        },
        {
          "@type": "HowToStep",
          "name": "导出作品",
          "text": "确认效果后下载像素画，可用于头像、海报或游戏素材。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">在线图片转像素画工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          把照片快速转换成复古像素艺术。<span class="text-accent font-semibold">像素大小与色彩数量自由控制</span>，轻松打造 8-bit/16-bit 风格作品。
        </p>
      </div>
      
      <div class="max-w-6xl mx-auto bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
        <PixelArtConverter client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么像素画风格持续流行？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              像素画兼具怀旧感与现代审美，能在有限色彩中构建强识别度画面，适合头像、社媒封面、游戏素材和创意海报等场景。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 像素画转换工具</strong> 让你无需安装复杂软件即可在线完成风格化处理，快速预览并导出结果。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🕹️</div>
                <h3 class="text-xl font-semibold mb-2">复古像素风一键生成</h3>
                <p class="text-theme-secondary">自动将普通照片转换为经典游戏视觉风格。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📐</div>
                <h3 class="text-xl font-semibold mb-2">像素粒度可控</h3>
                <p class="text-theme-secondary">通过像素块大小调节抽象程度，平衡细节与艺术感。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🎨</div>
                <h3 class="text-xl font-semibold mb-2">调色板数量可调</h3>
                <p class="text-theme-secondary">控制颜色数量实现更统一、更具辨识度的风格输出。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">本地转换更安全</h3>
                <p class="text-theme-secondary">图片在浏览器内处理，不上传服务器，敏感素材也可放心使用。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步完成像素化</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">上传图片</h3>
                  <p class="text-theme-secondary">选择要转换的照片、插画或截图。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">调整参数</h3>
                  <p class="text-theme-secondary">设置像素大小与颜色数量，实时查看不同风格效果。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">下载导出</h3>
                  <p class="text-theme-secondary">确认预览后导出像素画，可直接用于设计和分享。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>人物照片适合做像素画吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  适合。建议选择主体清晰、背景简洁的图片，可获得更好的像素化识别效果。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>颜色越少文件就越小吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  通常会有帮助，但最终体积还取决于输出格式、分辨率和压缩参数。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>是否会保留原图比例？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  会保留，工具按原图比例处理，主要改变的是像素化颗粒和色彩表现。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关图像工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-cropper" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片裁剪工具</div>
                  <div class="text-xs text-theme-secondary">先裁剪主体再像素化效果更聚焦</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-watermark" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片水印处理工具</div>
                  <div class="text-xs text-theme-secondary">给像素画作品添加版权标识</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-compressor" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片压缩工具</div>
                  <div class="text-xs text-theme-secondary">进一步压缩像素画图片体积</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
