---
import Layout from "../../layouts/Layout.astro";
import AdSense from "../../components/ads/AdSense.astro";

// 页面元数据，供 index.astro 读取
title: "PDF转图片 - 免费在线PDF转换器"
description: "一个功能强大的纯前端PDF转图片工具，支持单页导出、合并导出、指定页数范围导出。所有操作均在浏览器本地完成，无需上传文件，确保您的文档隐私安全。"
technologies: "PDF.js, JavaScript, Canvas"
category: "image"
order: 6

const pageTitle = "PDF转图片 - 免费在线PDF转换器";
const pageDescription = "一个功能强大的纯前端PDF转图片工具，支持单页导出、合并导出、指定页数范围导出。所有操作均在浏览器本地完成，无需上传文件，确保您的文档隐私安全。";
const keywords = "PDF转图片, PDF转JPG, PDF转PNG, PDF转换器, 免费PDF工具, 在线PDF转换";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "PDF转图片",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/pdf-to-image",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "PDF转单张图片",
        "PDF转长图合并",
        "自定义页面范围导出",
        "支持PNG和JPEG格式",
        "自定义压缩质量",
        "浏览器本地处理，隐私安全"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "我的PDF文件会被上传吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。本工具完全基于浏览器技术（PDF.js）开发，所有转换过程都在您的设备本地完成，文件不会上传到任何服务器，绝对保障您的隐私安全。"
          }
        },
        {
          "@type": "Question",
          "name": "支持多大的PDF文件？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "理论上支持任意大小的PDF文件，但受限于浏览器内存。建议文件大小在 200MB 以内，页数在 100 页以内，以获得最佳的转换速度和体验。"
          }
        },
        {
          "@type": "Question",
          "name": "如何导出高质量图片？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "在导出选项中，选择 'PNG' 格式可以获得无损的高清图片。如果选择 'JPEG' 格式，可以将压缩比例调整为 100% 以获得最高画质。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何将PDF转换为图片",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传PDF",
          "text": "点击上传区域选择您的PDF文件，或直接将文件拖入框内。"
        },
        {
          "@type": "HowToStep",
          "name": "预览与设置",
          "text": "在预览区确认文件内容，选择转换模式（单页/合并/范围）和输出格式。"
        },
        {
          "@type": "HowToStep",
          "name": "转换与下载",
          "text": "点击'开始转换'按钮，等待处理完成后下载生成的图片。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">PDF转图片</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          功能强大的纯前端PDF转图片工具，支持单页、合并及范围导出。<br class="hidden md:inline" />
          <span class="text-accent font-medium">所有操作均在本地完成</span>，无需上传服务器，保护您的隐私安全。
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-6xl mx-auto">
        <div class="pdf-to-image-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
          <!-- Upload Section -->
          <div class="upload-section mb-8">
            <h2 class="text-2xl font-semibold text-theme-primary mb-4">上传PDF文件</h2>
            <div class="upload-area border-2 border-dashed border-theme-secondary rounded-lg p-8 text-center mb-6 cursor-pointer hover:border-blue-500 transition-colors">
              <div class="upload-icon text-4xl mb-4">📄</div>
              <p class="text-theme-secondary mb-4">点击或拖拽PDF文件到此处上传</p>
              <p class="text-sm text-theme-secondary opacity-70">支持 PDF 格式，最大 2048MB，最多 100 页</p>
              <input type="file" id="fileInput" accept=".pdf" class="hidden">
              <button id="browseBtn" class="btn-theme px-6 py-3 rounded transition-colors mt-4 cursor-pointer">浏览文件</button>
            </div>
          </div>

          <!-- PDF Preview Section -->
          <div class="pdf-preview-section mb-8 hidden" id="pdfPreviewSection">
            <h2 class="text-2xl font-semibold text-theme-primary mb-4">PDF预览</h2>
            <div class="pdf-preview-container bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
              <div class="flex flex-col md:flex-row gap-6">
                <!-- Main Preview -->
                <div class="flex-1">
                  <div class="preview-area bg-div-theme rounded-lg p-4 overflow-auto max-h-[600px] border border-theme-secondary">
                    <div id="pdfPreview" class="pdf-preview">
                      <div class="empty-preview text-center py-12 text-theme-secondary">
                        正在加载PDF预览...
                      </div>
                    </div>
                  </div>
                  <div class="preview-controls flex justify-between items-center mt-4">
                    <div class="page-info text-theme-secondary">
                      <span id="currentPage">1</span> / <span id="totalPages">0</span>
                    </div>
                    <div class="page-controls flex gap-2">
                      <button id="prevPage" class="btn-theme px-3 py-1 rounded text-sm cursor-pointer">上一页</button>
                      <button id="nextPage" class="btn-theme px-3 py-1 rounded text-sm cursor-pointer">下一页</button>
                    </div>
                    <div class="zoom-controls flex gap-2">
                      <button id="zoomOut" class="btn-theme px-3 py-1 rounded text-sm cursor-pointer">缩小</button>
                      <button id="zoomIn" class="btn-theme px-3 py-1 rounded text-sm cursor-pointer">放大</button>
                      <button id="resetZoom" class="btn-theme px-3 py-1 rounded text-sm cursor-pointer">重置</button>
                    </div>
                  </div>
                </div>
                <!-- Thumbnails -->
                <div class="w-full md:w-64">
                  <h3 class="text-lg font-semibold text-theme-primary mb-3">页面缩略图</h3>
                  <div class="thumbnails-container bg-div-theme rounded-lg p-4 overflow-y-auto max-h-[600px] border border-theme-secondary">
                    <div id="thumbnailsList" class="thumbnails-list space-y-2">
                      <!-- Thumbnails will be generated here -->
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Conversion Options Section -->
          <div class="conversion-section mb-8 hidden" id="conversionSection">
            <h2 class="text-2xl font-semibold text-theme-primary mb-4">转换选项</h2>
            <div class="conversion-options bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
              <!-- Conversion Mode Tabs -->
              <div class="tabs flex border-b border-theme-secondary mb-6">
                <button id="tabSinglePage" class="tab-btn flex-1 py-3 px-4 font-medium text-theme-primary border-b-2 border-accent">单页导出</button>
                <button id="tabMerge" class="tab-btn flex-1 py-3 px-4 font-medium text-theme-secondary hover:text-theme-primary">合并导出</button>
                <button id="tabRange" class="tab-btn flex-1 py-3 px-4 font-medium text-theme-secondary hover:text-theme-primary">指定页数导出</button>
              </div>

              <!-- Tab Contents -->
              <div class="tab-content">
                <!-- Single Page Export -->
                <div id="contentSinglePage" class="tab-pane">
                  <div class="space-y-4">
                    <div class="option flex items-center justify-between">
                      <label for="imageFormat" class="text-theme-primary">图片格式:</label>
                      <select id="imageFormat" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                        <option value="png">PNG (高清无压缩)</option>
                        <option value="jpeg">JPG (可调节压缩)</option>
                      </select>
                    </div>
                    <div class="option flex flex-col gap-2" id="jpegOptions">
                      <label for="jpegQuality" class="text-theme-primary">JPG压缩比例:</label>
                      <div class="flex items-center gap-4">
                        <input type="range" id="jpegQuality" min="10" max="100" value="80" class="flex-1">
                        <span id="jpegQualityValue" class="text-theme-secondary w-12 text-center">80%</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Merge Export -->
                <div id="contentMerge" class="tab-pane hidden">
                  <div class="space-y-4">
                    <div class="option flex items-center justify-between">
                      <label for="mergeImageFormat" class="text-theme-primary">图片格式:</label>
                      <select id="mergeImageFormat" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                        <option value="png">PNG (高清无压缩)</option>
                        <option value="jpeg">JPG (可调节压缩)</option>
                      </select>
                    </div>
                    <div class="option flex flex-col gap-2" id="mergeJpegOptions">
                      <label for="mergeJpegQuality" class="text-theme-primary">JPG压缩比例:</label>
                      <div class="flex items-center gap-4">
                        <input type="range" id="mergeJpegQuality" min="10" max="100" value="80" class="flex-1">
                        <span id="mergeJpegQualityValue" class="text-theme-secondary w-12 text-center">80%</span>
                      </div>
                    </div>
                    <div class="option flex items-center justify-between">
                      <label for="mergeGap" class="text-theme-primary">拼接间隙:</label>
                      <select id="mergeGap" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                        <option value="0">无间隙</option>
                        <option value="10">有间隙 (10px)</option>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- Range Export -->
                <div id="contentRange" class="tab-pane hidden">
                  <div class="space-y-4">
                    <div class="option flex items-center justify-between">
                      <label class="text-theme-primary">页数范围:</label>
                      <div class="flex gap-2">
                        <input type="number" id="startPage" min="1" value="1" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary w-24">
                        <span class="text-theme-secondary">-</span>
                        <input type="number" id="endPage" min="1" value="1" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary w-24">
                        <span id="pageRangeError" class="text-red-500 text-sm hidden">页码范围无效</span>
                      </div>
                    </div>
                    <div class="option flex items-center justify-between">
                      <label for="rangeExportMode" class="text-theme-primary">导出方式:</label>
                      <select id="rangeExportMode" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                        <option value="single">单页拆分</option>
                        <option value="merge">合并为长图</option>
                      </select>
                    </div>
                    <div class="option flex items-center justify-between">
                      <label for="rangeImageFormat" class="text-theme-primary">图片格式:</label>
                      <select id="rangeImageFormat" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                        <option value="png">PNG (高清无压缩)</option>
                        <option value="jpeg">JPG (可调节压缩)</option>
                      </select>
                    </div>
                    <div class="option flex flex-col gap-2" id="rangeJpegOptions">
                      <label for="rangeJpegQuality" class="text-theme-primary">JPG压缩比例:</label>
                      <div class="flex items-center gap-4">
                        <input type="range" id="rangeJpegQuality" min="10" max="100" value="80" class="flex-1">
                        <span id="rangeJpegQualityValue" class="text-theme-secondary w-12 text-center">80%</span>
                      </div>
                    </div>
                    <div class="option flex items-center justify-between" id="rangeGapOption">
                      <label for="rangeMergeGap" class="text-theme-primary">拼接间隙:</label>
                      <select id="rangeMergeGap" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                        <option value="0">无间隙</option>
                        <option value="10">有间隙 (10px)</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="action-buttons flex flex-wrap gap-4 justify-center mt-8">
                <button id="convertBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium cursor-pointer transition-all duration-200 hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 min-w-[160px]">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                  开始转换
                </button>
                <button id="clearBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium cursor-pointer transition-all duration-200 hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 min-w-[160px]">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  清除文件
                </button>
              </div>
            </div>
          </div>

          <!-- Conversion Progress -->
          <div class="progress-section mb-8 hidden" id="progressSection">
            <h2 class="text-2xl font-semibold text-theme-primary mb-4">转换进度</h2>
            <div class="progress-container bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
              <div class="progress-bar bg-div-theme rounded-full h-4 mb-4 overflow-hidden">
                <div id="progressFill" class="progress-fill bg-accent h-full w-0 transition-all duration-300"></div>
              </div>
              <div class="progress-info text-center">
                <p id="progressText" class="text-theme-primary">准备开始转换...</p>
                <p id="progressDetail" class="text-theme-secondary text-sm mt-2"></p>
              </div>
            </div>
          </div>

          <!-- Image Preview Section -->
          <div class="image-preview-section mb-8 hidden" id="imagePreviewSection">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-2xl font-semibold text-theme-primary">图片预览</h2>
              <button id="reselectConversionBtn" class="btn-theme px-6 py-2 rounded transition-colors cursor-pointer hover:bg-opacity-90 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                重新选择转换规则
              </button>
            </div>
            <div class="image-preview-container bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
              <div id="imagePreviewArea" class="image-preview-area">
                <!-- Images will be generated here -->
              </div>
              <div class="image-controls flex flex-wrap gap-4 justify-center mt-6">
                <button id="downloadAllBtn" class="btn-theme px-6 py-3 rounded transition-colors cursor-pointer hover:bg-opacity-90 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                  批量下载
                </button>
                <button id="backToPDFBtn" class="btn-theme px-6 py-3 rounded transition-colors cursor-pointer hover:bg-opacity-90 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                  </svg>
                  重新选择转换规则
                </button>
              </div>
            </div>
          </div>
          
          <div class="mt-12 mb-12">
            <AdSense />
          </div>

          <!-- SEO Content Section -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-16">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-12">
              <!-- Introduction -->
              <section>
                <h2 class="text-2xl md:text-3xl font-bold text-theme-primary mb-6">为什么选择我们的 PDF 转图片工具？</h2>
                <div class="prose prose-lg text-theme-secondary max-w-none">
                  <p class="mb-4">
                    在日常办公和学习中，我们经常需要将 PDF 文件转换为图片，以便于在社交媒体分享、插入到演示文稿或在不支持 PDF 预览的设备上查看。传统的转换方式往往需要安装庞大的软件，或者将敏感文件上传到云端服务器，这不仅麻烦，还存在隐私泄露的风险。
                  </p>
                  <p>
                    Toolkit.ren 推出的<strong>在线 PDF 转图片工具</strong>，完美解决了这些痛点。它采用先进的浏览器端渲染技术（PDF.js），直接在您的设备本地进行解析和转换。这意味着您的文件<strong>从未离开过您的电脑</strong>，实现了真正的零上传、零风险。
                  </p>
                </div>
              </section>

              <!-- Features -->
              <section>
                <h2 class="text-2xl md:text-3xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="bg-theme-secondary p-6 rounded-xl border border-theme-secondary">
                    <div class="text-3xl mb-4">🔒</div>
                    <h3 class="text-xl font-semibold text-theme-primary mb-2">隐私安全第一</h3>
                    <p class="text-theme-secondary">纯前端技术实现，文件不上传服务器，所有处理均在本地完成，银行级安全保障。</p>
                  </div>
                  <div class="bg-theme-secondary p-6 rounded-xl border border-theme-secondary">
                    <div class="text-3xl mb-4">🖼️</div>
                    <h3 class="text-xl font-semibold text-theme-primary mb-2">多种导出模式</h3>
                    <p class="text-theme-secondary">支持单页导出、多页合并长图、指定页数范围导出，满足各种场景需求。</p>
                  </div>
                  <div class="bg-theme-secondary p-6 rounded-xl border border-theme-secondary">
                    <div class="text-3xl mb-4">⚡</div>
                    <h3 class="text-xl font-semibold text-theme-primary mb-2">极速转换体验</h3>
                    <p class="text-theme-secondary">基于 WebAssembly 技术，解析速度快，即拖即转，无需等待漫长的上传下载。</p>
                  </div>
                  <div class="bg-theme-secondary p-6 rounded-xl border border-theme-secondary">
                    <div class="text-3xl mb-4">🎨</div>
                    <h3 class="text-xl font-semibold text-theme-primary mb-2">自定义输出</h3>
                    <p class="text-theme-secondary">支持 JPG/PNG 格式，可调节图片质量和压缩比，平衡画质与体积。</p>
                  </div>
                </div>
              </section>

              <!-- How to Use -->
              <section>
                <h2 class="text-2xl md:text-3xl font-bold text-theme-primary mb-6">如何使用</h2>
                <div class="space-y-6">
                  <div class="flex gap-4">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center font-bold">1</div>
                    <div>
                      <h3 class="text-xl font-semibold text-theme-primary mb-2">上传 PDF 文件</h3>
                      <p class="text-theme-secondary">点击上传区域选择文件，或直接将 PDF 拖拽到页面中。支持大文件预览。</p>
                    </div>
                  </div>
                  <div class="flex gap-4">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center font-bold">2</div>
                    <div>
                      <h3 class="text-xl font-semibold text-theme-primary mb-2">选择转换模式</h3>
                      <p class="text-theme-secondary">
                        <strong>单页导出：</strong>将每页保存为单独图片。<br/>
                        <strong>合并导出：</strong>将所有页面拼接为一张长图。<br/>
                        <strong>指定范围：</strong>仅导出需要的页码范围。
                      </p>
                    </div>
                  </div>
                  <div class="flex gap-4">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center font-bold">3</div>
                    <div>
                      <h3 class="text-xl font-semibold text-theme-primary mb-2">开始转换并下载</h3>
                      <p class="text-theme-secondary">点击“开始转换”，完成后可批量打包下载或单独保存图片。</p>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1 space-y-8">
              <!-- FAQ Section -->
