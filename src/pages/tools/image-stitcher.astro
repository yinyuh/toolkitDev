---
import Layout from "../../layouts/Layout.astro";
import AdSense from "../../components/ads/AdSense.astro";

// 页面元数据，供 index.astro 读取
title: "在线拼接合并长图"
description: "一个功能强大的在线图片拼接工具，支持多张图片纵向或横向合并、格式转换、压缩和编辑，所有操作均在本地完成，保护隐私。"
technologies: "Canvas, JavaScript, TailwindCSS"
category: "image"
order: 4

const pageTitle = "在线拼接合并长图";
const pageDescription = "一个功能强大的在线图片拼接工具，支持多张图片纵向或横向合并、格式转换、压缩和编辑，所有操作均在本地完成，保护隐私。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线拼接长图",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/image-stitcher",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "多张图片纵向/横向拼接",
        "图片旋转与翻转编辑",
        "自定义输出格式 (JPEG/PNG/WebP)",
        "自定义压缩质量",
        "浏览器本地处理，隐私安全",
        "一键复制与下载"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "拼接图片会降低画质吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "本工具支持自定义压缩级别。如果您选择“无损 (100%)”，则会尽可能保留原始画质。选择 JPEG 或 WebP 格式时，可以通过调整压缩比来平衡画质和文件大小。"
          }
        },
        {
          "@type": "Question",
          "name": "支持哪些图片格式？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "支持常见的图片格式，包括 JPG, PNG, WebP, GIF, BMP 等。输出格式支持 JPEG, PNG 和 WebP。"
          }
        },
        {
          "@type": "Question",
          "name": "我的图片会上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。所有图片处理逻辑完全在您的浏览器本地（Client-side）执行，图片数据不会上传到任何服务器，确保您的隐私安全。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用在线拼接长图工具",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传图片",
          "text": "点击上传区域或直接拖拽多张图片到页面中。"
        },
        {
          "@type": "HowToStep",
          "name": "调整顺序与编辑",
          "text": "您可以拖动图片调整拼接顺序，或选中单张图片进行旋转、翻转操作。"
        },
        {
          "@type": "HowToStep",
          "name": "设置参数并生成",
          "text": "选择拼接方向（横向/纵向）、输出格式和质量，点击“合并图片”即可生成长图。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <style>
    /* 基础样式 */
    #imageList .image-item {
      cursor: pointer !important;
      transition: all 0.2s ease !important;
      border: 2px solid var(--border-color) !important;
    }
    
    /* 鼠标悬停效果 */
    #imageList .image-item:hover {
      cursor: pointer !important;
      border: 2px solid var(--accent-color) !important;
      box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.5) !important;
    }
    
    /* 选中状态效果 */
    #imageList .image-item.border-blue-500 {
      cursor: pointer !important;
      border: 2px solid var(--accent-color) !important;
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.3) !important;
      background-color: rgba(96, 165, 250, 0.05) !important;
    }
    
    /* 确保未选中状态的样式不会覆盖 */
    #imageList .image-item.border-theme-secondary {
      cursor: pointer !important;
      border: 2px solid var(--border-color) !important;
    }
    
    #imageList .image-item.border-theme-secondary:hover {
      cursor: pointer !important;
      border: 2px solid var(--accent-color) !important;
      box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.5) !important;
    }
  </style>
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">在线拼接长图</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          一个功能强大的在线图片拼接工具，支持多张图片合并、格式转换、压缩和编辑，<span class="text-accent font-semibold">所有操作均在本地完成</span>，保护隐私。
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-6xl mx-auto">
        <div class="image-stitcher-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
          <!-- Upload Section -->
          <div class="upload-section mb-6">
            <div class="upload-area border-2 border-dashed border-theme-secondary rounded-lg p-4 flex flex-col md:flex-row items-center justify-between gap-4 cursor-pointer hover:border-blue-500 transition-colors">
              <div class="flex items-center gap-4">
                 <div class="text-3xl">📷</div>
                 <div class="text-left">
                    <p class="text-theme-primary font-medium">点击或拖拽图片到此处上传</p>
                    <p class="text-xs text-theme-secondary opacity-70">支持 JPG、PNG、WebP、GIF 格式</p>
                 </div>
              </div>
              
              <input type="file" id="fileInput" multiple accept="image/*" class="hidden">
              
              <div class="flex gap-3">
                <button id="browseBtn" class="btn-theme px-4 py-2 rounded transition-colors cursor-pointer text-sm font-medium">浏览文件</button>
                <button id="topResetBtn" class="btn-theme px-4 py-2 rounded transition-colors cursor-pointer hover:bg-red-500 hover:text-white text-sm font-medium">重置</button>
              </div>
            </div>
          </div>

          <!-- Image List Section -->
          <div class="image-list-section mb-8">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-2xl font-semibold text-theme-primary">图片列表 <span id="imageCount" class="text-sm font-normal text-theme-secondary">(0 张图片)</span></h2>
              <button id="sortBtn" class="btn-theme px-4 py-2 rounded transition-colors text-sm font-medium cursor-pointer hover:bg-opacity-90 flex items-center gap-1">
                <span>按名称排序</span>
                <span id="sortIcon">↑</span>
              </button>
            </div>
            <div id="imageList" class="space-y-4 min-h-[200px] border-2 border-dashed border-theme-secondary rounded-lg p-6">
              <div class="empty-state text-center py-12 text-theme-secondary">
                请上传图片以开始拼接
              </div>
            </div>
          </div>

          <!-- Controls Section -->
          <div class="controls-section mb-8 border-2 border-dashed border-theme-secondary rounded-lg p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Merge Options -->
              <div class="bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
                <h3 class="text-xl font-semibold text-theme-primary mb-4">合并选项</h3>
                <div class="space-y-4">
                  <div class="option flex items-center justify-between">
                    <label for="mergeDirection" class="text-theme-primary">合并方向:</label>
                    <select id="mergeDirection" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                      <option value="vertical">纵向 (垂直)</option>
                      <option value="horizontal">横向 (水平)</option>
                    </select>
                  </div>
                  <div class="option flex items-center justify-between">
                    <label for="outputFormat" class="text-theme-primary">输出格式:</label>
                    <select id="outputFormat" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                      <option value="jpeg">JPEG</option>
                      <option value="png">PNG</option>
                      <option value="webp">WebP</option>
                    </select>
                  </div>
                  <div class="option flex items-center justify-between">
                    <label for="compressionLevel" class="text-theme-primary">压缩级别:</label>
                    <select id="compressionLevel" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                      <option value="0.2">低 (20%)</option>
                      <option value="0.5">中 (50%)</option>
                      <option value="0.8">高 (80%)</option>
                      <option value="1" selected>无损 (100%)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Image Editing -->
              <div class="bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
                <h3 class="text-xl font-semibold text-theme-primary mb-4">图片编辑</h3>
                <div id="editControls" class="space-y-4 opacity-50 pointer-events-none">
                  <p class="text-theme-secondary">请选择一张图片进行编辑</p>
                  <div class="grid grid-cols-2 gap-3">
                    <button id="rotateLeft" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      向左旋转
                    </button>
                    <button id="rotateRight" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V8l-3 3m0 0l-3-3m3 3V8m6 8l3-3m-3 3l3 3m-6-8l3 3"></path>
                      </svg>
                      向右旋转
                    </button>
                    <button id="flipHorizontal" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                      </svg>
                      水平翻转
                    </button>
                    <button id="flipVertical" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                      </svg>
                      垂直翻转
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="action-buttons flex flex-wrap gap-4 justify-center mb-8">
            <!-- 非阻塞式临时提示容器 -->
            <div id="notification" class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg transform translate-x-full opacity-0 transition-all duration-300 z-50 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span id="notificationMessage">操作成功！</span>
            </div>
            <button id="stitchBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium cursor-pointer transition-all duration-200 hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              合并图片
            </button>
            <button id="resetBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium cursor-pointer transition-all duration-200 hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              重置
            </button>
            <button id="copyBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
              </svg>
              复制图片
            </button>
            <button id="downloadBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
              </svg>
              下载图片
            </button>
            <button id="openNewBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              新窗口打开
            </button>
          </div>

          <!-- Preview Section -->
          <div class="preview-section mb-8">
            <h2 class="text-2xl font-semibold text-theme-primary mb-4">预览效果</h2>
            <div class="preview-container bg-theme-secondary rounded-lg p-4 overflow-auto max-h-[600px]">
              <div id="previewArea" class="preview-area min-h-[400px]">
                <div class="empty-preview text-center py-12 text-theme-secondary">
                  上传图片后将在此处显示预览
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="my-8">
          <AdSense />
        </div>

        <!-- SEO Content Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary">
          
          <!-- Main Content -->
          <div class="lg:col-span-2 space-y-12">
            
            <!-- Introduction -->
            <section class="prose dark:prose-invert max-w-none">
              <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
                <span class="text-accent">#</span> 为什么选择我们的在线拼图工具？
              </h2>
              <p class="text-lg leading-relaxed text-theme-secondary">
                在分享聊天记录、制作长图文、或整理项目截图时，我们经常需要将多张图片合并为一张。虽然手机 App 和 Photoshop 都能做到，但前者操作繁琐，后者对设备要求高。
              </p>
              <p class="text-lg leading-relaxed text-theme-secondary mt-4">
                <strong>Toolkit.ren 的在线拼接长图工具</strong> 专为效率而生。它直接在浏览器中运行，无需下载安装任何软件，支持拖拽上传、自由排序、旋转编辑，并且提供专业的无损输出选项。最重要的是，所有图片数据<span class="font-bold text-accent">完全在本地处理</span>，充分保护您的隐私安全。
              </p>
            </section>
    
            <!-- Features Grid -->
            <section>
              <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                  <div class="text-3xl mb-3">🛡️</div>
                  <h3 class="text-xl font-semibold mb-2">隐私优先设计</h3>
                  <p class="text-theme-secondary">不同于传统在线工具，我们采用 Client-side 技术，您的照片从未离开过您的设备，杜绝隐私泄露风险。</p>
                </div>
                <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                  <div class="text-3xl mb-3">🧩</div>
                  <h3 class="text-xl font-semibold mb-2">灵活的拼接模式</h3>
                  <p class="text-theme-secondary">支持纵向（长图）和横向（全景）两种拼接方向，满足聊天记录、电影台词、全景照片等多种场景需求。</p>
                </div>
                <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                  <div class="text-3xl mb-3">🎨</div>
                  <h3 class="text-xl font-semibold mb-2">内置简易编辑</h3>
                  <p class="text-theme-secondary">上传后发现图片方向不对？无需重新处理，直接在工具内旋转、翻转图片，所见即所得。</p>
                </div>
                <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                  <div class="text-3xl mb-3">💾</div>
                  <h3 class="text-xl font-semibold mb-2">多种格式输出</h3>
                  <p class="text-theme-secondary">支持导出为通用的 JPEG、透明背景的 PNG 以及高压缩率的 WebP 格式，并可自定义压缩质量。</p>
                </div>
              </div>
            </section>
    
            <!-- How to Use -->
            <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
              <h2 class="text-2xl font-bold text-theme-primary mb-6">如何快速制作长图？</h2>
              <ol class="space-y-6">
                <li class="flex gap-4">
                  <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                  <div>
                    <h3 class="text-lg font-semibold mb-1">批量导入图片</h3>
                    <p class="text-theme-secondary">点击上传区域选择图片，或直接将多张图片拖拽到网页中。支持 JPG, PNG, GIF 等主流格式。</p>
                  </div>
                </li>
                <li class="flex gap-4">
                  <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                  <div>
                    <h3 class="text-lg font-semibold mb-1">调整顺序与参数</h3>
                    <p class="text-theme-secondary">在列表中拖拽图片调整拼接顺序。在下方设置栏选择“纵向”或“横向”拼接，并设定输出格式。</p>
                  </div>
                </li>
                <li class="flex gap-4">
                  <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                  <div>
                    <h3 class="text-lg font-semibold mb-1">一键生成下载</h3>
                    <p class="text-theme-secondary">点击“合并图片”按钮，预览效果满意后，点击“下载图片”保存到本地，或直接复制分享。</p>
                  </div>
                </li>
              </ol>
            </section>
          </div>
    
          <!-- Sidebar -->
          <div class="lg:col-span-1 space-y-8">
            
            <!-- Sticky Container -->
            <div class="sticky top-24 space-y-8">
              
              <!-- FAQ Section -->
              <section class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm">
                <h2 class="text-xl font-bold text-theme-primary mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
