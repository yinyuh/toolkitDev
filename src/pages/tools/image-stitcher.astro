---
import Layout from "../../layouts/Layout.astro";
title: "在线拼接长图"
description: "一个功能强大的在线图片拼接工具，支持多张图片合并、格式转换、压缩和编辑"
technologies: "在线拼接长图"
category: "tool"
order: -1
---

<Layout title="在线拼接长图" description="一个功能强大的在线图片拼接工具，支持多张图片合并、格式转换、压缩和编辑">
  <style>
    /* 基础样式 */
    #imageList .image-item {
      cursor: pointer !important;
      transition: all 0.2s ease !important;
      border: 2px solid var(--border-color) !important;
    }
    
    /* 鼠标悬停效果 */
    #imageList .image-item:hover {
      cursor: pointer !important;
      border: 2px solid var(--accent-color) !important;
      box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.5) !important;
    }
    
    /* 选中状态效果 */
    #imageList .image-item.border-blue-500 {
      cursor: pointer !important;
      border: 2px solid var(--accent-color) !important;
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.3) !important;
      background-color: rgba(96, 165, 250, 0.05) !important;
    }
    
    /* 确保未选中状态的样式不会覆盖 */
    #imageList .image-item.border-theme-secondary {
      cursor: pointer !important;
      border: 2px solid var(--border-color) !important;
    }
    
    #imageList .image-item.border-theme-secondary:hover {
      cursor: pointer !important;
      border: 2px solid var(--accent-color) !important;
      box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.5) !important;
    }
  </style>
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">在线拼接长图</h1>
        <p class="text-theme-secondary max-w-3xl mx-auto">
          一个功能强大的在线图片拼接工具，支持多张图片合并、格式转换、压缩和编辑，所有操作均在本地完成。
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-6xl mx-auto">
        <div class="image-stitcher-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
          <!-- Upload Section -->
          <div class="upload-section mb-6">
            <div class="upload-area border-2 border-dashed border-theme-secondary rounded-lg p-4 flex flex-col md:flex-row items-center justify-between gap-4 cursor-pointer hover:border-blue-500 transition-colors">
              <div class="flex items-center gap-4">
                 <div class="text-3xl">📷</div>
                 <div class="text-left">
                    <p class="text-theme-primary font-medium">点击或拖拽图片到此处上传</p>
                    <p class="text-xs text-theme-secondary opacity-70">支持 JPG、PNG、WebP、GIF 格式</p>
                 </div>
              </div>
              
              <input type="file" id="fileInput" multiple accept="image/*" class="hidden">
              
              <div class="flex gap-3">
                <button id="browseBtn" class="btn-theme px-4 py-2 rounded transition-colors cursor-pointer text-sm font-medium">浏览文件</button>
                <button id="topResetBtn" class="btn-theme px-4 py-2 rounded transition-colors cursor-pointer hover:bg-red-500 hover:text-white text-sm font-medium">重置</button>
              </div>
            </div>
          </div>

          <!-- Image List Section -->
          <div class="image-list-section mb-8">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-2xl font-semibold text-theme-primary">图片列表 <span id="imageCount" class="text-sm font-normal text-theme-secondary">(0 张图片)</span></h2>
              <button id="sortBtn" class="btn-theme px-4 py-2 rounded transition-colors text-sm font-medium cursor-pointer hover:bg-opacity-90 flex items-center gap-1">
                <span>按名称排序</span>
                <span id="sortIcon">↑</span>
              </button>
            </div>
            <div id="imageList" class="space-y-4 min-h-[200px] border-2 border-dashed border-theme-secondary rounded-lg p-6">
              <div class="empty-state text-center py-12 text-theme-secondary">
                请上传图片以开始拼接
              </div>
            </div>
          </div>

          <!-- Controls Section -->
          <div class="controls-section mb-8 border-2 border-dashed border-theme-secondary rounded-lg p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Merge Options -->
              <div class="bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
                <h3 class="text-xl font-semibold text-theme-primary mb-4">合并选项</h3>
                <div class="space-y-4">
                  <div class="option flex items-center justify-between">
                    <label for="mergeDirection" class="text-theme-primary">合并方向:</label>
                    <select id="mergeDirection" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                      <option value="vertical">纵向 (垂直)</option>
                      <option value="horizontal">横向 (水平)</option>
                    </select>
                  </div>
                  <div class="option flex items-center justify-between">
                    <label for="outputFormat" class="text-theme-primary">输出格式:</label>
                    <select id="outputFormat" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                      <option value="jpeg">JPEG</option>
                      <option value="png">PNG</option>
                      <option value="webp">WebP</option>
                    </select>
                  </div>
                  <div class="option flex items-center justify-between">
                    <label for="compressionLevel" class="text-theme-primary">压缩级别:</label>
                    <select id="compressionLevel" class="bg-div-theme border border-theme-primary rounded px-4 py-2 text-theme-primary cursor-pointer">
                      <option value="0.2">低 (20%)</option>
                      <option value="0.5">中 (50%)</option>
                      <option value="0.8">高 (80%)</option>
                      <option value="1" selected>无损 (100%)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Image Editing -->
              <div class="bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
                <h3 class="text-xl font-semibold text-theme-primary mb-4">图片编辑</h3>
                <div id="editControls" class="space-y-4 opacity-50 pointer-events-none">
                  <p class="text-theme-secondary">请选择一张图片进行编辑</p>
                  <div class="grid grid-cols-2 gap-3">
                    <button id="rotateLeft" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      向左旋转
                    </button>
                    <button id="rotateRight" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V8l-3 3m0 0l-3-3m3 3V8m6 8l3-3m-3 3l3 3m-6-8l3 3"></path>
                      </svg>
                      向右旋转
                    </button>
                    <button id="flipHorizontal" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                      </svg>
                      水平翻转
                    </button>
                    <button id="flipVertical" class="btn-theme px-4 py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 opacity-50">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                      </svg>
                      垂直翻转
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="action-buttons flex flex-wrap gap-4 justify-center mb-8">
            <!-- 非阻塞式临时提示容器 -->
            <div id="notification" class="fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg transform translate-x-full opacity-0 transition-all duration-300 z-50 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span id="notificationMessage">操作成功！</span>
            </div>
            <button id="stitchBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium cursor-pointer transition-all duration-200 hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              合并图片
            </button>
            <button id="resetBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium cursor-pointer transition-all duration-200 hover:shadow-md hover:scale-105 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              重置
            </button>
            <button id="copyBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
              </svg>
              复制图片
            </button>
            <button id="downloadBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
              </svg>
              下载图片
            </button>
            <!-- 方案1：带有向外箭头的窗口图标 -->
            <button id="openNewBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              新窗口打开
            </button>
            <!-- 方案2：带有加号的窗口图标 (备选) -->
            <!-- <button id="openNewBtn" class="btn-theme px-8 py-4 rounded-lg text-lg font-medium opacity-50 pointer-events-none transition-all duration-200 flex items-center justify-center gap-2 min-w-[160px]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-2M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m-6 12h6M12 6v6m0 0v6m0-6h6"></path>
              </svg>
              新窗口打开
            </button> -->
          </div>

          <!-- Preview Section -->
          <div class="preview-section mb-8">
            <h2 class="text-2xl font-semibold text-theme-primary mb-4">预览效果</h2>
            <div class="preview-container bg-theme-secondary rounded-lg p-4 overflow-auto max-h-[600px]">
              <div id="previewArea" class="preview-area min-h-[400px]">
                <div class="empty-preview text-center py-12 text-theme-secondary">
                  上传图片后将在此处显示预览
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/src/scripts/image-stitcher.js"></script>
</Layout>