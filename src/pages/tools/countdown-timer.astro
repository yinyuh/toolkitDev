---
import Layout from "../../layouts/Layout.astro";
import AdSense from "../../components/ads/AdSense.astro";

title: "在线倒计时工具 - 活动考试项目时间管理助手"
description: "免费在线倒计时工具，支持自定义目标日期与时间，实时显示天时分秒，适合考试备考、活动节点、项目上线和生日纪念等场景。"
technologies: "HTML, CSS, JavaScript"
category: "calculator"
order: 100

const pageTitle = "在线倒计时工具 - 活动考试项目时间管理助手";
const pageDescription = "免费在线倒计时工具，支持自定义目标日期与时间，实时显示天时分秒，适合考试备考、活动节点、项目上线和生日纪念等场景。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线倒计时工具",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/countdown-timer",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "自定义目标日期与时间",
        "天时分秒实时倒计时显示",
        "支持目标描述与全屏展示",
        "开始、停止、重置一键控制",
        "适用于活动、考试、上线节点",
        "免费在线，无需注册"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "倒计时可以精确到秒吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "可以。工具会按秒更新显示剩余时间，并同步展示天、小时、分钟和秒数，适合精细化时间管理。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么目标时间必须大于当前时间？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "倒计时本质是计算未来时刻与当前时刻的差值，若目标时间早于当前时间将无法形成有效倒计时，因此系统会提示重新设置。"
          }
        },
        {
          "@type": "Question",
          "name": "全屏模式适合什么场景？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "全屏模式适合会议室大屏、课堂演示、直播活动和冲刺备考场景，能让远距离也清晰看到剩余时间。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用在线倒计时工具",
      "step": [
        {
          "@type": "HowToStep",
          "name": "设置目标日期与时间",
          "text": "选择需要倒计时的目标日期和具体时间，确保时间晚于当前时刻。"
        },
        {
          "@type": "HowToStep",
          "name": "输入目标描述并开始",
          "text": "填写可选描述后点击开始按钮，系统会立即开始按秒倒计时。"
        },
        {
          "@type": "HowToStep",
          "name": "根据需要停止或全屏展示",
          "text": "可随时停止、重置，或开启全屏在大屏场景中清晰展示剩余时间。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">倒计时工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          设置目标时间后实时追踪剩余天时分秒。<span class="text-accent font-semibold">关键节点更可控</span>，适合活动筹备、考试冲刺与项目排期。
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <div class="countdown-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme text-center">
          <div class="countdown-display flex justify-center gap-4 md:gap-8 mb-10 flex-wrap">
            <div class="time-box bg-theme-secondary rounded-lg p-6 min-w-[100px]">
              <div class="time-number text-3xl md:text-4xl font-bold text-blue-500" id="days">00</div>
              <div class="time-label text-theme-primary text-sm mt-2">天</div>
            </div>
            <div class="time-box bg-theme-secondary rounded-lg p-6 min-w-[100px]">
              <div class="time-number text-3xl md:text-4xl font-bold text-blue-500" id="hours">00</div>
              <div class="time-label text-theme-primary text-sm mt-2">时</div>
            </div>
            <div class="time-box bg-theme-secondary rounded-lg p-6 min-w-[100px]">
              <div class="time-number text-3xl md:text-4xl font-bold text-blue-500" id="minutes">00</div>
              <div class="time-label text-theme-primary text-sm mt-2">分</div>
            </div>
            <div class="time-box bg-theme-secondary rounded-lg p-6 min-w-[100px]">
              <div class="time-number text-3xl md:text-4xl font-bold text-blue-500" id="seconds">00</div>
              <div class="time-label text-theme-primary text-sm mt-2">秒</div>
            </div>
          </div>
          
          <div class="input-section mb-8">
            <h2 class="text-xl font-semibold text-theme-primary mb-4">设置倒计时目标时间</h2>
            <div class="flex justify-center flex-wrap gap-4">
              <input type="date" id="targetDate" class="px-4 py-2 bg-theme-secondary border border-theme-border rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-blue-500">
              <input type="time" id="targetTime" class="px-4 py-2 bg-theme-secondary border border-theme-border rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mt-4">
              <label for="targetDescription" class="block text-sm font-medium text-theme-secondary mb-2 text-center">倒计时目标描述</label>
              <input type="text" id="targetDescription" placeholder="输入倒计时目标描述（可选）" class="w-full max-w-md px-4 py-2 bg-theme-secondary border border-theme-border rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-blue-500 mx-auto text-center">
            </div>
          </div>
          
          <div class="controls flex justify-center flex-wrap gap-3">
            <button id="startBtn" class="control-btn start-btn btn-theme px-6 py-3 rounded-lg transition-colors bg-accent text-white hover:bg-accent/90 cursor-pointer">开始</button>
            <button id="stopBtn" class="control-btn stop-btn btn-theme px-6 py-3 rounded-lg transition-colors bg-gray-500 text-white hover:bg-gray-600 cursor-pointer" disabled>停止</button>
            <button id="resetBtn" class="control-btn reset-btn btn-theme px-6 py-3 rounded-lg transition-colors bg-gray-500 text-white hover:bg-gray-600 cursor-pointer">重置</button>
            <button id="fullscreenBtn" class="control-btn fullscreen-btn btn-theme px-6 py-3 rounded-lg transition-colors bg-accent text-white hover:bg-accent/90 cursor-pointer">全屏显示</button>
          </div>
          
          <!-- 全屏显示模态框 -->
          <div id="fullscreenModal" class="fixed inset-0 bg-theme-primary bg-opacity-95 z-50 flex items-center justify-center hidden">
            <button id="exitFullscreenBtn" class="fixed top-4 right-4 text-theme-primary text-2xl hover:text-theme-secondary transition-colors z-10">
              ×
            </button>
            <div class="w-full max-w-6xl p-8">
              <div class="text-center">
                <div id="fullscreenDescription" class="text-2xl md:text-4xl font-bold text-theme-primary mb-8"></div>
                <div class="countdown-display flex justify-center gap-6 md:gap-12 mb-8 flex-wrap">
                  <div class="time-box bg-theme-secondary rounded-lg p-8 min-w-[120px]">
                    <div class="time-number text-4xl md:text-6xl font-bold text-accent" id="fullscreenDays">00</div>
                    <div class="time-label text-theme-primary text-sm mt-2">天</div>
                  </div>
                  <div class="time-box bg-theme-secondary rounded-lg p-8 min-w-[120px]">
                    <div class="time-number text-4xl md:text-6xl font-bold text-accent" id="fullscreenHours">00</div>
                    <div class="time-label text-theme-primary text-sm mt-2">时</div>
                  </div>
                  <div class="time-box bg-theme-secondary rounded-lg p-8 min-w-[120px]">
                    <div class="time-number text-4xl md:text-6xl font-bold text-accent" id="fullscreenMinutes">00</div>
                    <div class="time-label text-theme-primary text-sm mt-2">分</div>
                  </div>
                  <div class="time-box bg-theme-secondary rounded-lg p-8 min-w-[120px]">
                    <div class="time-number text-4xl md:text-6xl font-bold text-accent" id="fullscreenSeconds">00</div>
                    <div class="time-label text-theme-primary text-sm mt-2">秒</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div id="message" class="text-div-theme mt-6 text-lg font-medium"></div>
        </div>
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么要使用在线倒计时工具？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              无论是考试备考、活动开场、产品发布还是个人目标管理，清晰可见的剩余时间都会显著提升执行力。相比普通日历提醒，倒计时更直观，能持续强化“时间在流逝”的紧迫感。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 在线倒计时工具</strong> 支持自定义目标时刻、按秒更新与全屏展示，让你在个人专注和团队协作场景中都能更高效地管理关键节点，减少拖延与遗漏。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">⏱️</div>
                <h3 class="text-xl font-semibold mb-2">秒级实时更新</h3>
                <p class="text-theme-secondary">天、时、分、秒同步倒计时，时间进度一目了然。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🗓️</div>
                <h3 class="text-xl font-semibold mb-2">目标时间自定义</h3>
                <p class="text-theme-secondary">支持自由设置日期和时间，覆盖学习、工作与生活多场景。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🖥️</div>
                <h3 class="text-xl font-semibold mb-2">全屏大字展示</h3>
                <p class="text-theme-secondary">适合教室、会议室、直播间等大屏场景，远距离也易读。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🎯</div>
                <h3 class="text-xl font-semibold mb-2">过程控制灵活</h3>
                <p class="text-theme-secondary">支持开始、停止、重置，随时根据实际进度调整节奏。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步开启倒计时</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">设置目标时间</h3>
                  <p class="text-theme-secondary">选择日期和具体时刻，确保目标晚于当前时间。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">填写描述并开始</h3>
                  <p class="text-theme-secondary">可填写目标名称，点击开始后系统立即进入倒计时状态。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">按需全屏或重置</h3>
                  <p class="text-theme-secondary">需要展示时可切换全屏，结束后可停止或重置开始下一轮。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>倒计时结束后会发生什么？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  系统会自动停止计时并显示“倒计时结束”，同时恢复按钮状态，方便你重新设置下一个目标。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>支持多个倒计时同时运行吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  当前页面一次仅运行一个倒计时任务。如需多个节点管理，建议分时设置或在不同标签页分别运行。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>刷新页面后倒计时会保留吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  刷新后会回到初始状态，建议在关键场景保持页面常驻，或将目标时间记录备用以便快速重设。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关效率工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/timestamp-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">时间戳转换工具</div>
                  <div class="text-xs text-theme-secondary">Unix 时间与日期双向转换</div>
                </a>
              </li>
              <li>
                <a href="/tools/cron-generator" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">Cron 表达式生成器</div>
                  <div class="text-xs text-theme-secondary">可视化配置定时任务规则</div>
                </a>
              </li>
              <li>
                <a href="/tools/text-counter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">文本字数统计工具</div>
                  <div class="text-xs text-theme-secondary">实时统计字数、词数和段落</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    let countdownInterval;
    let targetDate;
    let targetDescription = '';

    document.getElementById('startBtn').addEventListener('click', startCountdown);
    document.getElementById('stopBtn').addEventListener('click', stopCountdown);
    document.getElementById('resetBtn').addEventListener('click', resetCountdown);
    document.getElementById('fullscreenBtn').addEventListener('click', toggleFullscreen);
    document.getElementById('exitFullscreenBtn').addEventListener('click', toggleFullscreen);
    
    // 监听ESC键退出全屏
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('fullscreenModal');
            if (!modal.classList.contains('hidden')) {
                toggleFullscreen();
            }
        }
    });

    // 设置默认目标时间为24小时后
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    document.getElementById('targetDate').value = tomorrow.toISOString().split('T')[0];
    document.getElementById('targetTime').value = tomorrow.toTimeString().split(' ')[0];

    function startCountdown() {
        const date = document.getElementById('targetDate').value;
        const time = document.getElementById('targetTime').value;
        targetDescription = document.getElementById('targetDescription').value;

        if (!date || !time) {
            alert('请选择目标日期和时间！');
            return;
        }

        targetDate = new Date(`${date}T${time}`);
        const now = new Date();

        if (targetDate <= now) {
            alert('目标时间必须大于当前时间！');
            return;
        }

        // 禁用开始按钮，启用停止按钮
        document.getElementById('startBtn').disabled = true;
        document.getElementById('stopBtn').disabled = false;

        // 开始倒计时
        updateCountdown();
        countdownInterval = setInterval(updateCountdown, 1000);
    }
    
    // 监听目标描述输入变化
    document.getElementById('targetDescription').addEventListener('input', function() {
        targetDescription = this.value;
    });

    function stopCountdown() {
        clearInterval(countdownInterval);
        document.getElementById('startBtn').disabled = false;
        document.getElementById('stopBtn').disabled = true;
    }

    function resetCountdown() {
        clearInterval(countdownInterval);
        
        // 重置显示
        document.getElementById('days').textContent = '00';
        document.getElementById('hours').textContent = '00';
        document.getElementById('minutes').textContent = '00';
        document.getElementById('seconds').textContent = '00';
        document.getElementById('message').textContent = '';
        document.getElementById('targetDescription').value = '';
        targetDescription = '';
        
        // 重置按钮状态
        document.getElementById('startBtn').disabled = false;
        document.getElementById('stopBtn').disabled = true;
    }

    function updateCountdown() {
        const now = new Date();
        const difference = targetDate - now;

        if (difference <= 0) {
            clearInterval(countdownInterval);
            document.getElementById('message').textContent = '倒计时结束！';
            document.getElementById('startBtn').disabled = false;
            document.getElementById('stopBtn').disabled = true;
            updateFullscreenDisplay('00', '00', '00', '00');
            return;
        }

        // 计算天、时、分、秒
        const days = Math.floor(difference / (1000 * 60 * 60 * 24));
        const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((difference % (1000 * 60)) / 1000);

        // 更新显示
        document.getElementById('days').textContent = padNumber(days);
        document.getElementById('hours').textContent = padNumber(hours);
        document.getElementById('minutes').textContent = padNumber(minutes);
        document.getElementById('seconds').textContent = padNumber(seconds);

        // 更新全屏显示
        updateFullscreenDisplay(padNumber(days), padNumber(hours), padNumber(minutes), padNumber(seconds));
    }

    function updateFullscreenDisplay(days, hours, minutes, seconds) {
        document.getElementById('fullscreenDays').textContent = days;
        document.getElementById('fullscreenHours').textContent = hours;
        document.getElementById('fullscreenMinutes').textContent = minutes;
        document.getElementById('fullscreenSeconds').textContent = seconds;
    }

    function toggleFullscreen() {
        const modal = document.getElementById('fullscreenModal');
        const description = document.getElementById('fullscreenDescription');
        
        // 设置全屏描述（每次都获取最新值）
        const currentDescription = document.getElementById('targetDescription').value;
        description.textContent = currentDescription || targetDescription || '倒计时';
        
        // 显示或隐藏全屏模态框
        if (modal.classList.contains('hidden')) {
            modal.classList.remove('hidden');
            // 如果倒计时正在运行，更新全屏显示
            if (targetDate) {
                const now = new Date();
                const difference = targetDate - now;
                if (difference > 0) {
                    const days = Math.floor(difference / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((difference % (1000 * 60)) / 1000);
                    updateFullscreenDisplay(padNumber(days), padNumber(hours), padNumber(minutes), padNumber(seconds));
                }
            }
        } else {
            modal.classList.add('hidden');
        }
    }

    function padNumber(number) {
        return number < 10 ? `0${number}` : number;
    }
  </script>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
