---
import Layout from "../../layouts/Layout.astro";
import { ref, computed, watch } from "vue";
import { onMounted } from "vue";

// 页面元数据
title: "HTML转Markdown工具"
description: "免费在线HTML转Markdown工具，支持表格、代码块等复杂格式转换"
technologies: "HTML, CSS, JavaScript, Vue"
category: "tool"
order: -1
---

<Layout title="HTML转Markdown工具" description="免费在线HTML转Markdown工具，支持表格、代码块等复杂格式转换">
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">HTML转Markdown工具</h1>
        <p class="text-theme-secondary max-w-3xl mx-auto">
          免费在线HTML转Markdown工具，支持表格、代码块等复杂格式转换
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-5xl mx-auto bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
        <!-- Toast Notification -->
        <div id="toast-notification" class="toast-notification" style="display: none;"></div>

        <div class="toolbar mb-8">
          <div class="header-actions mb-6">
            <!-- 返回首页按钮已移除 -->
          </div>
          
          <div class="controls flex flex-wrap gap-3 items-center">
            <button id="convert-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors" disabled>
              手动转换
            </button>
            <button id="clear-input-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              清空输入
            </button>
            <button id="clear-output-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              清空输出
            </button>
            <button id="clear-all-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              清空全部
            </button>
            <button id="load-example-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              加载示例
            </button>
            
            <label class="flex items-center gap-2">
              <input type="checkbox" id="realtime-mode" checked> 实时转换
            </label>
            
            <label class="flex items-center gap-2">
              <input type="checkbox" id="show-preview" checked> 显示预览
            </label>
            
            <label class="flex items-center gap-2">
              字体大小: 
              <input type="range" id="font-size" min="10" max="24" step="1" value="14">
              <span id="font-size-value">14px</span>
            </label>
          </div>
        </div>

        <div class="main-content flex flex-col md:flex-row gap-8 mb-8">
          <div class="input-section flex-1 flex flex-col">
            <div class="section-header flex justify-between items-center mb-4">
              <h2 class="text-xl font-bold text-theme-primary">HTML输入</h2>
              <div class="flex items-center gap-3">
                <div class="stats text-theme-secondary text-sm">
                  行数: <span id="input-lines">0</span> | 字符数: <span id="input-chars">0</span>
                </div>
                <div class="w-20 h-8 flex items-center justify-center"></div>
              </div>
            </div>
            <textarea 
              id="html-input" 
              class="w-full flex-1 min-h-[300px] p-4 border border-theme-border rounded-lg resize-vertical font-mono"
              placeholder="在此粘贴HTML代码..."
              style="font-size: 14px; min-height: 300px;"
            ></textarea>
          </div>

          <div class="output-section flex-1 flex flex-col">
            <div class="section-header flex justify-between items-center mb-4">
              <h2 class="text-xl font-bold text-theme-primary">Markdown输出</h2>
              <div class="flex items-center gap-3">
                <div class="stats text-theme-secondary text-sm">
                  行数: <span id="output-lines">0</span> | 字符数: <span id="output-chars">0</span>
                </div>
                <button id="copy-output-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
                  复制
                </button>
              </div>
            </div>
            <textarea 
              id="markdown-output" 
              class="w-full flex-1 min-h-[300px] p-4 border border-theme-border rounded-lg resize-vertical font-mono bg-theme-secondary"
              placeholder="转换结果将显示在这里..."
              readonly
              style="font-size: 14px; min-height: 300px;"
            ></textarea>
          </div>
        </div>

        <!-- Markdown 预览窗口 -->
        <div id="preview-section" class="preview-section mb-8">
          <div class="section-header flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold text-theme-primary">Markdown 预览</h2>
          </div>
          <div 
            id="preview-content" 
            class="preview-content p-4 border border-theme-border rounded-lg min-h-[200px] bg-theme-secondary"
            style="font-size: 14px;"
          ></div>
        </div>

      </div>
    </div>
  </section>

  <!-- HTML转Markdown工具 -->
  <script>
    // 页面加载完成后执行
    document.addEventListener('DOMContentLoaded', () => {
      // 获取DOM元素
      const htmlInput = document.getElementById('html-input');
      const markdownOutput = document.getElementById('markdown-output');
      const previewContent = document.getElementById('preview-content');
      const startBtn = document.getElementById('convert-btn');
      const clearInputBtn = document.getElementById('clear-input-btn');
      const clearOutputBtn = document.getElementById('clear-output-btn');
      const clearAllBtn = document.getElementById('clear-all-btn');
      const loadExampleBtn = document.getElementById('load-example-btn');
      const realtimeMode = document.getElementById('realtime-mode');
      const showPreview = document.getElementById('show-preview');
      const fontSizeSlider = document.getElementById('font-size');
      const fontSizeValue = document.getElementById('font-size-value');
      const previewSection = document.getElementById('preview-section');
      const copyOutputBtn = document.getElementById('copy-output-btn');
      const toastNotification = document.getElementById('toast-notification');
      const inputLines = document.getElementById('input-lines');
      const inputChars = document.getElementById('input-chars');
      const outputLines = document.getElementById('output-lines');
      const outputChars = document.getElementById('output-chars');

      // 增强版Markdown解析器，支持完整的Markdown语法
      function markdownToHtml(markdown) {
        console.log('Input markdown:', markdown);
        
        // 先处理空白行，保留它们用于分割元素
        let lines = markdown.split('\n');
        let html = '';
        
        let i = 0;
        while (i < lines.length) {
          let line = lines[i];
          
          // 处理空白行
          if (line.trim() === '') {
            html += '\n';
            i++;
            continue;
          }
          
          // 处理分割线
          if (line.match(/^\s*([*\-_])\s*(?:\1\s*){2,}\s*$/)) {
            html += '<hr style="border: 0; height: 1px; background: var(--border-color); margin: 1em 0; width: 100%;">\n';
            i++;
            continue;
          }
          
          // 处理标题
          if (line.match(/^\s*(\#{1,6})\s+(.*)$/)) {
            const match = line.match(/^\s*(\#{1,6})\s+(.*)$/);
            const level = match[1].length;
            const text = match[2];
            let fontSize = '';
            let margin = '';
            
            switch(level) {
              case 1:
                fontSize = '2em';
                margin = '0.67em 0';
                break;
              case 2:
                fontSize = '1.5em';
                margin = '0.83em 0';
                break;
              case 3:
                fontSize = '1.17em';
                margin = '1em 0';
                break;
              case 4:
                fontSize = '1em';
                margin = '1.33em 0';
                break;
              case 5:
                fontSize = '0.83em';
                margin = '1.67em 0';
                break;
              case 6:
                fontSize = '0.67em';
                margin = '2.33em 0';
                break;
            }
            
            html += `<h${level} style="font-size: ${fontSize}; font-weight: bold; margin: ${margin}; color: var(--text-primary);">${text}</h${level}>\n`;
            i++;
            continue;
          }
          
          // 处理代码块
          if (line.match(/^\s*```/)) {
            let codeBlock = '';
            i++;
            while (i < lines.length && !lines[i].match(/^\s*```/)) {
              codeBlock += lines[i] + '\n';
              i++;
            }
            if (i < lines.length) {
              i++;
            }
            html += `<pre style="background-color: var(--bg-secondary); padding: 10px; border-radius: 5px; overflow-x: auto; margin: 1em 0; border: 1px solid var(--border-color);"><code style="font-family: 'Consolas', 'Courier New', monospace; color: var(--text-primary);">${codeBlock}</code></pre>\n`;
            continue;
          }
          
          // 处理表格
          if (line.match(/^\s*\|/)) {
            let tableLines = [line];
            i++;
            while (i < lines.length && lines[i].match(/^\s*\|/)) {
              tableLines.push(lines[i]);
              i++;
            }
            
            let tableHtml = '<table style="width: 100%; border-collapse: collapse; margin: 1em 0;"><tbody>';
            tableLines.forEach((row, index) => {
              // 跳过分隔行
              if (row.match(/^\s*\|\s*---\s*\|/)) {
                return;
              }
              let cells = row.replace(/^\s*\||\|\s*$/g, '').split('|').map(cell => cell.trim());
              tableHtml += '<tr>';
              cells.forEach((cell) => {
                if (index === 0) {
                  tableHtml += `<th style="padding: 10px; border: 1px solid var(--border-color); text-align: left; font-weight: bold; background-color: var(--bg-secondary); color: var(--text-primary);">${cell}</th>`;
                } else {
                  tableHtml += `<td style="padding: 10px; border: 1px solid var(--border-color); text-align: left; color: var(--text-primary);">${cell}</td>`;
                }
              });
              tableHtml += '</tr>';
            });
            tableHtml += '</tbody></table>\n';
            html += tableHtml;
            continue;
          }
          
          // 处理无序列表
          if (line.match(/^\s*([\-\*])\s+/)) {
            let listItems = [];
            while (i < lines.length && lines[i].match(/^\s*([\-\*])\s+/)) {
              const match = lines[i].match(/^\s*([\-\*])\s+(.*)$/);
              // 处理列表项中的加粗语法
              let listItemContent = match[2];
              listItemContent = listItemContent.replace(/\*\*(.*?)\*\*/g, '<strong style="font-weight: bold;">$1</strong>');
              listItemContent = listItemContent.replace(/\_\_(.*?)\_\_/g, '<strong style="font-weight: bold;">$1</strong>');
              // 处理列表项中的链接
              listItemContent = listItemContent.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" style="color: var(--link-color); text-decoration: none;">$1</a>');
              listItems.push(`<li style="margin-bottom: 0.25rem;">${listItemContent}</li>`);
              i++;
              // 跳过可能的空白行
              while (i < lines.length && lines[i].trim() === '') {
                i++;
              }
            }
            if (listItems.length > 0) {
              html += '<ul style="margin: 0 0 1rem 0; padding-left: 2rem; list-style-type: disc; color: var(--text-primary);">' + listItems.join('') + '</ul>\n';
            }
            continue;
          }
          
          // 处理有序列表
          if (line.match(/^\s*(\d+)\.\s+/)) {
            let listItems = [];
            while (i < lines.length && lines[i].match(/^\s*(\d+)\.\s+/)) {
              const match = lines[i].match(/^\s*(\d+)\.\s+(.*)$/);
              // 处理列表项中的加粗语法
              let listItemContent = match[2];
              listItemContent = listItemContent.replace(/\*\*(.*?)\*\*/g, '<strong style="font-weight: bold;">$1</strong>');
              listItemContent = listItemContent.replace(/\_\_(.*?)\_\_/g, '<strong style="font-weight: bold;">$1</strong>');
              // 处理列表项中的链接
              listItemContent = listItemContent.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" style="color: var(--link-color); text-decoration: none;">$1</a>');
              listItems.push(`<li style="margin-bottom: 0.25rem;">${listItemContent}</li>`);
              i++;
              // 跳过可能的空白行
              while (i < lines.length && lines[i].trim() === '') {
                i++;
              }
            }
            if (listItems.length > 0) {
              html += '<ol style="margin: 0 0 1rem 0; padding-left: 2rem; list-style-type: decimal; color: var(--text-primary);">' + listItems.join('') + '</ol>\n';
            }
            continue;
          }
          
          // 处理引用块
          if (line.match(/^\s*>\s+/)) {
            let quoteItems = [];
            while (i < lines.length && lines[i].match(/^\s*>\s+/)) {
              const match = lines[i].match(/^\s*>\s+(.*)$/);
              // 处理引用项中的加粗语法
              let quoteContent = match[1];
              quoteContent = quoteContent.replace(/\*\*(.*?)\*\*/g, '<strong style="font-weight: bold;">$1</strong>');
              quoteContent = quoteContent.replace(/\_\_(.*?)\_\_/g, '<strong style="font-weight: bold;">$1</strong>');
              // 处理引用项中的链接
              quoteContent = quoteContent.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" style="color: var(--link-color); text-decoration: none;">$1</a>');
              quoteItems.push(quoteContent);
              i++;
              // 跳过可能的空白行
              while (i < lines.length && lines[i].trim() === '') {
                i++;
              }
            }
            if (quoteItems.length > 0) {
              html += '<blockquote style="margin: 0 0 1rem; padding: 0.5rem 1rem; border-left: 4px solid var(--accent-color); background-color: var(--bg-secondary); color: var(--text-secondary);">';
              quoteItems.forEach(quoteItem => {
                html += `<p style="margin: 0 0 0.5rem 0; color: var(--text-secondary);">${quoteItem}</p>`;
              });
              html += '</blockquote>\n';
            }
            continue;
          }
          
          // 处理导航链接（包含箭头符号的链接）
          if (line.match(/^[←→]/)) {
            // 处理导航链接行
            let navLine = line;
            
            // 处理链接（确保链接正确显示）
            navLine = navLine.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" style="color: var(--link-color); text-decoration: none;">$1</a>');
            
            // 添加导航样式
            html += `<div style="margin: 1rem 0; color: var(--text-primary);">${navLine}</div>\n`;
            i++;
            continue;
          }
          
          // 处理普通段落
          let paragraph = line;
          
          // 处理段落中的加粗语法
          paragraph = paragraph.replace(/\*\*(.*?)\*\*/g, '<strong style="font-weight: bold;">$1</strong>');
          paragraph = paragraph.replace(/\_\_(.*?)\_\_/g, '<strong style="font-weight: bold;">$1</strong>');
          
          // 处理段落中的图片
          paragraph = paragraph.replace(/!\[(.*?)\]\((.*?)\)/g, '<img src="$2" alt="$1" style="max-width: 100%; height: auto;" onerror="this.src=\'data:image/svg+xml;base64,\'; this.onerror=null;">');
          
          // 处理段落中的链接
          paragraph = paragraph.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" style="color: var(--link-color); text-decoration: none;">$1</a>');
          
          // 为普通段落添加样式
          html += `<p style="margin: 0 0 1rem 0; color: var(--text-primary);">${paragraph}</p>\n`;
          i++;
        }
        
        console.log('Output html:', html);
        return html;
      }

      /**
       * 全新的HTML转Markdown转换函数
       * 使用DOM解析方式处理HTML，支持复杂的嵌套结构和代码块
       * @param {string} html - 输入的HTML字符串
       * @returns {string} - 转换后的Markdown字符串
       */
      function htmlToMarkdown(html) {
        try {
          // 创建临时DOM元素用于解析HTML
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = html;
          
          // 预处理：移除不需要转换的标签
          removeUnwantedTags(tempDiv);
          
          // 开始转换
          const markdown = convertNodeToMarkdown(tempDiv);
          
          // 后处理：清理和优化Markdown
          return postProcessMarkdown(markdown);
        } catch (error) {
          console.error('HTML转Markdown错误:', error);
          // 错误处理：返回原始HTML的简单转换
          return simpleHtmlToMarkdown(html);
        }
      }
      
      /**
       * 移除不需要转换的标签
       * @param {HTMLElement} node - DOM节点
       */
      function removeUnwantedTags(node) {
        const unwantedTags = ['script', 'style'];
        unwantedTags.forEach(tagName => {
          const elements = node.querySelectorAll(tagName);
          elements.forEach(el => el.remove());
        });
        
        // 移除注释
        const comments = node.querySelectorAll('comment');
        comments.forEach(comment => comment.remove());
      }
      
      /**
       * 将DOM节点转换为Markdown
       * @param {Node} node - DOM节点
       * @param {number} indent - 缩进级别
       * @returns {string} - 转换后的Markdown
       */
      function convertNodeToMarkdown(node, indent = 0) {
        let markdown = '';
        const indentStr = '  '.repeat(indent);
        
        if (node.nodeType === Node.TEXT_NODE) {
          // 处理文本节点
          const text = node.textContent || '';
          if (text.trim()) {
            markdown += indentStr + text;
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          // 处理元素节点
          const tagName = node.tagName.toLowerCase();
          
          switch (tagName) {
            case 'h1':
            case 'h2':
            case 'h3':
            case 'h4':
            case 'h5':
            case 'h6':
              // 处理标题
              const level = parseInt(tagName.charAt(1));
              const headingPrefix = '#'.repeat(level) + ' ';
              // 获取标题文本，忽略锚点链接和空白
              let headingText = getNodeText(node);
              // 清理标题文本，移除前后空白和注释
              headingText = headingText.replace(/<!---->/g, '').trim();
              markdown += '\n\n' + headingPrefix + headingText + '\n\n';
              break;
              
            case 'p':
              // 处理段落
              const paragraphContent = processChildren(node, 0);
              if (paragraphContent.trim()) {
                // 检查父节点是否为li标签，如果是则不添加额外的换行符
                const parentTagName = node.parentElement ? node.parentElement.tagName.toLowerCase() : '';
                if (parentTagName === 'li') {
                  markdown += paragraphContent;
                } else {
                  markdown += '\n\n' + paragraphContent + '\n\n';
                }
              }
              break;
              
            case 'strong':
            case 'b':
              // 处理粗体
              markdown += '**' + processChildren(node, 0) + '**';
              break;
              
            case 'em':
            case 'i':
              // 处理斜体
              markdown += '*' + processChildren(node, 0) + '*';
              break;
              
            case 'ul':
              // 处理无序列表
              markdown += '\n\n';
              const ulChildren = Array.from(node.children);
              ulChildren.forEach((child, index) => {
                if (child.tagName.toLowerCase() === 'li') {
                  markdown += indentStr + '* ' + processChildren(child, indent + 1) + '\n';
                }
              });
              markdown += '\n';
              break;
              
            case 'ol':
              // 处理有序列表
              markdown += '\n\n';
              const olChildren = Array.from(node.children);
              olChildren.forEach((child, index) => {
                if (child.tagName.toLowerCase() === 'li') {
                  markdown += indentStr + (index + 1) + '. ' + processChildren(child, indent + 1) + '\n';
                }
              });
              markdown += '\n';
              break;
              
            case 'a':
              // 处理链接
              const linkHref = node.getAttribute('href');
              let linkContent = getNodeText(node);
              // 清理链接文本，移除前后空白和注释
              linkContent = linkContent.replace(/<!---->/g, '').trim();
              if (linkHref) {
                markdown += '[' + linkContent + '](' + linkHref + ')';
              } else {
                markdown += linkContent;
              }
              break;
              
            case 'img':
              // 处理图片
              const src = node.getAttribute('src');
              if (src) {
                // 使用简洁的图片格式，不包含alt文本
                markdown += '![](' + src + ')';
              }
              break;
              
            case 'pre':
              // 处理代码块
              const codeElement = node.querySelector('code');
              if (codeElement) {
                // 直接获取代码内容，保留原始缩进
                const codeContent = codeElement.textContent || '';
                // 获取代码语言
                let language = 'plaintext';
                
                // 从class中提取语言信息
                const classList = codeElement.className;
                if (classList) {
                  // 尝试匹配language-前缀的语言标识
                  let langMatch = classList.match(/language-([a-z0-9]+)/i);
                  if (langMatch && langMatch[1]) {
                    language = langMatch[1];
                  } else {
                    // 尝试匹配prism-前缀的语言标识
                    langMatch = classList.match(/prism-([a-z0-9]+)/i);
                    if (langMatch && langMatch[1]) {
                      language = langMatch[1];
                    } else {
                      // 尝试从相邻的code-language元素中获取语言信息
                      const codeLanguageElement = node.querySelector('.code-language');
                      if (codeLanguageElement) {
                        const langText = codeLanguageElement.textContent || '';
                        if (langText.trim()) {
                          language = langText.trim();
                        }
                      }
                    }
                  }
                }
                
                // 生成Markdown代码块，确保保留原始缩进
                markdown += '\n\n```' + language + '\n' + codeContent + '\n```\n\n';
              }
              break;
              
            case 'code':
              // 处理行内代码
              const inlineCode = node.textContent || '';
              markdown += '`' + inlineCode + '`';
              break;
              
            case 'blockquote':
              // 处理引用
              const quoteContent = processChildren(node, 0);
              if (quoteContent.trim()) {
                const quoteLines = quoteContent.split('\n');
                markdown += '\n\n';
                quoteLines.forEach(line => {
                  if (line.trim()) {
                    markdown += '> ' + line + '\n';
                  }
                });
                markdown += '\n';
              }
              break;
              
            case 'br':
              // 处理换行
              markdown += '\n';
              break;
              
            case 'hr':
              // 处理水平分隔线
              markdown += '\n\n* * *\n\n';
              break;
              
            case 'table':
              // 处理表格
              markdown += processTable(node);
              break;
              
            case 'div':
              // 处理div标签，根据class进行特殊处理
              const divClass = node.getAttribute('class');
              if (divClass && divClass.includes('pagination')) {
                // 处理分页导航
                markdown += '\n\n';
                const paginationLinks = node.querySelectorAll('a');
                if (paginationLinks.length > 0) {
                  // 处理上一篇链接
                  const prevLink = paginationLinks[0];
                  if (prevLink) {
                    const prevHref = prevLink.getAttribute('href');
                    const prevText = prevLink.textContent || '';
                    if (prevHref) {
                      markdown += '[' + prevText + '](' + prevHref + ') ';
                    }
                  }
                  // 处理下一篇链接
                  const nextLink = paginationLinks[1];
                  if (nextLink) {
                    const nextHref = nextLink.getAttribute('href');
                    const nextText = nextLink.textContent || '';
                    if (nextHref) {
                      markdown += '[' + nextText + '](' + nextHref + ')';
                    }
                  }
                }
                markdown += '\n\n';
              } else if (divClass && (divClass.includes('article-meta') || divClass.includes('meta'))) {
                // 处理文章元信息
                markdown += '\n\n';
                const metaLinks = node.querySelectorAll('a');
                metaLinks.forEach(link => {
                  const metaHref = link.getAttribute('href');
                  const metaText = link.textContent || '';
                  if (metaHref) {
                    markdown += '* [' + metaText + '](' + metaHref + ')\n';
                  }
                });
                markdown += '\n';
              } else if (divClass && (divClass.includes('adsbygoogle') || divClass.includes('giscus'))) {
                // 跳过广告和评论区
                markdown += '\n\n' + '(adsbygoogle = window.adsbygoogle || []).push({});\n\n';
              } else {
                // 普通div标签，只转换内容
                markdown += processChildren(node, indent);
              }
              break;
              
            case 'section':
            case 'article':
            case 'main':
            case 'header':
            case 'footer':
            case 'nav':
            case 'span':
              // 处理容器标签，只转换内容
              markdown += processChildren(node, indent);
              break;
              
            default:
              // 处理其他标签，只转换内容
              markdown += processChildren(node, indent);
          }
        }
        
        return markdown;
      }
      
      /**
       * 处理节点的子节点
       * @param {Node} node - DOM节点
       * @param {number} indent - 缩进级别
       * @returns {string} - 处理后的内容
       */
      function processChildren(node, indent) {
        let result = '';
        const children = Array.from(node.childNodes);
        
        children.forEach(child => {
          result += convertNodeToMarkdown(child, indent);
        });
        
        return result;
      }
      
      /**
       * 获取节点的文本内容
       * @param {Node} node - DOM节点
       * @returns {string} - 文本内容
       */
      function getNodeText(node) {
        return node.textContent || '';
      }
      
      /**
       * 处理表格
       * @param {HTMLElement} tableNode - 表格节点
       * @returns {string} - 转换后的Markdown表格
       */
      function processTable(tableNode) {
        let markdown = '\n\n';
        
        const thead = tableNode.querySelector('thead');
        const tbody = tableNode.querySelector('tbody');
        
        // 处理表头
        if (thead) {
          const headerRow = thead.querySelector('tr');
          if (headerRow) {
            const headerCells = Array.from(headerRow.children);
            const headerTexts = headerCells.map(cell => cell.textContent || '');
            markdown += '| ' + headerTexts.join(' | ') + ' |\n';
            markdown += '| ' + headerTexts.map(() => '---').join(' | ') + ' |\n';
          }
        }
        
        // 处理表格体
        if (tbody) {
          const rows = Array.from(tbody.children);
          rows.forEach(row => {
            if (row.tagName.toLowerCase() === 'tr') {
              const cells = Array.from(row.children);
              const cellTexts = cells.map(cell => cell.textContent || '');
              markdown += '| ' + cellTexts.join(' | ') + ' |\n';
            }
          });
        }
        
        markdown += '\n';
        return markdown;
      }
      
      /**
       * 后处理Markdown，清理和优化
       * @param {string} markdown - 转换后的Markdown
       * @returns {string} - 优化后的Markdown
       */
      function postProcessMarkdown(markdown) {
        // 移除多余的空白行
        markdown = markdown.replace(/\n{3,}/g, '\n\n');
        
        // 保留代码块中的缩进，只处理非代码块部分
        let result = '';
        let inCodeBlock = false;
        let codeLanguage = '';
        
        const lines = markdown.split('\n');
        lines.forEach(line => {
          if (line.startsWith('```')) {
            // 代码块开始或结束
            inCodeBlock = !inCodeBlock;
            if (inCodeBlock) {
              // 代码块开始，提取语言
              codeLanguage = line.substring(3).trim();
            }
            result += line + '\n';
          } else if (inCodeBlock) {
            // 代码块内部，保留原始缩进
            result += line + '\n';
          } else {
            // 非代码块部分，移除行首空白
            result += line.replace(/^\s+/, '') + '\n';
          }
        });
        
        return result.trim();
      }
      
      /**
       * 简单的HTML转Markdown函数（作为备份）
       * @param {string} html - 输入的HTML字符串
       * @returns {string} - 转换后的Markdown
       */
      function simpleHtmlToMarkdown(html) {
        let markdown = html;
        
        // 预处理 HTML，移除不需要转换的标签
        markdown = markdown.replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '');
        markdown = markdown.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '');
        markdown = markdown.replace(/<!--[\s\S]*?-->/g, '');
        
        // 处理容器标签（移除标签但保留内容）
        markdown = markdown.replace(/<div[^>]*>([\s\S]*?)<\/div>/g, '$1');
        markdown = markdown.replace(/<section[^>]*>([\s\S]*?)<\/section>/g, '$1');
        markdown = markdown.replace(/<article[^>]*>([\s\S]*?)<\/article>/g, '$1');
        markdown = markdown.replace(/<main[^>]*>([\s\S]*?)<\/main>/g, '$1');
        markdown = markdown.replace(/<header[^>]*>([\s\S]*?)<\/header>/g, '$1');
        markdown = markdown.replace(/<footer[^>]*>([\s\S]*?)<\/footer>/g, '$1');
        markdown = markdown.replace(/<nav[^>]*>([\s\S]*?)<\/nav>/g, '$1');
        
        // 处理标题
        markdown = markdown.replace(/<h1[^>]*>(.*?)<\/h1>/g, '# $1\n\n');
        markdown = markdown.replace(/<h2[^>]*>(.*?)<\/h2>/g, '## $1\n\n');
        markdown = markdown.replace(/<h3[^>]*>(.*?)<\/h3>/g, '### $1\n\n');
        markdown = markdown.replace(/<h4[^>]*>(.*?)<\/h4>/g, '#### $1\n\n');
        markdown = markdown.replace(/<h5[^>]*>(.*?)<\/h5>/g, '##### $1\n\n');
        markdown = markdown.replace(/<h6[^>]*>(.*?)<\/h6>/g, '###### $1\n\n');
        
        // 处理段落
        markdown = markdown.replace(/<p[^>]*>(.*?)<\/p>/g, '$1\n\n');
        
        // 处理粗体和斜体
        markdown = markdown.replace(/<strong[^>]*>(.*?)<\/strong>/g, '**$1**');
        markdown = markdown.replace(/<b[^>]*>(.*?)<\/b>/g, '**$1**');
        markdown = markdown.replace(/<em[^>]*>(.*?)<\/em>/g, '*$1*');
        markdown = markdown.replace(/<i[^>]*>(.*?)<\/i>/g, '*$1*');
        
        // 处理列表
        markdown = markdown.replace(/<ul[^>]*>([\s\S]*?)<\/ul>/g, (match, content) => {
          return content.replace(/<li[^>]*>(.*?)<\/li>/g, '- $1\n') + '\n';
        });
        
        markdown = markdown.replace(/<ol[^>]*>([\s\S]*?)<\/ol>/g, (match, content) => {
          let index = 1;
          return content.replace(/<li[^>]*>(.*?)<\/li>/g, (match, liContent) => `${index++}. ${liContent}\n`) + '\n';
        });
        
        // 处理链接
        markdown = markdown.replace(/<a[^>]*href="([^"]*)"[^>]*>([\s\S]*?)<\/a>/g, (match, href, content) => {
          const cleanContent = content.replace(/<[^>]*>/g, '').trim();
          const cleanHref = href.replace(/[`]/g, '').trim();
          return `[${cleanContent}](${cleanHref})`;
        });
        
        // 处理图片
        markdown = markdown.replace(/<img[^>]*src="([^"]*)"[^>]*alt="([^"]*)"[^>]*\/?>/g, '![$2]($1)');
        markdown = markdown.replace(/<img[^>]*src="([^"]*)"[^>]*\/?>/g, '![图片]($1)');
        
        // 处理代码块
        markdown = markdown.replace(/<pre[^>]*><code[^>]*>([\s\S]*?)<\/code><\/pre>/g, '```\n$1\n```\n\n');
        
        // 处理行内代码
        markdown = markdown.replace(/<code[^>]*>(.*?)<\/code>/g, '`$1`');
        
        // 处理引用
        markdown = markdown.replace(/<blockquote[^>]*>(.*?)<\/blockquote>/g, '> $1\n\n');
        
        // 处理换行
        markdown = markdown.replace(/<br[^>]*\/?>/g, '\n');
        
        // 处理水平分隔线
        markdown = markdown.replace(/<hr[^>]*\/?>/g, '---\n\n');
        
        // 移除span标签但保留内容
        markdown = markdown.replace(/<span[^>]*>(.*?)<\/span>/g, '$1');
        
        // 移除其他未处理的HTML标签
        markdown = markdown.replace(/<[^>]*>/g, '');
        
        // 移除多余的空白和缩进
        markdown = markdown.replace(/^\s+/gm, '');
        
        // 移除多余的空白行
        markdown = markdown.replace(/\n\s*\n/g, '\n\n');
        
        return markdown.trim();
      }
      
      // 转换函数
      function convertToMarkdown() {
        try {
          const html = htmlInput.value;
          const markdown = htmlToMarkdown(html);
          markdownOutput.value = markdown;
          
          // 更新预览
          updatePreview(markdown);
          // 更新统计信息
          updateOutputStats(markdown);
        } catch (error) {
          console.error('转换错误:', error);
          markdownOutput.value = '转换失败，请检查HTML格式';
          updatePreview('转换失败，请检查HTML格式');
        }
      }

      // 更新预览
      function updatePreview(markdown) {
        console.log('Updating preview with markdown:', markdown);
        const html = markdownToHtml(markdown);
        console.log('Generated html:', html);
        previewContent.innerHTML = html;
        console.log('Preview content updated:', previewContent.innerHTML);
      }

      // 复制到剪贴板
      function copyToClipboard(text) {
        navigator.clipboard.writeText(text)
          .then(() => {
            showTemporaryToast('复制成功');
          })
          .catch((error) => {
            console.warn('复制失败:', error);
          });
      }

      // 显示临时提示
      function showTemporaryToast(message) {
        toastNotification.textContent = message;
        toastNotification.style.display = 'block';
        toastNotification.classList.add('show');

        setTimeout(() => {
          toastNotification.classList.remove('show');
          setTimeout(() => {
            toastNotification.style.display = 'none';
          }, 300);
        }, 3000);
      }

      // 清空输入
      function clearInput() {
        htmlInput.value = '';
        updateInputStats('');
        startBtn.disabled = true;
      }

      // 清空输出
      function clearOutput() {
        markdownOutput.value = '';
        previewContent.innerHTML = '';
        updateOutputStats('');
      }

      // 清空全部
      function clearAll() {
        clearInput();
        clearOutput();
      }

      // 加载示例
      function loadExample() {
        const exampleHtml = `<h1>标题</h1>
<p>这是一个段落。</p>
<ul>
  <li>列表项1</li>
  <li>列表项2</li>
</ul>
<ol>
  <li>有序列表项1</li>
  <li>有序列表项2</li>
</ol>
<pre><code>console.log('Hello World')
</code></pre>
<table>
  <thead>
    <tr>
      <th>姓名</th>
      <th>年龄</th>
      <th>城市</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>张三</td>
      <td>25</td>
      <td>北京</td>
    </tr>
    <tr>
      <td>李四</td>
      <td>30</td>
      <td>上海</td>
    </tr>
  </tbody>
</table>`;
        htmlInput.value = exampleHtml;
        updateInputStats(exampleHtml);
        startBtn.disabled = false;
        if (realtimeMode.checked) {
          convertToMarkdown();
        }
      }

      // 更新输入统计信息
      function updateInputStats(text) {
        const lines = text.split('\n').length;
        const chars = text.length;
        inputLines.textContent = lines;
        inputChars.textContent = chars;
      }

      // 更新输出统计信息
      function updateOutputStats(text) {
        const lines = text.split('\n').length;
        const chars = text.length;
        outputLines.textContent = lines;
        outputChars.textContent = chars;
      }

      // 监听输入变化
      htmlInput.addEventListener('input', () => {
        const text = htmlInput.value;
        updateInputStats(text);
        startBtn.disabled = text.trim() === '';
        if (realtimeMode.checked) {
          convertToMarkdown();
        }
      });
      
      // 监听粘贴事件，确保粘贴内容后按钮状态也能更新
      htmlInput.addEventListener('paste', () => {
        setTimeout(() => {
          const text = htmlInput.value;
          startBtn.disabled = text.trim() === '';
        }, 0);
      });
      
      // 监听页面焦点事件，确保页面重新获得焦点时按钮状态正确
      window.addEventListener('focus', () => {
        const text = htmlInput.value;
        startBtn.disabled = text.trim() === '';
      });
      
      // 监听页面加载完成事件，确保页面刷新后按钮状态正确
      window.addEventListener('load', () => {
        const text = htmlInput.value;
        startBtn.disabled = text.trim() === '';
      });

      // 初始化按钮状态
      startBtn.disabled = htmlInput.value.trim() === '';
      
      // 初始化预览状态
      previewSection.style.display = showPreview.checked ? 'block' : 'none';

      // 事件监听器
      startBtn.addEventListener('click', convertToMarkdown);
      clearInputBtn.addEventListener('click', clearInput);
      clearOutputBtn.addEventListener('click', clearOutput);
      clearAllBtn.addEventListener('click', clearAll);
      loadExampleBtn.addEventListener('click', loadExample);
      copyOutputBtn.addEventListener('click', () => copyToClipboard(markdownOutput.value));

      // 实时转换开关
      realtimeMode.addEventListener('change', () => {
        if (realtimeMode.checked) {
          convertToMarkdown();
        }
      });

      // 显示预览开关
      showPreview.addEventListener('change', () => {
        previewSection.style.display = showPreview.checked ? 'block' : 'none';
      });

      // 字体大小调整
      fontSizeSlider.addEventListener('input', () => {
        const size = fontSizeSlider.value;
        fontSizeValue.textContent = `${size}px`;
        htmlInput.style.fontSize = `${size}px`;
        markdownOutput.style.fontSize = `${size}px`;
        previewContent.style.fontSize = `${size}px`;
      });
    });
  </script>

  <style>
