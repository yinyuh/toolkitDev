---
import Layout from "../../layouts/Layout.astro";
import AdSense from "../../components/ads/AdSense.astro";
import { ref, computed, watch, onMounted } from "vue";

// 页面元数据，供 index.astro 读取
title: "HTML转Markdown工具 - 在线代码格式转换 (HTML to Markdown)"
description: "免费在线HTML转Markdown工具，支持表格、代码块、链接等复杂格式转换。实时预览，一键复制，开发者文档迁移必备神器。"
technologies: "Vue, TailwindCSS, JavaScript"
category: "developer"
order: 3

const pageTitle = "HTML转Markdown工具 - 在线代码格式转换 (HTML to Markdown)";
const pageDescription = "免费在线HTML转Markdown工具，支持表格、代码块、链接等复杂格式转换。实时预览，一键复制，开发者文档迁移必备神器。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "HTML转Markdown工具",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/html-to-markdown",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "HTML 代码转 Markdown",
        "支持表格和代码块",
        "实时转换预览",
        "一键复制结果",
        "本地浏览器处理，隐私安全"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "转换后的 Markdown 支持哪些平台？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "本工具生成的 Markdown 遵循通用标准（CommonMark/GitHub Flavored Markdown），适用于 GitHub、GitLab、Obsidian、Notion、Hugo、Hexo 等绝大多数支持 Markdown 的平台和编辑器。"
          }
        },
        {
          "@type": "Question",
          "name": "支持复杂的 HTML 表格吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "支持。工具会自动将 HTML `<table>` 标签转换为 Markdown 表格语法。对于过于复杂的嵌套表格，可能会简化处理以保持 Markdown 的可读性。"
          }
        },
        {
          "@type": "Question",
          "name": "我的 HTML 数据会上传吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。所有转换过程完全在您的浏览器本地（Client-side）进行，HTML 代码不会发送到任何服务器，确保您的数据和文档隐私安全。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用 HTML 转 Markdown 工具",
      "step": [
        {
          "@type": "HowToStep",
          "name": "输入 HTML",
          "text": "将需要转换的 HTML 代码粘贴到左侧的输入框中。"
        },
        {
          "@type": "HowToStep",
          "name": "查看结果",
          "text": "右侧输入框会自动显示转换后的 Markdown 代码，下方会有实时渲染预览。"
        },
        {
          "@type": "HowToStep",
          "name": "复制使用",
          "text": "点击“复制”按钮将 Markdown 代码复制到剪贴板，然后粘贴到您的编辑器中。"
        }
      ]
    }
  ]
};
