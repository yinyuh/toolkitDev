---
import Layout from "../../layouts/Layout.astro";
import { ref, computed, watch } from "vue";
import { onMounted } from "vue";

// 页面元数据
title: "HTML转Markdown工具"
description: "免费在线HTML转Markdown工具，支持表格、代码块等复杂格式转换"
technologies: "HTML, CSS, JavaScript, Vue"
category: "tool"
order: -1
---

<Layout title="HTML转Markdown工具" description="免费在线HTML转Markdown工具，支持表格、代码块等复杂格式转换">
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">HTML转Markdown工具</h1>
        <p class="text-theme-secondary max-w-3xl mx-auto">
          免费在线HTML转Markdown工具，支持表格、代码块等复杂格式转换
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-5xl mx-auto bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
        <!-- Toast Notification -->
        <div id="toast-notification" class="toast-notification" style="display: none;"></div>

        <div class="toolbar mb-8">
          <div class="header-actions mb-6">
            <a href="/" class="back-button inline-flex items-center gap-1">
              返回首页
            </a>
          </div>
          
          <div class="controls flex flex-wrap gap-3 items-center">
            <button id="convert-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors" disabled>
              手动转换
            </button>
            <button id="clear-input-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              清空输入
            </button>
            <button id="clear-output-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              清空输出
            </button>
            <button id="clear-all-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              清空全部
            </button>
            <button id="load-example-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
              加载示例
            </button>
            
            <label class="flex items-center gap-2">
              <input type="checkbox" id="realtime-mode" checked> 实时转换
            </label>
            
            <label class="flex items-center gap-2">
              <input type="checkbox" id="show-preview"> 显示预览
            </label>
            
            <label class="flex items-center gap-2">
              字体大小: 
              <input type="range" id="font-size" min="10" max="24" step="1" value="14">
              <span id="font-size-value">14px</span>
            </label>
          </div>
        </div>

        <div class="main-content flex flex-col md:flex-row gap-8 mb-8">
          <div class="input-section flex-1 flex flex-col">
            <div class="section-header flex justify-between items-center mb-4">
              <h2 class="text-xl font-bold text-theme-primary">HTML输入</h2>
              <div class="stats text-theme-secondary text-sm">
                行数: <span id="input-lines">0</span> | 字符数: <span id="input-chars">0</span>
              </div>
            </div>
            <textarea 
              id="html-input" 
              class="w-full min-h-[300px] p-4 border border-theme-border rounded-lg resize-vertical font-mono"
              placeholder="在此粘贴HTML代码..."
              style="font-size: 14px;"
            ></textarea>
          </div>

          <div class="output-section flex-1 flex flex-col">
            <div class="section-header flex justify-between items-center mb-4">
              <h2 class="text-xl font-bold text-theme-primary">Markdown输出</h2>
              <div class="flex items-center gap-3">
                <div class="stats text-theme-secondary text-sm">
                  行数: <span id="output-lines">0</span> | 字符数: <span id="output-chars">0</span>
                </div>
                <button id="copy-output-btn" class="btn-theme px-4 py-2 rounded-lg transition-colors">
                  复制
                </button>
              </div>
            </div>
            <textarea 
              id="markdown-output" 
              class="w-full min-h-[300px] p-4 border border-theme-border rounded-lg resize-vertical font-mono bg-theme-secondary"
              placeholder="转换结果将显示在这里..."
              readonly
              style="font-size: 14px;"
            ></textarea>
          </div>
        </div>

        <!-- Markdown 预览窗口 -->
        <div id="preview-section" class="preview-section mb-8">
          <div class="section-header flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold text-theme-primary">Markdown 预览</h2>
          </div>
          <div 
            id="preview-content" 
            class="preview-content p-4 border border-theme-border rounded-lg min-h-[200px] bg-theme-secondary"
            style="font-size: 14px;"
          ></div>
        </div>

        <!-- Reference Guide -->
        <div class="reference-guide pt-8 border-t border-theme-border">
          <h3 class="text-xl font-bold text-theme-primary mb-4">HTML标签与Markdown语法对照表</h3>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-theme-secondary">
                  <th class="p-4 border border-theme-border text-left font-bold">HTML标签</th>
                  <th class="p-4 border border-theme-border text-left font-bold">Markdown语法</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;h1&gt;标题&lt;/h1&gt;</td>
                  <td class="p-4 border border-theme-border"># 标题</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;p&gt;段落&lt;/p&gt;</td>
                  <td class="p-4 border border-theme-border">段落</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;strong&gt;粗体&lt;/strong&gt;</td>
                  <td class="p-4 border border-theme-border">**粗体**</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;em&gt;斜体&lt;/em&gt;</td>
                  <td class="p-4 border border-theme-border">*斜体*</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;ul&gt;&lt;li&gt;列表项&lt;/li&gt;&lt;/ul&gt;</td>
                  <td class="p-4 border border-theme-border">- 列表项</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;ol&gt;&lt;li&gt;列表项&lt;/li&gt;&lt;/ol&gt;</td>
                  <td class="p-4 border border-theme-border">1. 列表项</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;a href="url"&gt;链接&lt;/a&gt;</td>
                  <td class="p-4 border border-theme-border">[链接](url)</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;img src="url" alt="描述"&gt;</td>
                  <td class="p-4 border border-theme-border">![描述](url)</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;table&gt;&lt;tr&gt;&lt;td&gt;单元格&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</td>
                  <td class="p-4 border border-theme-border">| 单元格 |\n|--------|</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;pre&gt;&lt;code&gt;代码块&lt;/code&gt;&lt;/pre&gt;</td>
                  <td class="p-4 border border-theme-border">```\n代码块\n```</td>
                </tr>
                <tr>
                  <td class="p-4 border border-theme-border">&lt;blockquote&gt;引用&lt;/blockquote&gt;</td>
                  <td class="p-4 border border-theme-border">&gt; 引用</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 简化版HTML转Markdown工具，不依赖外部库 -->
  <script>
    // 页面加载完成后执行
    document.addEventListener('DOMContentLoaded', () => {
      // 获取DOM元素
      const htmlInput = document.getElementById('html-input');
      const markdownOutput = document.getElementById('markdown-output');
      const previewContent = document.getElementById('preview-content');
      const startBtn = document.getElementById('convert-btn');
      const clearInputBtn = document.getElementById('clear-input-btn');
      const clearOutputBtn = document.getElementById('clear-output-btn');
      const clearAllBtn = document.getElementById('clear-all-btn');
      const loadExampleBtn = document.getElementById('load-example-btn');
      const realtimeMode = document.getElementById('realtime-mode');
      const showPreview = document.getElementById('show-preview');
      const fontSizeSlider = document.getElementById('font-size');
      const fontSizeValue = document.getElementById('font-size-value');
      const previewSection = document.getElementById('preview-section');
      const copyOutputBtn = document.getElementById('copy-output-btn');
      const toastNotification = document.getElementById('toast-notification');
      const inputLines = document.getElementById('input-lines');
      const inputChars = document.getElementById('input-chars');
      const outputLines = document.getElementById('output-lines');
      const outputChars = document.getElementById('output-chars');

      // 简单的HTML转Markdown函数
      function htmlToMarkdown(html) {
        let markdown = html;
        
        // 处理标题
        markdown = markdown.replace(/<h1>(.*?)<\/h1>/g, '# $1\n\n');
        markdown = markdown.replace(/<h2>(.*?)<\/h2>/g, '## $1\n\n');
        markdown = markdown.replace(/<h3>(.*?)<\/h3>/g, '### $1\n\n');
        markdown = markdown.replace(/<h4>(.*?)<\/h4>/g, '#### $1\n\n');
        markdown = markdown.replace(/<h5>(.*?)<\/h5>/g, '##### $1\n\n');
        markdown = markdown.replace(/<h6>(.*?)<\/h6>/g, '###### $1\n\n');
        
        // 处理段落
        markdown = markdown.replace(/<p>(.*?)<\/p>/g, '$1\n\n');
        
        // 处理粗体和斜体
        markdown = markdown.replace(/<strong>(.*?)<\/strong>/g, '**$1**');
        markdown = markdown.replace(/<b>(.*?)<\/b>/g, '**$1**');
        markdown = markdown.replace(/<em>(.*?)<\/em>/g, '*$1*');
        markdown = markdown.replace(/<i>(.*?)<\/i>/g, '*$1*');
        
        // 处理列表
        markdown = markdown.replace(/<ul>([\s\S]*?)<\/ul>/g, (match, content) => {
          return content.replace(/<li>(.*?)<\/li>/g, '- $1\n') + '\n';
        });
        
        markdown = markdown.replace(/<ol>([\s\S]*?)<\/ol>/g, (match, content) => {
          let index = 1;
          return content.replace(/<li>(.*?)<\/li>/g, () => `${index++}. $1\n`) + '\n';
        });
        
        // 处理链接
        markdown = markdown.replace(/<a href="(.*?)">(.*?)<\/a>/g, '[$2]($1)');
        
        // 处理图片
        markdown = markdown.replace(/<img src="(.*?)" alt="(.*?)"\s*\/?>/g, '![$2]($1)');
        
        // 处理代码块
        markdown = markdown.replace(/<pre><code>([\s\S]*?)<\/code><\/pre>/g, '```\n$1\n```\n\n');
        
        // 处理行内代码
        markdown = markdown.replace(/<code>(.*?)<\/code>/g, '`$1`');
        
        // 处理引用
        markdown = markdown.replace(/<blockquote>(.*?)<\/blockquote>/g, '> $1\n\n');
        
        // 处理表格（简单版）
        markdown = markdown.replace(/<table>([\s\S]*?)<\/table>/g, (match, content) => {
          let tableMarkdown = '\n';
          let rows = content.match(/<tr>([\s\S]*?)<\/tr>/g);
          
          if (rows) {
            // 处理表头
            let headerMatch = rows[0].match(/<th>(.*?)<\/th>/g);
            if (headerMatch) {
              let headers = headerMatch.map(th => th.replace(/<\/?th>/g, '').trim());
              tableMarkdown += `| ${headers.join(' | ')} |\n`;
              tableMarkdown += `| ${headers.map(() => '---').join(' | ')} |\n`;
              
              // 处理数据行
              for (let i = 1; i < rows.length; i++) {
                let cellMatch = rows[i].match(/<td>(.*?)<\/td>/g);
                if (cellMatch) {
                  let cells = cellMatch.map(td => td.replace(/<\/?td>/g, '').trim());
                  tableMarkdown += `| ${cells.join(' | ')} |\n`;
                }
              }
            }
          }
          
          return tableMarkdown + '\n';
        });
        
        // 处理换行
        markdown = markdown.replace(/<br\s*\/?>/g, '\n');
        
        // 移除多余的空白
        markdown = markdown.replace(/\n\s*\n/g, '\n\n');
        
        return markdown.trim();
      }
      
      // 简单的Markdown转HTML函数（用于预览）
      function markdownToHtml(markdown) {
        let html = markdown;
        
        // 处理标题
        html = html.replace(/^(\#{1,6})\s+(.*)$/gm, (match, hashes, text) => {
          const level = hashes.length;
          return `<h${level}>${text}</h${level}>`;
        });
        
        // 处理粗体和斜体
        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
        
        // 处理列表
        html = html.replace(/^(\-|\*)\s+(.*)$/gm, '<li>$2</li>');
        html = html.replace(/(<li>.*?<\/li>)\s*/g, '$1');
        html = html.replace(/(<li>.*?<\/li>)+/g, '<ul>$&</ul>');
        
        html = html.replace(/^\d+\.\s+(.*)$/gm, '<li>$1</li>');
        html = html.replace(/(<li>.*?<\/li>)+/g, '<ol>$&</ol>');
        
        // 处理链接
        html = html.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>');
        
        // 处理图片
        html = html.replace(/!\[(.*?)\]\((.*?)\)/g, '<img src="$2" alt="$1">');
        
        // 处理代码块
        html = html.replace(/```(.*?)```/gs, '<pre><code>$1</code></pre>');
        
        // 处理行内代码
        html = html.replace(/`(.*?)`/g, '<code>$1</code>');
        
        // 处理引用
        html = html.replace(/^>\s+(.*)$/gm, '<blockquote>$1</blockquote>');
        
        // 处理表格
        html = html.replace(/^(\|.*?\|)$(\n\|.*?\|)+/gm, (match) => {
          let tableHtml = '<table><tbody>';
          let rows = match.split('\n');
          
          rows.forEach((row, index) => {
            if (index === 1) return; // 跳过分隔行
            let cells = row.replace(/^\||\|$/g, '').split('|').map(cell => cell.trim());
            tableHtml += '<tr>';
            cells.forEach(cell => {
              tableHtml += `<td>${cell}</td>`;
            });
            tableHtml += '</tr>';
          });
          
          tableHtml += '</tbody></table>';
          return tableHtml;
        });
        
        // 处理段落
        html = html.replace(/^(?!<h|<ul|<ol|<pre|<blockquote|<table).*$/gm, '<p>$&</p>');
        
        return html;
      }
      
      // 转换函数
      function convertToMarkdown() {
        try {
          const html = htmlInput.value;
          const markdown = htmlToMarkdown(html);
          markdownOutput.value = markdown;
          
          // 更新预览
          updatePreview(markdown);
          // 更新统计信息
          updateOutputStats(markdown);
        } catch (error) {
          console.error('转换错误:', error);
          markdownOutput.value = '转换失败，请检查HTML格式';
          updatePreview('转换失败，请检查HTML格式');
        }
      }

      // 更新预览
      function updatePreview(markdown) {
        previewContent.innerHTML = markdownToHtml(markdown);
      }

      // 复制到剪贴板
      function copyToClipboard(text) {
        navigator.clipboard.writeText(text)
          .then(() => {
            showTemporaryToast('复制成功');
          })
          .catch((error) => {
            console.warn('复制失败:', error);
          });
      }

      // 显示临时提示
      function showTemporaryToast(message) {
        toastNotification.textContent = message;
        toastNotification.style.display = 'block';
        toastNotification.classList.add('show');

        setTimeout(() => {
          toastNotification.classList.remove('show');
          setTimeout(() => {
            toastNotification.style.display = 'none';
          }, 300);
        }, 3000);
      }

      // 清空输入
      function clearInput() {
        htmlInput.value = '';
        updateInputStats('');
        if (realtimeMode.checked) {
          markdownOutput.value = '';
          previewContent.innerHTML = '';
          updateOutputStats('');
        }
      }

      // 清空输出
      function clearOutput() {
        markdownOutput.value = '';
        previewContent.innerHTML = '';
        updateOutputStats('');
      }

      // 清空全部
      function clearAll() {
        clearInput();
        clearOutput();
      }

      // 加载示例
      function loadExample() {
        const exampleHtml = `<h1>标题</h1>
<p>这是一个段落。</p>
<ul>
  <li>列表项1</li>
  <li>列表项2</li>
</ul>
<ol>
  <li>有序列表项1</li>
  <li>有序列表项2</li>
</ol>
<pre><code>console.log('Hello World')
</code></pre>
<table>
  <thead>
    <tr>
      <th>姓名</th>
      <th>年龄</th>
      <th>城市</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>张三</td>
      <td>25</td>
      <td>北京</td>
    </tr>
    <tr>
      <td>李四</td>
      <td>30</td>
      <td>上海</td>
    </tr>
  </tbody>
</table>`;
        htmlInput.value = exampleHtml;
        updateInputStats(exampleHtml);
        if (realtimeMode.checked) {
          convertToMarkdown();
        }
      }

      // 更新输入统计信息
      function updateInputStats(text) {
        const lines = text.split('\n').length;
        const chars = text.length;
        inputLines.textContent = lines;
        inputChars.textContent = chars;
      }

      // 更新输出统计信息
      function updateOutputStats(text) {
        const lines = text.split('\n').length;
        const chars = text.length;
        outputLines.textContent = lines;
        outputChars.textContent = chars;
      }

      // 监听输入变化
      htmlInput.addEventListener('input', () => {
        const text = htmlInput.value;
        updateInputStats(text);
        if (realtimeMode.checked) {
          convertToMarkdown();
        }
      });

      // 事件监听器
      startBtn.addEventListener('click', convertToMarkdown);
      clearInputBtn.addEventListener('click', clearInput);
      clearOutputBtn.addEventListener('click', clearOutput);
      clearAllBtn.addEventListener('click', clearAll);
      loadExampleBtn.addEventListener('click', loadExample);
      copyOutputBtn.addEventListener('click', () => copyToClipboard(markdownOutput.value));

      // 实时转换开关
      realtimeMode.addEventListener('change', () => {
        if (realtimeMode.checked) {
          convertToMarkdown();
        }
      });

      // 显示预览开关
      showPreview.addEventListener('change', () => {
        previewSection.style.display = showPreview.checked ? 'block' : 'none';
      });

      // 字体大小调整
      fontSizeSlider.addEventListener('input', () => {
        const size = fontSizeSlider.value;
        fontSizeValue.textContent = `${size}px`;
        htmlInput.style.fontSize = `${size}px`;
        markdownOutput.style.fontSize = `${size}px`;
        previewContent.style.fontSize = `${size}px`;
      });

      // 禁用/启用转换按钮
      htmlInput.addEventListener('input', () => {
        startBtn.disabled = htmlInput.value.trim() === '';
      });
    });
  </script>

  <style>
    /* Toast Notification Styles */
    .toast-notification {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background-color: rgba(0, 0, 0, 0.8);
      color: white;
      padding: 12px 20px;
      border-radius: 4px;
      z-index: 1000;
      font-size: 14px;
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      transform: translateX(-50%) translateY(-20px);
    }

    .toast-notification.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Toolbar Styles */
    .toolbar {
      margin-bottom: 20px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 15px;
      gap: 20px;
      position: relative;
    }

    .back-button {
      position: absolute;
      left: 0;
      display: inline-flex;
      align-items: center;
      padding: 8px 12px;
      background-color: #6c757d;
      color: white;
      border-radius: 4px;
      text-decoration: none;
      font-size: 14px;
      transition: background-color 0.2s;
    }

    .back-button:hover {
      background-color: #5a6268;
    }

    /* Controls Styles */
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .controls button {
      padding: 8px 12px;
      background-color: #42b983;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }

    .controls button:disabled {
      background-color: #ccc;
      cursor: not-allowed;
    }

    .controls label {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* Main Content Styles */
    .main-content {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
    }

    @media (max-width: 768px) {
      .main-content {
        flex-direction: column;
      }

      .preview-section {
        width: 100%;
      }
    }

    /* Input/Output Section Styles */
    .input-section,
    .output-section {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Preview Section Styles */
    .preview-section {
      display: flex;
      flex-direction: column;
      margin: 20px auto 0 auto;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 4px;
      background-color: #f9f9f9;
      width: 100%;
    }

    .preview-content {
      flex: 1;
      padding: 10px;
      overflow-y: auto;
      background-color: #f9f9f9;
      border: 1px solid #eee;
      border-radius: 4px;
      text-align: left;
    }

    /* Preview Content Styles */
    .preview-content code {
      background-color: #f0f0f0;
      padding: 2px 4px;
      border-radius: 3px;
      font-family: 'Consolas', 'Courier New', monospace;
    }

    .preview-content pre {
      background-color: #f0f0f0;
      padding: 10px;
      border-radius: 5px;
      overflow-x: auto;
    }

    .preview-content pre code {
      background-color: transparent;
      padding: 0;
    }

    .preview-content a {
      color: #007bff !important;
      text-decoration: none;
    }

    .preview-content a:hover {
      text-decoration: underline;
    }

    .preview-content table {
      width: 100%;
      border-collapse: collapse;
      margin: 1em 0;
    }

    .preview-content th,
