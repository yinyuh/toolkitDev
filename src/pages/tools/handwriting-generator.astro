---
import Layout from "../../layouts/Layout.astro";
import HandwritingGenerator from '../../components/tools/HandwritingGenerator';
import AdSense from "../../components/ads/AdSense.astro";

title: "在线手写文本生成器 (Handwriting)"
description: "免费在线手写文本生成器，将打印文字转换为逼真的手写体图片，支持多种字体、纸张背景和墨水颜色，模拟真实手写效果。"
technologies: "React, TailwindCSS"
category: "text"
order: 100

const pageTitle = "在线手写文本生成器 (Handwriting)";
const pageDescription = "免费在线手写文本生成器，将打印文字转换为逼真的手写体图片，支持多种字体、纸张背景和墨水颜色，模拟真实手写效果。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线手写文本生成器",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/handwriting-generator",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "普通文本一键生成手写风格",
        "支持中英文字体切换",
        "可调字号、墨水颜色和纸张背景",
        "支持手写扰动增强真实感",
        "生成结果可直接下载图片",
        "完全免费在线使用"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "手写文本生成器适合哪些场景？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "适合学生手写作业示例、课堂板书素材、海报配文、手账内容制作以及社交平台手写风文案展示。"
          }
        },
        {
          "@type": "Question",
          "name": "生成的图片清晰度够用吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "工具会根据画布尺寸进行渲染，通常可满足日常打印、分享和课件展示。建议在导出前先调整字号与行距，确保阅读体验。"
          }
        },
        {
          "@type": "Question",
          "name": "内容会上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。生成过程在浏览器本地执行，文本与样式设置不会上传到远程服务器，适合对隐私有要求的使用场景。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用手写文本生成器",
      "step": [
        {
          "@type": "HowToStep",
          "name": "输入文字内容",
          "text": "在输入区粘贴或键入需要转换为手写风格的文本内容。"
        },
        {
          "@type": "HowToStep",
          "name": "设置样式参数",
          "text": "选择手写字体、纸张背景和墨水颜色，并根据需要调整字号与扰动。"
        },
        {
          "@type": "HowToStep",
          "name": "下载手写图片",
          "text": "预览满意后点击下载，保存为图片用于打印、提交或分享。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">手写文本生成器</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          把电子文字快速转换为手写风格图片。<span class="text-accent font-semibold">多字体与纸张参数自由组合</span>，满足作业排版与内容设计场景。
        </p>
      </div>

      <div class="max-w-6xl mx-auto bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
        <HandwritingGenerator client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么手写文本生成器很实用？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              在学习与内容创作中，很多场景都需要“手写感”视觉表达，比如课堂作业示例、笔记封面、海报标题和社媒文案。纯手写耗时较高，且修改成本大。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 手写文本生成器</strong> 通过可视化参数控制，让你在浏览器中快速把标准文本转成手写图片。你可以自由切换字体、纸张背景和墨水颜色，并通过手写扰动增强真实感，兼顾效率与美观。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">✍️</div>
                <h3 class="text-xl font-semibold mb-2">文本秒变手写风</h3>
                <p class="text-theme-secondary">输入文字后立即预览手写效果，减少重复截图与排版操作。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🅰️</div>
                <h3 class="text-xl font-semibold mb-2">多字体可选</h3>
                <p class="text-theme-secondary">支持多种中英文手写字体，轻松适配不同学科和视觉风格。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📄</div>
                <h3 class="text-xl font-semibold mb-2">纸张背景可切换</h3>
                <p class="text-theme-secondary">横线纸、方格纸与空白纸自由选择，模拟真实书写环境。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">💾</div>
                <h3 class="text-xl font-semibold mb-2">导出方便</h3>
                <p class="text-theme-secondary">完成后可一键下载图片，适合打印、提交或分享到社交平台。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步生成手写文本</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">输入或粘贴文本</h3>
                  <p class="text-theme-secondary">把需要处理的内容输入工具，可用于作业说明、笔记段落或短文案。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">调节手写样式</h3>
                  <p class="text-theme-secondary">选择字体、纸张背景与墨水颜色，并按需调节字号和手写扰动。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">下载并使用</h3>
                  <p class="text-theme-secondary">确认预览效果后下载图片，直接用于打印、课件或创意展示。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>这个工具能替代真实手写吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  它适合用于视觉模拟和内容展示，能显著提升效率。若场景对“原笔迹”有严格要求，仍建议使用真实手写。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>如何让效果更像手写？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  可以适当开启手写扰动、降低整齐度，并搭配横线纸或方格纸背景，让整体观感更自然。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>支持手机端使用吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  支持。建议在手机端使用较短段落并适当增大字号，导出前先预览清晰度，保证最终可读性。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关文本工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/glitch-text-generator" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">故障文字生成器</div>
                  <div class="text-xs text-theme-secondary">生成 Zalgo/Glitch 风格特效文字</div>
                </a>
              </li>
              <li>
                <a href="/tools/scrambled-text-generator" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">乱序文字生成器</div>
                  <div class="text-xs text-theme-secondary">生成可读但打乱顺序的趣味文本</div>
                </a>
              </li>
              <li>
                <a href="/tools/text-formatter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">文本格式化工具</div>
                  <div class="text-xs text-theme-secondary">JSON/XML/YAML/SQL 一键美化</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
