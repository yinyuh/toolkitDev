---
import Layout from "../../layouts/Layout.astro";
title: "多格式文本格式化工具"
description: "一个功能强大的纯前端多格式文本格式化工具，支持JSON、XML、YAML、SQL等格式的格式化、压缩和语法校验"
technologies: "文本格式化"
category: "tool"
order: -1
---

<Layout title="多格式文本格式化工具" description="一个功能强大的纯前端多格式文本格式化工具，支持JSON、XML、YAML、SQL等格式的格式化、压缩和语法校验">
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">多格式文本格式化工具</h1>
        <p class="text-theme-secondary max-w-3xl mx-auto">
          一个功能强大的纯前端多格式文本格式化工具，支持JSON、XML、YAML、SQL等格式的格式化、压缩和语法校验，所有操作均在本地完成。
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-6xl mx-auto">
        <div class="text-formatter-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
          <!-- Main Content Area -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Input Section -->
            <div class="input-section flex flex-col min-w-0">
              <div class="flex justify-between items-center mb-4" style="height: 32px; min-height: 32px;">
                <h2 class="text-xl font-semibold text-theme-primary">文本输入</h2>
              </div>
              <div class="mb-4" style="height: 40px; min-height: 40px;">
                <div class="flex gap-2 h-full flex-wrap">
                  <select id="formatSelect" class="bg-div-theme border border-theme-primary rounded-lg px-4 py-2 text-theme-primary cursor-pointer w-32">
                    <option value="auto">自动识别</option>
                    <option value="json">JSON</option>
                    <option value="xml">XML</option>
                    <option value="yaml">YAML</option>
                    <option value="sql">SQL</option>
                  </select>
                  <button id="validateBtn" class="btn-theme px-3 py-2 rounded-lg text-sm transition-colors flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    校验语法
                  </button>
                  <label for="fileInput" class="btn-theme px-3 py-1 rounded-lg text-sm transition-colors flex items-center gap-1 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    导入文件
                  </label>
                  <input type="file" id="fileInput" accept=".txt,.json,.xml,.yaml,.yml,.sql" class="hidden">
                  <button id="clearInputBtn" class="btn-theme px-3 py-1 rounded-lg text-sm transition-colors flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    清空
                  </button>
                </div>
              </div>
              <div class="flex-1 flex flex-col" style="min-height: 400px;">
                <textarea 
                  id="textInput" 
                  class="w-full h-[600px] p-4 border border-theme-border rounded-lg shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-div-theme dark:text-theme-primary font-mono resize-none overflow-x-auto"
                  placeholder="请输入/粘贴需要格式化的文本..."
                ></textarea>
              </div>
              <div class="flex justify-between items-center mt-2 text-xs text-theme-secondary" style="height: 20px; min-height: 20px;">
                <span id="charCount">字符数: 0</span>
                <span id="fileSize">大小: 0 KB</span>
              </div>
            </div>

            <!-- Output Section -->
            <div class="output-section flex flex-col min-w-0">
              <div class="flex justify-between items-center mb-4" style="height: 32px; min-height: 32px;">
                <h2 class="text-xl font-semibold text-theme-primary">文本预览</h2>
                <div class="flex gap-2">
                  <div class="flex gap-1">
                    <button id="decreaseFontBtn" class="btn-theme px-2 py-1 rounded text-xs transition-colors">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </button>
                    <span id="fontSizeDisplay" class="btn-theme px-2 py-1 rounded text-xs">14px</span>
                    <button id="increaseFontBtn" class="btn-theme px-2 py-1 rounded text-xs transition-colors">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                      </svg>
                    </button>
                  </div>
                  <button id="toggleWordWrapBtn" class="btn-theme px-3 py-1 rounded-lg text-sm transition-colors flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                    </svg>
                    换行
                  </button>
                </div>
              </div>
              <div class="mb-4" style="height: 40px; min-height: 40px;">
                <div class="flex gap-1 h-full flex-wrap">
                  <button id="formatBtnSmall" class="btn-theme px-2 py-2 rounded-lg text-sm transition-colors flex items-center gap-1 flex-1 whitespace-nowrap justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    格式化
                  </button>
                  <button id="compressBtnSmall" class="btn-theme px-2 py-2 rounded-lg text-sm transition-colors flex items-center gap-1 flex-1 whitespace-nowrap justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8-4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                    </svg>
                    压缩
                  </button>
                  <button id="resetConfigBtnSmall" class="btn-theme px-2 py-2 rounded-lg text-sm transition-colors flex items-center gap-1 flex-1 whitespace-nowrap justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    重置
                  </button>
                  <button id="copyOutputBtn" class="btn-theme px-2 py-2 rounded-lg text-sm transition-colors flex items-center gap-1 flex-1 whitespace-nowrap justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                    复制
                  </button>
                  <button id="downloadOutputBtn" class="btn-theme px-2 py-2 rounded-lg text-sm transition-colors flex items-center gap-1 flex-1 whitespace-nowrap justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    下载
                  </button>
                  <button id="clearOutputBtn" class="btn-theme px-2 py-2 rounded-lg text-sm transition-colors flex items-center gap-1 flex-1 whitespace-nowrap justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    清空
                  </button>
                </div>
              </div>
              <div class="flex-1 flex flex-col" style="min-height: 400px;">
                <div 
                  id="textOutput" 
                  class="w-full h-[600px] p-4 border border-theme-border rounded-lg shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-div-theme font-mono whitespace-pre-wrap overflow-auto text-gray-400"
                  style="font-size: 14px;"
                >格式化后内容将展示在这里...</div>
              </div>
              <div class="flex justify-between items-center mt-2 text-xs text-theme-secondary opacity-0" style="height: 20px; min-height: 20px;">
                <span>字符数: 0</span>
                <span>大小: 0 KB</span>
              </div>
            </div>
          </div>

          <!-- Configuration Panel -->
          <div class="config-section mb-8">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-xl font-semibold text-theme-primary">格式化配置</h2>
              <button id="toggleConfigBtn" class="btn-theme px-3 py-1 rounded-lg text-sm transition-colors flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
                折叠
              </button>
            </div>
            <div id="configContent" class="bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
              <!-- JSON Config -->
              <div id="jsonConfig" class="config-panel">
                <h3 class="text-lg font-semibold text-theme-primary mb-3">JSON配置</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">缩进方式</label>
                    <select id="jsonIndentType" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="space">空格</option>
                      <option value="tab">制表符</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">缩进数量</label>
                    <select id="jsonIndentSize" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="2">2空格</option>
                      <option value="4" selected>4空格</option>
                      <option value="8">8空格</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">排序key</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="jsonSortKeys" class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">保留注释</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="jsonPreserveComments" checked class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- XML Config -->
              <div id="xmlConfig" class="config-panel hidden">
                <h3 class="text-lg font-semibold text-theme-primary mb-3">XML配置</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">缩进方式</label>
                    <select id="xmlIndentType" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="space">空格</option>
                      <option value="tab">制表符</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">缩进数量</label>
                    <select id="xmlIndentSize" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="2">2空格</option>
                      <option value="4" selected>4空格</option>
                      <option value="8">8空格</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">格式化属性</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="xmlFormatAttributes" checked class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">保留注释</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="xmlPreserveComments" checked class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- YAML Config -->
              <div id="yamlConfig" class="config-panel hidden">
                <h3 class="text-lg font-semibold text-theme-primary mb-3">YAML配置</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">缩进数量</label>
                    <select id="yamlIndentSize" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="2" selected>2空格</option>
                      <option value="4">4空格</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">保留注释</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="yamlPreserveComments" checked class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- SQL Config -->
              <div id="sqlConfig" class="config-panel hidden">
                <h3 class="text-lg font-semibold text-theme-primary mb-3">SQL配置</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">缩进数量</label>
                    <select id="sqlIndentSize" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="2">2空格</option>
                      <option value="4" selected>4空格</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">关键字大小写</label>
                    <select id="sqlKeywordCase" class="w-full bg-div-theme border border-theme-primary rounded px-3 py-2 text-theme-primary cursor-pointer">
                      <option value="preserve" selected>保持原样</option>
                      <option value="upper">大写</option>
                      <option value="lower">小写</option>
                    </select>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">保留注释</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="sqlPreserveComments" checked class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Compression Config -->
              <div class="mt-6 pt-6 border-t border-theme-secondary">
                <h3 class="text-lg font-semibold text-theme-primary mb-3">压缩配置</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">保留空格</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="compressPreserveSpaces" class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                  <div class="option">
                    <label class="block text-sm font-medium text-theme-primary mb-1">保留注释</label>
                    <div class="flex items-center">
                      <input type="checkbox" id="compressPreserveComments" class="mr-2">
                      <span class="text-sm text-theme-secondary">是</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="action-section">
            <div class="flex flex-wrap gap-4 justify-center">
              <button id="formatBtn" class="btn-theme px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2 min-w-[160px]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                格式化文本
              </button>
              <button id="compressBtn" class="btn-theme px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2 min-w-[160px]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8-4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                </svg>
                压缩文本
              </button>
              <button id="resetConfigBtn" class="btn-theme px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2 min-w-[160px]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                重置配置
              </button>
            </div>
          </div>

          <!-- History Section -->
          <div class="history-section mt-8">
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-xl font-semibold text-theme-primary">历史记录</h2>
              <button id="toggleHistoryBtn" class="btn-theme px-3 py-1 rounded-lg text-sm transition-colors flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
                折叠
              </button>
            </div>
            <div id="historyContent" class="bg-theme-secondary rounded-lg p-6 border border-theme-secondary">
              <div id="historyList" class="space-y-3">
                <!-- History items will be added here -->
                <div class="text-center text-theme-secondary py-4">
                  暂无历史记录
                </div>
              </div>
              <div class="mt-4 flex justify-end">
                <button id="clearHistoryBtn" class="btn-theme px-3 py-1 rounded-lg text-sm transition-colors flex items-center gap-1 hidden">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  清空历史
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Toast Notification -->
  <div id="toastNotification" class="fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg transform translate-x-full opacity-0 transition-all duration-300 z-50 flex items-center gap-2">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
    </svg>
    <span id="toastMessage">操作成功！</span>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // DOM Elements
      const textInput = document.getElementById('textInput');
      const textOutput = document.getElementById('textOutput');
      const formatSelect = document.getElementById('formatSelect');
      const validateBtn = document.getElementById('validateBtn');
      const formatBtn = document.getElementById('formatBtn');
      const formatBtnSmall = document.getElementById('formatBtnSmall');
      const compressBtn = document.getElementById('compressBtn');
      const compressBtnSmall = document.getElementById('compressBtnSmall');
      const copyOutputBtn = document.getElementById('copyOutputBtn');
      const downloadOutputBtn = document.getElementById('downloadOutputBtn');
      const clearInputBtn = document.getElementById('clearInputBtn');
      const clearOutputBtn = document.getElementById('clearOutputBtn');
      const resetConfigBtn = document.getElementById('resetConfigBtn');
      const resetConfigBtnSmall = document.getElementById('resetConfigBtnSmall');
      const fileInput = document.getElementById('fileInput');
      const charCount = document.getElementById('charCount');
      const fileSize = document.getElementById('fileSize');
      const toggleConfigBtn = document.getElementById('toggleConfigBtn');
      const configContent = document.getElementById('configContent');
