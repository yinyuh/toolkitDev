---
import Layout from "../../layouts/Layout.astro";
import VideoConverter from '../../components/tools/VideoConverter';

title: "在线视频格式转换工具"
description: "免费在线视频格式转换工具，支持 MP4, MKV, AVI, MOV, WebM 等格式互转，使用 FFmpeg WASM 技术，保护隐私。"
technologies: "FFmpeg WASM, React, TailwindCSS"
category: "video"
order: 16
---

<Layout title="在线视频格式转换工具" description="免费在线视频格式转换工具，支持 MP4, MKV, AVI, MOV, WebM 等格式互转，使用 FFmpeg WASM 技术，保护隐私。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        视频格式转换工具
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        基于 WebAssembly 技术的浏览器端视频格式转换工具。支持 MP4, MKV, AVI, MOV, WebM 等常见格式互转。
      </p>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden">
      <VideoConverter client:only="react" />
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="p-6 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-white">极速模式</h3>
        <p class="text-gray-600 dark:text-gray-400">支持 Copy Stream 模式，仅更换容器而不重新编码，秒级完成转换。</p>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
        <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-video"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><rect x="8" y="13" width="8" height="6" rx="1"/></svg>
        </div>
        <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-white">多格式支持</h3>
        <p class="text-gray-600 dark:text-gray-400">全面支持 MP4, MKV, AVI, MOV, WebM 等主流视频格式。</p>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-white">隐私安全</h3>
        <p class="text-gray-600 dark:text-gray-400">所有转换均在本地浏览器完成，您的视频文件永远不会上传到服务器。</p>
      </div>
    </div>
  </div>
</Layout>
