---
import Layout from "../../layouts/Layout.astro";
import ImageCropper from '../../components/tools/ImageCropper';
import AdSense from "../../components/ads/AdSense.astro";

title: "图片裁剪工具"
description: "免费在线图片裁剪工具，支持旋转、翻转、自由裁剪及常用比例预设，本地处理，保护隐私。"
technologies: "Cropper.js, React, TailwindCSS"
category: "image"
order: 100

const pageTitle = "图片裁剪工具";
const pageDescription = "免费在线图片裁剪工具，支持旋转、翻转、自由裁剪及常用比例预设，本地处理，保护隐私。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线图片裁剪工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/image-cropper",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "自由比例与固定比例裁剪",
        "支持旋转与翻转图像",
        "实时预览裁剪区域",
        "导出高质量结果图片",
        "浏览器本地处理，隐私安全",
        "免费在线使用"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "图片裁剪工具支持哪些格式？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "常见的 JPG、JPEG、PNG、WebP 图片都可以上传处理。完成裁剪后可下载并用于电商、社媒或日常设计场景。"
          }
        },
        {
          "@type": "Question",
          "name": "裁剪会影响原图清晰度吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "工具会在当前画布参数下进行导出，建议在裁剪时保持足够分辨率，并避免连续多次重复压缩，以获得更好的清晰度。"
          }
        },
        {
          "@type": "Question",
          "name": "图片会上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。所有裁剪与变换处理在本地浏览器中完成，不会将您的图片发送到服务器。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用图片裁剪工具",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传图片",
          "text": "选择本地图片文件，工具会自动加载并显示可裁剪区域。"
        },
        {
          "@type": "HowToStep",
          "name": "调整裁剪参数",
          "text": "通过拖拽、比例切换、旋转和翻转功能调整目标画面。"
        },
        {
          "@type": "HowToStep",
          "name": "导出图片",
          "text": "确认效果后下载裁剪结果，直接用于发布、打印或二次设计。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">图片裁剪工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          上传图片即可快速裁剪并导出。<span class="text-accent font-semibold">比例、旋转与翻转一步到位</span>，高效完成封面图与素材图处理。
        </p>
      </div>
      
      <div class="max-w-6xl mx-auto bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
        <ImageCropper client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么在线图片裁剪工具越来越常用？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              无论是电商主图、社交封面、简历证件照，还是内容配图，都需要把图片快速裁切到目标尺寸。传统软件操作步骤多，不适合高频轻量处理场景。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 图片裁剪工具</strong> 提供浏览器端一站式裁剪体验，支持自由拖拽、比例预设、旋转与翻转，帮助你在不安装复杂软件的前提下快速完成图像处理任务。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">✂️</div>
                <h3 class="text-xl font-semibold mb-2">自由与比例裁剪</h3>
                <p class="text-theme-secondary">支持自由裁剪与常见比例预设，适配头像、封面和商品图尺寸。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔄</div>
                <h3 class="text-xl font-semibold mb-2">旋转翻转调整</h3>
                <p class="text-theme-secondary">内置旋转和翻转能力，轻松修正方向并优化构图视角。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">👁️</div>
                <h3 class="text-xl font-semibold mb-2">实时预览效果</h3>
                <p class="text-theme-secondary">拖动裁剪框即可实时查看结果区域，减少反复导出重做。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">本地处理更安全</h3>
                <p class="text-theme-secondary">图像在浏览器中处理，不上传服务器，兼顾效率与隐私。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步完成图片裁剪</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">导入图片</h3>
                  <p class="text-theme-secondary">上传待处理图片，自动进入可编辑的裁剪画布。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">调整构图和比例</h3>
                  <p class="text-theme-secondary">拖拽裁剪框并结合旋转翻转，获得更符合场景的构图。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">下载成品</h3>
                  <p class="text-theme-secondary">确认预览效果后导出图片，直接用于上传、发布或设计。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>适合处理手机拍摄的大图吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  适合。若原图分辨率较高，建议先完成裁剪再进行压缩，可兼顾清晰度与文件体积。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>裁剪比例该怎么选？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  可按发布平台选择常用比例，例如 1:1 适合头像，16:9 适合封面，4:5 常见于内容流配图。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>处理后的图片有版权变化吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  工具仅提供技术处理能力，不改变图片原始版权归属。请确保你拥有合法使用权再发布。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关图像工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-background-remover" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片背景去除工具</div>
                  <div class="text-xs text-theme-secondary">AI 一键抠图并导出透明背景</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-watermark" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片水印处理工具</div>
                  <div class="text-xs text-theme-secondary">自定义文字水印并控制位置样式</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-compressor" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片压缩工具</div>
                  <div class="text-xs text-theme-secondary">在清晰度与体积间智能平衡</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
