---
import Layout from "../../layouts/Layout.astro";
import AdSense from "../../components/ads/AdSense.astro";

title: "图片水印处理工具"
description: "一个功能强大的在线图片水印处理工具，支持自定义水印文字、颜色、透明度、角度、位置等参数"
technologies: "图片水印处理"
category: "image"
order: 100

const pageTitle = "图片水印处理工具";
const pageDescription = "一个功能强大的在线图片水印处理工具，支持自定义水印文字、颜色、透明度、角度、位置等参数";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线图片水印处理工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/image-watermark",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "自定义文字水印内容",
        "水印颜色、透明度、角度可调",
        "单点或重复平铺水印模式",
        "多方位位置选择与间距控制",
        "实时预览并下载处理结果",
        "浏览器本地处理，隐私安全"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "水印处理后会覆盖原图吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。工具会生成新的带水印图片供你下载，原始图片文件不会被修改。"
          }
        },
        {
          "@type": "Question",
          "name": "如何避免水印过于抢眼？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "建议降低透明度、减小字体并适度增加间距。对于主图展示场景，可优先放置在边缘区域以减少内容遮挡。"
          }
        },
        {
          "@type": "Question",
          "name": "是否支持批量加水印？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "当前页面更适合单图精细处理。如果你需要批量操作，建议分次处理并统一参数，保持视觉一致性。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何给图片添加文字水印",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传原图",
          "text": "选择本地图片并加载到预览区域。"
        },
        {
          "@type": "HowToStep",
          "name": "配置水印样式",
          "text": "输入水印文字，设置颜色、透明度、角度、字号和位置。"
        },
        {
          "@type": "HowToStep",
          "name": "下载结果",
          "text": "确认预览效果后下载带水印图片，用于发布或存档。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">图片水印处理工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          为图片快速添加文字版权标识。<span class="text-accent font-semibold">位置、透明度和重复密度灵活可调</span>，发布与存档更安心。
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-6xl mx-auto">
        <div class="image-watermark-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Image Upload and Preview Section -->
            <div class="upload-preview-section">
              <h2 class="text-2xl font-semibold text-theme-primary mb-4">图片上传与预览</h2>
              
              <!-- File Input -->
              <div class="mb-6">
                <label class="block text-sm font-medium text-theme-primary mb-2">选择图片文件</label>
                <input 
                  type="file" 
                  id="imageUpload" 
                  accept="image/*" 
                  class="block w-full text-sm text-theme-primary file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-800"
                >
                <p class="mt-2 text-sm text-theme-secondary">支持 JPG、PNG、WEBP 等常见图片格式</p>
              </div>

              <!-- Image Preview -->
              <div id="imagePreviewContainer" class="relative border-2 border-dashed border-theme-secondary rounded-lg p-6 min-h-[500px] flex items-center justify-center">
                <div id="noImageState" class="text-center">
                  <svg class="mx-auto h-20 w-20 text-theme-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <p class="mt-2 text-sm text-theme-secondary">请选择一张图片以上传</p>
                </div>
                <canvas id="imagePreview" class="max-w-full max-h-[600px] hidden"></canvas>
              </div>

              <!-- Download Button -->
              <div class="mt-6 text-center">
                <button 
                  id="downloadButton" 
                  class="btn-theme px-6 py-3 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 mx-auto cursor-pointer"
                  disabled
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                  下载水印图片
                </button>
              </div>
            </div>

            <!-- Watermark Configuration Section -->
            <div class="watermark-config-section">
              <h2 class="text-2xl font-semibold text-theme-primary mb-4">水印配置</h2>

              <!-- Watermark Text -->
              <div class="mb-6">
                <label for="watermarkText" class="block text-sm font-medium text-theme-primary mb-2">水印文字</label>
                <input 
                  type="text" 
                  id="watermarkText" 
                  value="Sample Watermark" 
                  class="block w-full px-4 py-2 border border-theme-border rounded-lg shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-div-theme dark:text-theme-primary"
                >
              </div>

              <!-- Watermark Color -->
              <div class="mb-6">
                <label for="watermarkColor" class="block text-sm font-medium text-theme-primary mb-2">水印颜色</label>
                <div class="flex items-center gap-4">
                  <input 
                    type="color" 
                    id="watermarkColor" 
                    value="#000000" 
                    class="w-12 h-12 rounded-lg cursor-pointer"
                  >
                  <span id="colorValue" class="text-sm font-medium text-theme-primary">#000000</span>
                </div>
              </div>

              <!-- Watermark Opacity -->
              <div class="mb-6">
                <label for="watermarkOpacity" class="block text-sm font-medium text-theme-primary mb-2">
                  透明度: <span id="opacityValue">50%</span>
                </label>
                <input 
                  type="range" 
                  id="watermarkOpacity" 
                  min="0" 
                  max="100" 
                  value="50" 
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer"
                >
              </div>

              <!-- Watermark Angle -->
              <div class="mb-6">
                <label for="watermarkAngle" class="block text-sm font-medium text-theme-primary mb-2">
                  旋转角度: <span id="angleValue">30°</span>
                </label>
                <input 
                  type="range" 
                  id="watermarkAngle" 
                  min="0" 
                  max="360" 
                  value="30" 
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer"
                >
              </div>

              <!-- Watermark Spacing -->
              <div class="mb-6">
                <label for="watermarkSpacing" class="block text-sm font-medium text-theme-primary mb-2">
                  水印间隔: <span id="spacingValue">50px</span>
                </label>
                <input 
                  type="range" 
                  id="watermarkSpacing" 
                  min="20" 
                  max="200" 
                  value="50" 
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer"
                >
              </div>

              <!-- Watermark Font Size -->
              <div class="mb-6">
                <label for="watermarkFontSize" class="block text-sm font-medium text-theme-primary mb-2">
                  字体大小: <span id="fontSizeValue">24px</span>
                </label>
                <input 
                  type="range" 
                  id="watermarkFontSize" 
                  min="12" 
                  max="72" 
                  value="24" 
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer"
                >
              </div>

              <!-- Watermark Position -->
              <div class="mb-6">
                <label class="block text-sm font-medium text-theme-primary mb-2">水印位置</label>
                <div class="watermark-position-grid">
                  <!-- Top Row -->
                  <div class="flex justify-center gap-2 mb-2">
                    <button type="button" data-position="top-left" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">TL</button>
                    <button type="button" data-position="top-center" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">顶部</button>
                    <button type="button" data-position="top-right" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">TR</button>
                  </div>
                  
                  <!-- Middle Row -->
                  <div class="flex justify-between gap-2 mb-2">
                    <div class="flex flex-col gap-2">
                      <button type="button" data-position="left-top" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">左上角</button>
                      <button type="button" data-position="left-center" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">左侧</button>
                      <button type="button" data-position="left-bottom" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">LB</button>
                    </div>
                    
                    <div class="flex items-center">
                      <button type="button" data-position="center" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">中</button>
                    </div>
                    
                    <div class="flex flex-col gap-2">
                      <button type="button" data-position="right-top" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">右侧</button>
                      <button type="button" data-position="right-center" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">右</button>
                      <button type="button" data-position="right-bottom" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">RB</button>
                    </div>
                  </div>
                  
                  <!-- Bottom Row -->
                  <div class="flex justify-center gap-2">
                    <button type="button" data-position="bottom-left" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">BL</button>
                    <button type="button" data-position="bottom-center" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">底</button>
                    <button type="button" data-position="bottom-right" class="position-btn px-4 py-2 border border-theme-border rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">BR</button>
                  </div>
                </div>
                <input type="hidden" id="watermarkPosition" value="center">
              </div>

              <!-- Watermark Repeat -->
              <div class="mb-6">
                <div class="flex items-center justify-between mb-2">
                  <label for="watermarkRepeat" class="block text-sm font-medium text-theme-primary">重复水印</label>
                  <input 
                    type="checkbox" 
                    id="watermarkRepeat" 
                    class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-theme-border rounded dark:bg-div-theme dark:border-theme-border"
                  >
                </div>
                <input 
                  type="range" 
                  id="watermarkRepeatDensity" 
                  min="1" 
                  max="10" 
                  value="5" 
                  class="w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer"
                  disabled
                >
                <p class="mt-1 text-xs text-theme-secondary">重复密度: <span id="repeatDensityValue">5</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么图片发布前建议加水印？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              在社交平台、电商详情页和内容社区中，原创图片被二次搬运的情况很常见。加水印能够有效提升来源识别度，减少未经授权的传播风险。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 图片水印处理工具</strong> 提供可视化参数调整能力，你可以在本地浏览器中快速完成水印文字设置、位置布局和透明度控制，兼顾版权保护与画面美观。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🏷️</div>
                <h3 class="text-xl font-semibold mb-2">自定义文字水印</h3>
                <p class="text-theme-secondary">支持自由输入品牌名、账号名或版权声明，快速建立内容标识。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🎛️</div>
                <h3 class="text-xl font-semibold mb-2">样式参数可控</h3>
                <p class="text-theme-secondary">颜色、透明度、旋转角度、字号和间距均可调，满足多场景需求。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🧩</div>
                <h3 class="text-xl font-semibold mb-2">单点与平铺模式</h3>
                <p class="text-theme-secondary">可选择单个水印强调品牌，也可重复平铺提升防搬运能力。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">本地处理隐私安全</h3>
                <p class="text-theme-secondary">图片全程在浏览器端处理，不上传服务器，敏感素材也可安心使用。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步完成水印处理</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">上传图片</h3>
                  <p class="text-theme-secondary">导入待处理图片并在画布中预览原始效果。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">设置水印参数</h3>
                  <p class="text-theme-secondary">输入水印文字并调整位置、透明度、角度、字号和重复密度。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">导出结果</h3>
                  <p class="text-theme-secondary">确认效果后下载带水印图片，直接用于发布、授权或归档。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>水印放在中间还是边角更好？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  如果强调版权保护可放在中心偏透明区域；若更重视观感，建议放在边角并适当降低透明度。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>平铺水印会影响阅读吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  可通过增大间距和降低透明度减少遮挡。建议先预览并以目标平台实际展示效果为准。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>导出后颜色会变化吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  一般不会明显变化。若在不同设备显示差异较大，通常与屏幕色彩管理和平台压缩策略有关。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关图像工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-cropper" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片裁剪工具</div>
                  <div class="text-xs text-theme-secondary">自由裁剪并支持比例预设</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-background-remover" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片背景去除工具</div>
                  <div class="text-xs text-theme-secondary">AI 一键去背景并导出透明图</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-compressor" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片压缩工具</div>
                  <div class="text-xs text-theme-secondary">降低图片体积并保持清晰度</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script>
    // Image Watermark Tool functionality
    document.addEventListener('DOMContentLoaded', function() {
      const imageUpload = document.getElementById('imageUpload');
      const imagePreview = document.getElementById('imagePreview');
      const noImageState = document.getElementById('noImageState');
      const downloadButton = document.getElementById('downloadButton');
      
      const watermarkText = document.getElementById('watermarkText');
      const watermarkColor = document.getElementById('watermarkColor');
      const watermarkOpacity = document.getElementById('watermarkOpacity');
      const watermarkAngle = document.getElementById('watermarkAngle');
      const watermarkSpacing = document.getElementById('watermarkSpacing');
      const watermarkFontSize = document.getElementById('watermarkFontSize');
      const watermarkPosition = document.getElementById('watermarkPosition');
      const watermarkRepeat = document.getElementById('watermarkRepeat');
      const watermarkRepeatDensity = document.getElementById('watermarkRepeatDensity');
      
      const colorValue = document.getElementById('colorValue');
      const opacityValue = document.getElementById('opacityValue');
      const angleValue = document.getElementById('angleValue');
      const spacingValue = document.getElementById('spacingValue');
      const fontSizeValue = document.getElementById('fontSizeValue');
      const repeatDensityValue = document.getElementById('repeatDensityValue');
      
      let uploadedImage = null;
      let canvasContext = null;
      
      // Initialize canvas context
      if (imagePreview) {
        canvasContext = imagePreview.getContext('2d');
      }
      
      // File input change event
      if (imageUpload) {
        imageUpload.addEventListener('change', function(e) {
          const file = e.target.files[0];
          if (!file) return;
          
          // Check if file is an image
          if (!file.type.startsWith('image/')) {
            alert('请选择图片文件！');
            this.value = '';
            return;
          }
          
          const reader = new FileReader();
          reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
              uploadedImage = img;
              if (noImageState) {
                noImageState.classList.add('hidden');
              }
              if (imagePreview) {
                imagePreview.classList.remove('hidden');
                imagePreview.width = img.width;
                imagePreview.height = img.height;
              }
              if (downloadButton) {
                downloadButton.disabled = false;
              }
              // 确保角度值显示正确
              if (angleValue) {
                angleValue.textContent = '30°';
              }
              // 自动更新预览，显示图片和水印
              updatePreview();
            };
            img.src = e.target.result;
          };
          reader.readAsDataURL(file);
        });
      }
      
      // Update color value display
      if (watermarkColor && colorValue) {
        watermarkColor.addEventListener('input', function() {
          colorValue.textContent = this.value;
          updatePreview();
        });
      }
      
      // Update opacity value display
      if (watermarkOpacity && opacityValue) {
        watermarkOpacity.addEventListener('input', function() {
          opacityValue.textContent = this.value + '%';
          updatePreview();
        });
      }
      
      // Update angle value display
      if (watermarkAngle && angleValue) {
        watermarkAngle.addEventListener('input', function() {
          angleValue.textContent = this.value + '°';
          updatePreview();
        });
      }
      
      // Update spacing value display
      if (watermarkSpacing && spacingValue) {
        watermarkSpacing.addEventListener('input', function() {
          spacingValue.textContent = this.value + 'px';
          updatePreview();
        });
      }
      
      // Update font size value display
      if (watermarkFontSize && fontSizeValue) {
        watermarkFontSize.addEventListener('input', function() {
          fontSizeValue.textContent = this.value + 'px';
          updatePreview();
        });
      }
      
      // Update repeat density value display
      if (watermarkRepeatDensity && repeatDensityValue) {
        watermarkRepeatDensity.addEventListener('input', function() {
          repeatDensityValue.textContent = this.value;
          updatePreview();
        });
      }
      
      // Toggle repeat density slider enabled state
      if (watermarkRepeat && watermarkRepeatDensity) {
        watermarkRepeat.addEventListener('change', function() {
          watermarkRepeatDensity.disabled = !this.checked;
          updatePreview();
        });
      }
      
      // Update preview on other settings changes
      const settingsElements = [
        watermarkText
      ];
      
      settingsElements.forEach(element => {
        if (element) {
          element.addEventListener('input', updatePreview);
          element.addEventListener('change', updatePreview);
        }
      });
      
      // Handle position buttons
      const positionButtons = document.querySelectorAll('.position-btn');
      if (positionButtons.length > 0) {
        // Set initial active state for center position
        const centerButton = document.querySelector('.position-btn[data-position="center"]');
        if (centerButton) {
          centerButton.classList.add('bg-blue-500', 'text-white', 'border-blue-500');
        }
        
        // Add click event listeners to position buttons
        positionButtons.forEach(button => {
          button.addEventListener('click', function() {
            // Remove active class from all buttons
            positionButtons.forEach(btn => {
              btn.classList.remove('bg-blue-500', 'text-white', 'border-blue-500');
            });
            
            // Add active class to clicked button
            this.classList.add('bg-blue-500', 'text-white', 'border-blue-500');
            
            // Update hidden input value
            if (watermarkPosition) {
              watermarkPosition.value = this.dataset.position;
              updatePreview();
            }
          });
        });
      }
      
      // Update preview function
      function updatePreview() {
        if (!uploadedImage || !canvasContext || !imagePreview) return;
        
        // Clear canvas
        canvasContext.clearRect(0, 0, imagePreview.width, imagePreview.height);
        
        // Draw original image
        canvasContext.drawImage(uploadedImage, 0, 0, imagePreview.width, imagePreview.height);
        
        // Get watermark settings
        const text = watermarkText ? watermarkText.value : 'Sample Watermark';
        const color = watermarkColor ? watermarkColor.value : '#000000';
        const opacity = watermarkOpacity ? parseFloat(watermarkOpacity.value) / 100 : 0.5;
        const angle = watermarkAngle ? parseFloat(watermarkAngle.value) : 0;
        const spacing = watermarkSpacing ? parseFloat(watermarkSpacing.value) : 50;
        const fontSize = watermarkFontSize ? parseFloat(watermarkFontSize.value) : 24;
        const position = watermarkPosition ? watermarkPosition.value : 'center';
        const repeat = watermarkRepeat ? watermarkRepeat.checked : false;
        const repeatDensity = watermarkRepeatDensity ? parseFloat(watermarkRepeatDensity.value) : 5;
        
        // Set watermark style
        canvasContext.font = fontSize + 'px Arial';
        canvasContext.fillStyle = color;
        canvasContext.globalAlpha = opacity;
        canvasContext.textAlign = 'center';
        canvasContext.textBaseline = 'middle';
        
        if (repeat) {
          // Draw repeated watermarks
          const densityFactor = 11 - repeatDensity; // Invert density (higher value = more dense)
          const stepX = spacing * densityFactor;
          const stepY = spacing * densityFactor;
          
          for (let x = -stepX; x < imagePreview.width + stepX; x += stepX) {
            for (let y = -stepY; y < imagePreview.height + stepY; y += stepY) {
              drawWatermark(x, y, text, angle);
            }
          }
        } else {
          // Draw single watermark at selected position
          let posX, posY;
          
          switch (position) {
            case 'top-left':
              posX = fontSize * 1.5;
              posY = fontSize * 1.5;
              canvasContext.textAlign = 'left';
              canvasContext.textBaseline = 'top';
              break;
            case 'top-center':
              posX = imagePreview.width / 2;
              posY = fontSize * 1.5;
              canvasContext.textAlign = 'center';
              canvasContext.textBaseline = 'top';
              break;
            case 'top-right':
              posX = imagePreview.width - fontSize * 1.5;
              posY = fontSize * 1.5;
              canvasContext.textAlign = 'right';
              canvasContext.textBaseline = 'top';
              break;
            case 'right-top':
              posX = imagePreview.width - fontSize * 1.5;
              posY = imagePreview.height / 4;
              canvasContext.textAlign = 'right';
              canvasContext.textBaseline = 'middle';
              break;
            case 'right-center':
              posX = imagePreview.width - fontSize * 1.5;
              posY = imagePreview.height / 2;
              canvasContext.textAlign = 'right';
              canvasContext.textBaseline = 'middle';
              break;
            case 'right-bottom':
              posX = imagePreview.width - fontSize * 1.5;
              posY = imagePreview.height * 3 / 4;
              canvasContext.textAlign = 'right';
              canvasContext.textBaseline = 'middle';
              break;
            case 'bottom-right':
              posX = imagePreview.width - fontSize * 1.5;
              posY = imagePreview.height - fontSize * 1.5;
              canvasContext.textAlign = 'right';
              canvasContext.textBaseline = 'bottom';
              break;
            case 'bottom-center':
              posX = imagePreview.width / 2;
              posY = imagePreview.height - fontSize * 1.5;
              canvasContext.textAlign = 'center';
              canvasContext.textBaseline = 'bottom';
              break;
            case 'bottom-left':
              posX = fontSize * 1.5;
              posY = imagePreview.height - fontSize * 1.5;
              canvasContext.textAlign = 'left';
              canvasContext.textBaseline = 'bottom';
              break;
            case 'left-bottom':
              posX = fontSize * 1.5;
              posY = imagePreview.height * 3 / 4;
              canvasContext.textAlign = 'left';
              canvasContext.textBaseline = 'middle';
              break;
            case 'left-center':
              posX = fontSize * 1.5;
              posY = imagePreview.height / 2;
              canvasContext.textAlign = 'left';
              canvasContext.textBaseline = 'middle';
              break;
            case 'left-top':
              posX = fontSize * 1.5;
              posY = imagePreview.height / 4;
              canvasContext.textAlign = 'left';
              canvasContext.textBaseline = 'middle';
              break;
            case 'center':
            default:
              posX = imagePreview.width / 2;
              posY = imagePreview.height / 2;
              canvasContext.textAlign = 'center';
              canvasContext.textBaseline = 'middle';
              break;
          }
          
          drawWatermark(posX, posY, text, angle);
        }
        
        // Reset global alpha
        canvasContext.globalAlpha = 1;
      }
      
      // Draw watermark function
      function drawWatermark(x, y, text, angle) {
        if (!canvasContext) return;
        
        canvasContext.save();
        canvasContext.translate(x, y);
        canvasContext.rotate(angle * Math.PI / 180);
        canvasContext.fillText(text, 0, 0);
        canvasContext.restore();
      }
      
      // Download button click event
      if (downloadButton) {
        downloadButton.addEventListener('click', function() {
          if (!uploadedImage || !imagePreview) return;
          
          // Create download link
          const link = document.createElement('a');
          link.download = 'watermarked-image.png';
          link.href = imagePreview.toDataURL('image/png');
          link.click();
        });
      }
    });
  </script>
</Layout>
