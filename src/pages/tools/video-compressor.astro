---
import Layout from "../../layouts/Layout.astro";
import VideoCompressor from '../../components/tools/VideoCompressor';
import AdSense from "../../components/ads/AdSense.astro";

title: "在线视频压缩工具 - 免费无损压缩MP4/MOV/WebM"
description: "免费在线视频压缩工具，基于 FFmpeg WASM 技术，支持 MP4、MOV、WebM 等格式。无需上传服务器，浏览器本地压缩，隐私安全，快速减小文件体积。"
technologies: "FFmpeg WASM, React, TailwindCSS"
category: "video"
order: 8

const pageTitle = "在线视频压缩工具 - 免费无损压缩MP4/MOV/WebM";
const pageDescription = "免费在线视频压缩工具，基于 FFmpeg WASM 技术，支持 MP4、MOV、WebM 等格式。无需上传服务器，浏览器本地压缩，隐私安全，快速减小文件体积。";
const keywords = "视频压缩,在线视频压缩,MP4压缩,MOV压缩,WebM压缩,FFmpeg WASM,本地压缩工具";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线视频压缩工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/video-compressor",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "浏览器本地视频压缩",
        "支持 MP4、MOV、WEBM 等格式",
        "自定义压缩等级和参数",
        "兼顾画质与文件体积",
        "无需上传服务器，隐私安全",
        "压缩后可预览与下载"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "视频会上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。本工具使用 FFmpeg WASM 在浏览器本地执行压缩，视频文件不会上传到服务器，适合处理隐私或商业敏感内容。"
          }
        },
        {
          "@type": "Question",
          "name": "支持哪些视频格式压缩？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "支持常见的 MP4、MOV、WebM、AVI、MKV 等格式。具体可用性取决于浏览器解码能力与设备性能。"
          }
        },
        {
          "@type": "Question",
          "name": "如何压得更小但尽量保持清晰？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "建议优先降低码率和分辨率，再适度降低帧率。先进行一次中等压缩预览效果，再逐步调参，可以获得更好的画质与体积平衡。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何在线压缩视频",
      "step": [
        {
          "@type": "HowToStep",
          "name": "上传视频文件",
          "text": "点击上传区域选择本地视频文件，或拖拽文件到页面中。"
        },
        {
          "@type": "HowToStep",
          "name": "设置压缩参数",
          "text": "根据用途调整分辨率、码率、帧率或压缩等级，预估目标体积。"
        },
        {
          "@type": "HowToStep",
          "name": "开始压缩并下载",
          "text": "点击开始压缩，等待处理完成后预览结果并下载到本地。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">
        在线视频压缩工具
      </h1>
      <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
        基于 FFmpeg WASM 的高性能压缩引擎，支持多格式视频压缩。<span class="text-accent font-semibold">文件全程本地处理</span>，无需上传服务器，兼顾隐私与效率。
      </p>
    </div>
    
    <div class="bg-theme-surface rounded-2xl shadow-xl overflow-hidden mb-16 border border-theme-border">
      <VideoCompressor client:only="react" />
    </div>

    <div class="my-8">
      <AdSense />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary">
      <div class="lg:col-span-2 space-y-12">
        <section class="prose dark:prose-invert max-w-none">
          <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
            <span class="text-accent">#</span> 为什么选择在线视频压缩工具？
          </h2>
          <p class="text-lg leading-relaxed text-theme-secondary">
            视频体积过大是内容分发中最常见的问题之一。无论是发送给客户、上传社媒，还是归档保存，超大文件都会导致上传缓慢、传输失败或平台二次压缩造成画质损失。
          </p>
          <p class="text-lg leading-relaxed text-theme-secondary mt-4">
            <strong>Toolkit.ren 的在线视频压缩工具</strong> 基于 WebAssembly 技术将 FFmpeg 引擎直接运行在浏览器中，实现 <span class="font-bold text-accent">零上传本地压缩</span>。您可以更精细地控制码率、分辨率和压缩策略，既减小体积，也尽可能保留清晰度。
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
              <div class="text-3xl mb-3">🔒</div>
              <h3 class="text-xl font-semibold mb-2">本地压缩更安全</h3>
              <p class="text-theme-secondary">视频不会上传到云端，适合处理隐私视频、内部培训素材或商业演示文件。</p>
            </div>
            <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
              <div class="text-3xl mb-3">⚙️</div>
              <h3 class="text-xl font-semibold mb-2">参数可控更专业</h3>
              <p class="text-theme-secondary">可根据用途调节分辨率、帧率与码率，兼顾观看清晰度和目标体积。</p>
            </div>
            <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
              <div class="text-3xl mb-3">🚀</div>
              <h3 class="text-xl font-semibold mb-2">省去上传下载等待</h3>
              <p class="text-theme-secondary">直接利用本地设备算力处理大文件，减少网络瓶颈，压缩流程更流畅。</p>
            </div>
            <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
              <div class="text-3xl mb-3">🎯</div>
              <h3 class="text-xl font-semibold mb-2">适配多平台发布</h3>
              <p class="text-theme-secondary">针对社交媒体、网页和即时通讯不同体积限制，快速输出更合适的视频版本。</p>
            </div>
          </div>
        </section>

        <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
          <h2 class="text-2xl font-bold text-theme-primary mb-6">如何压缩视频文件？</h2>
          <ol class="space-y-6">
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
              <div>
                <h3 class="text-lg font-semibold mb-1">上传本地视频</h3>
                <p class="text-theme-secondary">导入 MP4、MOV、WebM 等视频文件，支持拖拽上传，快速开始处理。</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
              <div>
                <h3 class="text-lg font-semibold mb-1">设置压缩目标</h3>
                <p class="text-theme-secondary">按需求选择压缩强度或手动参数。建议先中等压缩预览，再按体积目标微调。</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
              <div>
                <h3 class="text-lg font-semibold mb-1">预览并下载结果</h3>
                <p class="text-theme-secondary">压缩完成后查看体积变化和画质效果，确认满意后下载到本地即可使用。</p>
              </div>
            </li>
          </ol>
        </section>
      </div>

      <div class="lg:col-span-1 space-y-8">
        <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
          <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
          <div class="space-y-4">
            <details class="group">
              <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                <span>压缩后画面变模糊怎么办？</span>
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                适当提高码率或保留更高分辨率，避免同时大幅降低帧率与分辨率。建议分步测试，找到清晰度与体积的平衡点。
              </p>
            </details>
            <details class="group pt-4 border-t border-theme-border">
              <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                <span>为什么大视频压缩时间较长？</span>
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                压缩速度受视频时长、分辨率和设备 CPU 性能影响。4K 或高帧率视频需要更长处理时间，属于正常现象。
              </p>
            </details>
            <details class="group pt-4 border-t border-theme-border">
              <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                <span>手机上可以使用吗？</span>
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                可以使用，但移动设备内存和算力有限。建议优先处理较短视频，并选择适中的压缩参数，以获得更稳定体验。
              </p>
            </details>
          </div>
        </div>

        <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
          <h3 class="text-lg font-bold text-theme-primary mb-4">相关多媒体工具</h3>
          <ul class="space-y-3">
            <li>
              <a href="/tools/video-to-gif" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                <div class="font-medium text-theme-primary group-hover:text-accent">视频转 GIF</div>
                <div class="text-xs text-theme-secondary">截取片段并导出为 GIF 动图</div>
              </a>
            </li>
            <li>
              <a href="/tools/video-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                <div class="font-medium text-theme-primary group-hover:text-accent">视频格式转换</div>
                <div class="text-xs text-theme-secondary">支持多种格式互转与导出</div>
              </a>
            </li>
            <li>
              <a href="/tools/audio-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                <div class="font-medium text-theme-primary group-hover:text-accent">音频格式转换</div>
                <div class="text-xs text-theme-secondary">提取并转换音频格式</div>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <style>
      details > summary {
        list-style: none;
      }
      details > summary::-webkit-details-marker {
        display: none;
      }
      details[open] summary ~ * {
        animation: fadeIn 0.3s ease-in-out;
      }
      @keyframes fadeIn {
        0% { opacity: 0; transform: translateY(-5px); }
        100% { opacity: 1; transform: translateY(0); }
      }
    </style>
  </div>
</Layout>
