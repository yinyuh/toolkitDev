---
import Layout from "../../layouts/Layout.astro";
title: "文本计数器"
description: "统计文本中的字符数、单词数、句子数等信息的工具"
technologies: "HTML, CSS, JavaScript"
category: "text"
---

<Layout title="文本计数器" description="统计文本中的字符数、单词数、句子数等信息的工具">
  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Tool Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">文本计数器</h1>
        <p class="text-theme-secondary max-w-3xl mx-auto">
          统计文本中的字符数、单词数、句子数等信息的工具。
        </p>
      </div>

      <!-- Tool Content -->
      <div class="max-w-4xl mx-auto">
        <div class="text-counter-container bg-div-theme rounded-xl p-8 shadow-lg border border-div-theme">
          <textarea 
              class="text-input w-full min-h-[200px] p-4 bg-theme-secondary border-none rounded-lg text-theme-primary text-base resize-vertical mb-6 focus:outline-none focus:ring-2 focus:ring-blue-500"
              id="textInput" 
              placeholder="在这里输入或粘贴文本..."
          >这是一个示例文本，用于演示文本计数器的功能。

文本计数器可以统计：
- 字符数
- 单词数
- 句子数
- 段落数

试试输入你自己的文本吧！</textarea>
          
          <div class="stats-container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
            <div class="stat-card bg-theme-secondary p-4 rounded-lg text-center">
                <div class="stat-value text-2xl font-bold text-blue-500" id="charCount">0</div>
                <div class="stat-label text-theme-primary text-sm mt-1">字符数</div>
            </div>
            <div class="stat-card bg-theme-secondary p-4 rounded-lg text-center">
                <div class="stat-value text-2xl font-bold text-blue-500" id="charCountNoSpaces">0</div>
                <div class="stat-label text-theme-primary text-sm mt-1">不含空格字符数</div>
            </div>
            <div class="stat-card bg-theme-secondary p-4 rounded-lg text-center">
                <div class="stat-value text-2xl font-bold text-blue-500" id="wordCount">0</div>
                <div class="stat-label text-theme-primary text-sm mt-1">单词数</div>
            </div>
            <div class="stat-card bg-theme-secondary p-4 rounded-lg text-center">
                <div class="stat-value text-2xl font-bold text-blue-500" id="sentenceCount">0</div>
                <div class="stat-label text-theme-primary text-sm mt-1">句子数</div>
            </div>
            <div class="stat-card bg-theme-secondary p-4 rounded-lg text-center">
                <div class="stat-value text-2xl font-bold text-blue-500" id="paragraphCount">0</div>
                <div class="stat-label text-theme-primary text-sm mt-1">段落数</div>
            </div>
            <div class="stat-card bg-theme-secondary p-4 rounded-lg text-center">
                <div class="stat-value text-2xl font-bold text-blue-500" id="lineCount">0</div>
                <div class="stat-label text-theme-primary text-sm mt-1">行数</div>
            </div>
          </div>
          
          <div class="controls flex justify-start flex-wrap gap-3">
              <button id="clearBtn" class="control-btn clear-btn btn-theme px-5 py-2.5 rounded-lg transition-colors">清空文本</button>
              <button id="copyBtn" class="control-btn copy-btn btn-theme px-5 py-2.5 rounded-lg transition-colors">复制文本</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const textInput = document.getElementById('textInput');
    
    // 初始计算
    calculateStats();
    
    // 监听文本输入
    textInput.addEventListener('input', calculateStats);
    
    // 清空按钮事件
    document.getElementById('clearBtn').addEventListener('click', () => {
        textInput.value = '';
        calculateStats();
    });
    
    // 复制按钮事件
    document.getElementById('copyBtn').addEventListener('click', () => {
        textInput.select();
        document.execCommand('copy');
        alert('文本已复制到剪贴板！');
    });
    
    function calculateStats() {
        const text = textInput.value;
        
        // 字符数
        const charCount = text.length;
        
        // 不含空格字符数
        const charCountNoSpaces = text.replace(/\s/g, '').length;
        
        // 单词数（简单计算：按空格分割，过滤空字符串）
        const words = text.trim().split(/\s+/);
        const wordCount = text.trim() === '' ? 0 : words.length;
        
        // 句子数（按句号、问号、感叹号分割）
        const sentences = text.split(/[.!?]+/).filter(s => s.trim() !== '');
        const sentenceCount = sentences.length;
        
        // 段落数（按空行分割）
        const paragraphs = text.split(/\n\s*\n/).filter(p => p.trim() !== '');
        const paragraphCount = paragraphs.length;
        
        // 行数
        const lines = text.split('\n');
        const lineCount = lines.length;
        
        // 更新统计结果
        document.getElementById('charCount').textContent = charCount;
        document.getElementById('charCountNoSpaces').textContent = charCountNoSpaces;
        document.getElementById('wordCount').textContent = wordCount;
        document.getElementById('sentenceCount').textContent = sentenceCount;
        document.getElementById('paragraphCount').textContent = paragraphCount;
        document.getElementById('lineCount').textContent = lineCount;
    }
  </script>
</Layout>