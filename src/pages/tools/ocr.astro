---
import Layout from "../../layouts/Layout.astro";
import OcrTool from '../../components/tools/OcrTool';
import AdSense from "../../components/ads/AdSense.astro";

title: "AI文字识别 (OCR) 工具"
description: "基于Tesseract.js的免费在线OCR工具，支持图片转文字，多语言识别，纯本地处理，保护隐私。"
technologies: "Tesseract.js, React, TailwindCSS"
category: "developer"
order: 100

const pageTitle = "AI文字识别 (OCR) 工具";
const pageDescription = "基于Tesseract.js的免费在线OCR工具，支持图片转文字，多语言识别，纯本地处理，保护隐私。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "AI文字识别 (OCR) 工具",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/ocr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      },
      "featureList": [
        "图片一键识别提取文字",
        "支持中英等多语言识别",
        "可粘贴图片或上传图片",
        "识别结果支持复制导出",
        "浏览器本地执行，隐私安全",
        "免费在线使用"
      ],
      "author": {
        "@type": "Organization",
        "name": "Toolkit.ren"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "OCR 工具适合识别哪些图片？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "适合文字清晰、对比度较高的截图、扫描件和文档照片。若图片模糊或倾斜严重，识别准确率会下降。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么识别结果会有错字？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "识别准确率受字体、清晰度、光照和背景干扰影响。建议先裁剪无关区域、提升对比度，并选择正确的识别语言。"
          }
        },
        {
          "@type": "Question",
          "name": "我的图片会上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不会。OCR 识别在浏览器端完成，图片和文本数据不会主动上传到远程服务器。"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "如何使用 AI OCR 识别图片文字",
      "step": [
        {
          "@type": "HowToStep",
          "name": "导入图片",
          "text": "上传包含文字的图片，或直接在页面粘贴截图。"
        },
        {
          "@type": "HowToStep",
          "name": "选择语言并识别",
          "text": "设置目标语言后开始识别，等待引擎完成文本提取。"
        },
        {
          "@type": "HowToStep",
          "name": "复制结果",
          "text": "识别完成后校对文本内容，并一键复制用于文档整理或二次编辑。"
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">AI 文字识别 (OCR)</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          上传或粘贴图片即可提取文字内容。<span class="text-accent font-semibold">多语言识别与本地处理兼顾效率和隐私</span>，适合文档整理与信息录入。
        </p>
      </div>
      
      <div class="max-w-6xl mx-auto bg-theme-primary rounded-2xl shadow-xl overflow-hidden">
        <OcrTool client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么 OCR 文字识别能提升效率？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              在日常办公与学习中，图片里的文字常常难以直接复制，比如课件截图、纸质文档拍照、合同扫描件和票据信息。手动录入不仅耗时，还容易出错。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren OCR 工具</strong> 基于浏览器端识别能力，帮助你把图片文字快速提取为可编辑文本。你可以进一步复制、整理、翻译或导入其他系统，显著减少重复录入工作。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🧠</div>
                <h3 class="text-xl font-semibold mb-2">智能文字提取</h3>
                <p class="text-theme-secondary">对截图和文档照片中的文字进行自动识别，减少手工录入。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🌍</div>
                <h3 class="text-xl font-semibold mb-2">多语言支持</h3>
                <p class="text-theme-secondary">支持中文、英文等多语言识别场景，适合跨语种内容整理。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📋</div>
                <h3 class="text-xl font-semibold mb-2">结果可复制编辑</h3>
                <p class="text-theme-secondary">识别完成后可直接复制，便于粘贴到文档、表格或知识库。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">本地处理隐私友好</h3>
                <p class="text-theme-secondary">在浏览器内完成识别流程，敏感资料无需上传到第三方平台。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">三步完成 OCR 识别</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">导入图片</h3>
                  <p class="text-theme-secondary">上传文档照片、截图或扫描图，尽量保证文字清晰可见。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">开始识别</h3>
                  <p class="text-theme-secondary">选择语言后执行 OCR，等待识别引擎提取文本内容。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">复制并校对</h3>
                  <p class="text-theme-secondary">将结果复制到目标文档，建议快速校对专有名词和数字信息。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>手写体可以识别吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  可以识别部分工整手写体，但准确率通常低于印刷体。建议提高对比度并尽量保持字迹清晰。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>识别速度取决于什么？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  速度主要受图片分辨率、文字密度和设备性能影响。大图建议先裁剪重点区域再识别。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>可以离线使用吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  首次使用通常需要加载识别模型资源，后续在缓存有效时可更快完成识别流程。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关工具推荐</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-cropper" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片裁剪工具</div>
                  <div class="text-xs text-theme-secondary">裁剪出重点内容后再进行 OCR</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-background-remover" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片背景去除工具</div>
                  <div class="text-xs text-theme-secondary">先清理背景再做内容提取更清晰</div>
                </a>
              </li>
              <li>
                <a href="/tools/text-formatter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">文本格式化工具</div>
                  <div class="text-xs text-theme-secondary">OCR 后整理文本结构更高效</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] summary ~ * {
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
