---
import Layout from "../../layouts/Layout.astro";
import ImageToPdfCard from '../../components/features/image-conversion/ImageToPdfCard';
import AdSense from "../../components/ads/AdSense.astro";

title: "在线图片转PDF工具 - 免费合并/分页批量转换"
description: "免费在线图片转PDF工具，支持 JPG/PNG/WebP 等格式批量转为 PDF。合并模式将多图拼为连续PDF，分页模式独立生成并 ZIP 打包下载。浏览器本地处理，安全高效。"
technologies: "jsPDF, Canvas API, React, TailwindCSS, JSZip"
category: "image"
order: 16

const pageTitle = "在线图片转PDF工具 - 免费合并/分页批量转换";
const pageDescription = "免费在线图片转PDF工具，支持 JPG/PNG/WebP 等格式批量转为 PDF。合并模式将多图拼为连续PDF，分页模式独立生成并 ZIP 打包下载。浏览器本地处理，安全高效。";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "在线图片转PDF工具",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "description": pageDescription,
      "url": "https://www.toolkit.ren/tools/image-to-pdf",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "CNY" },
      "featureList": [
        "支持 JPG、PNG、WebP、BMP、GIF 等主流格式",
        "合并模式将多图拼为单一 PDF",
        "分页模式每图独立 PDF 并 ZIP 打包",
        "自定义页面尺寸、对齐方式、页边距",
        "浏览器本地处理，图片不离开设备",
        "免费使用，无需注册"
      ],
      "author": { "@type": "Organization", "name": "Toolkit.ren" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "图片转PDF需要上传到服务器吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "不需要。所有转换在浏览器内通过 jsPDF 库本地完成，图片数据不会离开您的设备，隐私安全有保障。"
          }
        },
        {
          "@type": "Question",
          "name": "合并模式和分页模式有什么区别？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "合并模式将所有图片按顺序拼接为一个连续 PDF 文件，适合制作图册、报告等；分页模式为每张图片独立生成一个 PDF，最终以 ZIP 压缩包下载，适合批量归档。"
          }
        },
        {
          "@type": "Question",
          "name": "生成的PDF兼容性如何？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "生成的 PDF 符合标准规范，兼容 Adobe Acrobat、福昕阅读器、Chrome/Edge 内置阅读器等主流 PDF 软件，无内容缺失或排版错乱问题。"
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-theme-primary min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-theme-primary mb-4">在线图片转PDF工具</h1>
        <p class="text-xl text-theme-secondary max-w-3xl mx-auto">
          支持 JPG、PNG、WebP 等图片格式转为 PDF，<span class="text-accent font-semibold">合并或分页模式自由切换</span>，浏览器本地处理更安全。
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <ImageToPdfCard client:only="react" />
      </div>

      <div class="my-8 max-w-6xl mx-auto">
        <AdSense />
      </div>

      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 text-theme-primary mt-12">
        <div class="lg:col-span-2 space-y-12">
          <section class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold text-theme-primary mb-6 flex items-center gap-2">
              <span class="text-accent">#</span> 为什么需要在线图片转PDF工具？
            </h2>
            <p class="text-lg leading-relaxed text-theme-secondary">
              在日常工作和学习中，经常需要将多张图片整理为一个 PDF 文档——制作作品集、整理扫描件、归档合同、分享设计稿。逐一使用本地软件转换不仅耗时，还需安装庞大的 PDF 编辑器。
            </p>
            <p class="text-lg leading-relaxed text-theme-secondary mt-4">
              <strong>Toolkit.ren 在线图片转PDF工具</strong> 让你在浏览器中直接完成图片到 PDF 的转换。支持合并模式（多图拼为一个连续PDF）和分页模式（每图独立PDF并ZIP打包），灵活适应不同使用场景。所有处理均在本地完成，文件不会上传到任何服务器。
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-theme-primary mb-6">核心功能亮点</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📄</div>
                <h3 class="text-xl font-semibold mb-2">双模式自由切换</h3>
                <p class="text-theme-secondary">合并模式拼接为单一 PDF，分页模式逐页导出并 ZIP 打包，满足不同场景需求。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">📐</div>
                <h3 class="text-xl font-semibold mb-2">灵活页面布局</h3>
                <p class="text-theme-secondary">支持自适应、A4、A3、Letter 等标准纸张尺寸，提供居中、居左、填充三种对齐方式。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">⬆️⬇️</div>
                <h3 class="text-xl font-semibold mb-2">自由调整排列顺序</h3>
                <p class="text-theme-secondary">通过上下箭头按钮调整图片在 PDF 中的排列顺序，轻松控制最终输出页面序列。</p>
              </div>
              <div class="bg-theme-surface p-6 rounded-xl border border-theme-border shadow-sm hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">🔒</div>
                <h3 class="text-xl font-semibold mb-2">本地处理更隐私</h3>
                <p class="text-theme-secondary">所有 PDF 生成流程在浏览器端完成，图片数据不会离开你的设备，敏感文档放心使用。</p>
              </div>
            </div>
          </section>

          <section class="bg-theme-surface p-8 rounded-2xl border border-theme-border">
            <h2 class="text-2xl font-bold text-theme-primary mb-6">使用步骤</h2>
            <ol class="space-y-6">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">1</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">上传图片文件</h3>
                  <p class="text-theme-secondary">选择一张或多张图片，支持 JPG、PNG、WebP、BMP、GIF 等常用格式，单文件上限 20MB。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">2</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">选择模式与设置</h3>
                  <p class="text-theme-secondary">在合并/分页模式间切换，调整页面尺寸、对齐方式、页边距等参数，通过箭头调整图片排列顺序。</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-accent text-white font-bold">3</span>
                <div>
                  <h3 class="text-lg font-semibold mb-1">生成并下载 PDF</h3>
                  <p class="text-theme-secondary">点击「生成 PDF」按钮开始转换，完成后即可下载 PDF 文件或 ZIP 压缩包。</p>
                </div>
              </li>
            </ol>
          </section>
        </div>

        <div class="lg:col-span-1 space-y-8">
          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border">
            <h3 class="text-xl font-bold text-theme-primary mb-4">常见问题 (FAQ)</h3>
            <div class="space-y-4">
              <details class="group">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>支持哪些图片格式？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  支持 JPG、PNG、WebP、BMP、GIF、SVG 等主流静态图片格式，以及 HEIC/HEIF 格式（需浏览器原生支持）。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>单次最多能处理多少张图片？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  单张图片不超过 20MB，批量总大小不超过 200MB，不限数量。建议 100 张内可获得最佳体验。
                </p>
              </details>
              <details class="group pt-4 border-t border-theme-border">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-theme-primary hover:text-accent">
                  <span>生成的PDF能打印吗？</span>
                  <span class="transition group-open:rotate-180">
                    <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <p class="text-theme-secondary mt-3 text-sm leading-relaxed group-open:animate-fadeIn">
                  完全可以。生成的 PDF 为标准格式，可直接打印输出。如对打印精度有要求，建议选择高清存档场景下的画质参数。
                </p>
              </details>
            </div>
          </div>

          <div class="bg-theme-surface p-6 rounded-xl border border-theme-border sticky top-24">
            <h3 class="text-lg font-bold text-theme-primary mb-4">相关工具</h3>
            <ul class="space-y-3">
              <li>
                <a href="/tools/image-format-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片格式转换</div>
                  <div class="text-xs text-theme-secondary">JPG/PNG/WebP/BMP 等格式互转</div>
                </a>
              </li>
              <li>
                <a href="/tools/image-compressor" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">图片压缩工具</div>
                  <div class="text-xs text-theme-secondary">批量压缩，减小体积</div>
                </a>
              </li>
              <li>
                <a href="/tools/gif-converter" class="block p-3 rounded-lg hover:bg-theme-background transition-colors group">
                  <div class="font-medium text-theme-primary group-hover:text-accent">动图转换工具</div>
                  <div class="text-xs text-theme-secondary">多图合成 GIF / GIF 转 APNG</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
    details[open] summary ~ * { animation: fadeIn 0.3s ease-in-out; }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(-5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
