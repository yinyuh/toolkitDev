---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="Error 404 - Page not found" noindex={true}>
  <section
    class="bg-div-theme min-h-screen flex flex-col items-center justify-center px-6 text-center"
  >
    <h1
      class="text-7xl md:text-8xl font-extrabold text-[#69c7c7] drop-shadow-[3px_3px_0_#7836cf] mb-6"
    >
      404
    </h1>

    <h2 class="text-2xl md:text-3xl text-div-theme font-semibold mb-6">
      页面未找到
    </h2>
    <p class="text-theme-secondary max-w-md mx-auto mb-10 font-bold">
      抱歉，您访问的页面不存在。请检查URL是否正确，或返回首页继续浏览。
    </p>

    <a
      href="/"
      class="rounded-full bg-[#69c7c7] px-8 py-3 text-lg font-bold text-[#1d1250] drop-shadow-[3px_3px_0_#7836cf] transition-all duration-150 active:translate-y-0.5 active:drop-shadow-none"
    >
      返回首页
    </a>
  </section>
</Layout>